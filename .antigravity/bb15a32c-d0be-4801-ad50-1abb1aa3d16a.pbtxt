    combined_output {
      full: "import React, { useState } from \'react\';import { useApp } from \'../context/AppContext\';import { ShieldCheck, User, Building, Smartphone, CheckCircle } from \'lucide-react\';import { CitizenUser, GovUser } from \'../types\';export const AuthFlow: React.FC = () => {  const { authState, setAuthState, loginCitizen, loginGov } = useApp();    // Default to GOV_AUTH if the last active app was GOV (e.g. after Gov logout)  const [view, setView] = useState<\'WELCOME\' | \'CITIZEN_AUTH\' | \'GOV_AUTH\'>(    localStorage.getItem(\'cscirr_active_app\') === \'GOV\' ? \'GOV_AUTH\' : \'WELCOME\'  );    // Citizen Auth State  const [phone, setPhone] = useState(\'\');  // Gov Auth State  const [email, setEmail] = useState(\'\');  const [password, setPassword] = useState(\'\');  const [role, setRole] = useState(\'Department Officer\');  const handleCitizenMobileSubmit = () => {    if (phone.length >= 10 || phone.length === 0) { // allow empty for fast demo      setAuthState(\'MOBILE_VERIFIED\');    }  };  const handleMobileVerifiedContinue = () => {    setAuthState(\'IDENTITY_VERIFICATION_PENDING\');  };  const handleAadhaarSubmit = () => {    setAuthState(\'IDENTITY_VERIFIED\');  };  const finishCitizenOnboarding = () => {    const mockUser: CitizenUser = {      type: \'Citizen\',      id: `usr-${Date.now()}`,      name: \'Arun Kumar\',      phone: phone || \'+91 98765 43210\',      aadhaarVerified: true,      preferredLanguage: \'English\',      location: \'Ward 37\',      createdAt: new Date().toISOString(),      reportsCount: 27,      resolvedCount: 18,      reopenedCount: 2,      contributionScore: 92    };    loginCitizen(mockUser);  };  const handleGovLogin = () => {    const mockGov: GovUser = {      type: \'Government\',      id: `gov-${Date.now()}`,      name: \'Priya Raman\',      role: role as any,      department: \'Roads\'    };    loginGov(mockGov);  };  if (view === \'WELCOME\') {    return (      <div className=\"flex flex-col items-center justify-center min-h-screen bg-slate-50 p-6\">        <div className=\"w-16 h-16 bg-blue-600 rounded-2xl flex items-center justify-center font-bold text-4xl text-white shadow-lg mb-6\">          C        </div>        <h1 className=\"text-3xl text-center font-bold text-slate-900 tracking-tight mb-2 px-4\">Crowd Sourced Civic Issue Reporting and Resolution</h1>        <p className=\"text-lg text-slate-500 font-medium tracking-widest uppercase mb-12\">Report. Resolve. Verify.</p>                <div className=\"w-full max-w-md space-y-4\">          <button             onClick={() => setView(\'CITIZEN_AUTH\')}            className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg shadow-xl shadow-blue-900/20 flex items-center justify-center space-x-3 active:scale-95 transition-transform\"          >            <User size={24} />            <span>Create / Verify Account</span>          </button>                    <button             className=\"w-full bg-white text-slate-700 py-4 rounded-xl font-bold text-lg border-2 border-slate-200 shadow-sm flex items-center justify-center space-x-3 active:scale-95 transition-transform\"          >            <span>About CSCIRR</span>          </button>        </div>        <div className=\"mt-16 pt-8 border-t border-slate-200 w-full max-w-md flex flex-col items-center\">          <p className=\"text-xs font-bold text-slate-400 uppercase tracking-widest mb-4\">Demo Mode Shortcuts</p>          <div className=\"flex gap-4 w-full\">            <button               onClick={() => {                setPhone(\'+91 98765 43210\');                finishCitizenOnboarding();              }}              className=\"flex-1 bg-slate-200 text-slate-700 py-3 rounded-lg font-bold text-sm hover:bg-slate-300 transition-colors\"            >              Demo Citizen            </button>            <button               onClick={() => {                setRole(\'Municipal Administrator\');                handleGovLogin();              }}              className=\"flex-1 bg-slate-800 text-slate-200 py-3 rounded-lg font-bold text-sm hover:bg-slate-700 transition-colors flex items-center justify-center gap-2\"            >              <Building size={16} /> Demo Municipal Officer            </button>          </div>        </div>        <button           onClick={() => setView(\'GOV_AUTH\')}          className=\"mt-8 text-slate-400 font-medium hover:text-slate-600 flex items-center gap-2 transition-colors\"        >          <Building size={16} /> Municipal Staff Login        </button>      </div>"
    }
    command_line: "head -n 120 src/auth/AuthFlow.tsx"
