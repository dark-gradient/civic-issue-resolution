ssName=\"text-xs font-medium\">Chennai Municipal Corp.</span>\n              <span className=\"text-[10px] text-slate-400\">27 Aug 2026, 11:14 AM</span>\n            </div>\n            <div className=\"w-8 h-8 rounded-full bg-slate-700 border border-slate-600 flex items-center justify-center text-xs\">\n              AD\n            </div>\n          </div>\n        </nav>\n        {role === \'Citizen\' ? (\n          <CitizenApp onSwitchRole={() => setRole(\'Government\')} />\n        ) : (\n          <GovApp onSwitchRole={() => setRole(\'Citizen\')} />\n        )}\n      </div>\n    </AppProvider>\n  );\n}"
