    combined_output {
      full: "<truncated 23 bytes>\nervisor</option>                <option>Department Officer</option>                <option>Field Staff</option>                <option>Analyst</option>              </select>            </div>                        <button               onClick={handleGovLogin}              className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg mt-4 hover:bg-blue-500 transition-colors\"            >              Secure Login            </button>          </div>        </div>      </div>    );  }  // CITIZEN AUTH FLOW  return (    <div className=\"flex flex-col items-center justify-center min-h-screen bg-slate-50 p-6\">      <div className=\"w-full max-w-md\">        <div className=\"flex items-center justify-between mb-8\">          <button onClick={() => { setView(\'WELCOME\'); setAuthState(\'NOT_AUTHENTICATED\'); }} className=\"text-slate-500 hover:text-slate-900 font-bold flex items-center gap-2\">            &larr; Back          </button>          <div className=\"bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1 rounded-full border border-amber-200 uppercase tracking-wider\">            Demo Mode \342\200\224 Identity verification simulated          </div>        </div>        {authState === \'NOT_AUTHENTICATED\' && (          <div className=\"animate-in fade-in slide-in-from-bottom-4 duration-300\">            <h2 className=\"text-3xl font-bold text-slate-900 mb-2\">Create your CSCIRR Account</h2>            <p className=\"text-slate-500 mb-8 font-medium\">Your account helps us prevent duplicate and fraudulent reports and lets you track issues from report to resolution.</p>                        <div className=\"bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-4\">              <div>                <label className=\"block text-sm font-bold text-slate-700 mb-2\">Mobile Number</label>                <div className=\"flex gap-2\">                  <div className=\"bg-slate-100 border border-slate-200 rounded-xl px-4 py-4 font-bold text-slate-600 flex items-center justify-center\">                    +91                  </div>                  <input                     type=\"tel\"                     className=\"flex-1 border-2 border-slate-200 rounded-xl p-4 text-lg font-bold focus:border-blue-500 outline-none\"                    placeholder=\"Mobile Number\"                    value={phone}                    onChange={(e) => setPhone(e.target.value)}                  />                </div>              </div>              <button                 onClick={handleCitizenMobileSubmit}                className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg active:scale-95 transition-transform\"              >                Continue              </button>            </div>          </div>        )}        {authState === \'MOBILE_VERIFIED\' && (          <div className=\"animate-in fade-in slide-in-from-right-4 duration-300\">            <h2 className=\"text-3xl font-bold text-slate-900 mb-2\">Demo Verification</h2>            <p className=\"text-slate-500 mb-8 font-medium\">For this prototype, mobile verification is simulated.</p>                        <div className=\"bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-6\">              <div className=\"flex flex-col items-center justify-center p-4 bg-emerald-50 rounded-xl border border-emerald-100\">                <CheckCircle size={32} className=\"text-emerald-600 mb-2\" />                <span className=\"font-bold text-emerald-800 text-lg\">Mobile Number Verified</span>              </div>              <button                 onClick={handleMobileVerifiedContinue}                className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg active:scale-95 transition-transform\"              >                Continue              </button>            </div>          </div>        )}        {authState === \'IDENTITY_VERIFICATION_PENDING\' && (           <div className=\"animate-in fade-in slide-in-from-right-4 duration-300\">            <h2 className=\"text-3xl font-bold text-slate-900 mb-2\">Verify your identity</h2>            <p className=\"text-slate-500 mb-6 font-medium\">Use Aadhaar-based identity verification to create your CSCIRR account.</p>                        <div className=\"bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm\">              <div className=\"bg-amber-50 border-b border-amber-100 px-4 py-3 flex items-center gap-2 text-amber-800\">                <ShieldCheck size={18} />                <span className=\"text-xs font-bold uppercase tracking-wider\">Aadhaar Verification \342\200\224 Demo</span>              </div>              <div className=\"p-6 space-y-4\">                <div>                  <label className=\"block text-sm font-bold text-slate-700 mb-2\">Masked Aadhaar</label>                  <div className=\"w-full border-2 border-slate-200 rounded-xl p-4 text-lg font-bold outline-none bg-slate-50 text-slate-500\">                    XXXX XXXX 1234                  </div>                </div>                <button                   onClick={handleAadhaarSubmit}                  className=\"w-full bg-slate-900 text-white py-4 rounded-xl font-bold text-lg active:scale-95 transition-transform mt-2\"                >                  Verify Identity                </button>              </div>            </div>            <p className=\"text-xs text-slate-400 mt-6 text-center px-4\">              Your Aadhaar number is not displayed publicly. The prototype stores only a verified-account state and non-sensitive profile information.            </p>          </div>        )}        {authState === \'IDENTITY_VERIFIED\' && (          <div className=\"animate-in fade-in zoom-in-95 duration-500 flex flex-col items-center justify-center text-center py-12\">            <div className=\"w-24 h-24 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mb-6 shadow-sm border-4 border-white\">              <CheckCircle size={48} />            </div>            <h2 className=\"text-3xl font-bold text-slate-900 mb-2\">Identity Verified</h2>            <p className=\"text-slate-500 mb-8 font-medium\">Your Crowd Sourced Civic Issue Reporting and Resolution account has been verified.</p>                        <div className=\"bg-white rounded-2xl p-6 border border-slate-200 shadow-sm w-full text-left mb-8\">              <div className=\"flex items-center gap-4 mb-4\">                <div className=\"w-16 h-16 bg-blue-100 text-blue-700 rounded-full flex items-center justify-center text-2xl font-bold\">                  AK                </div>                <div>                  <h3 className=\"text-xl font-bold text-slate-900\">Arun Kumar</h3>                  <div className=\"flex items-center gap-1 text-emerald-600 text-xs font-bold mt-1 bg-emerald-50 px-2 py-1 rounded w-fit\">                    <ShieldCheck size={12} /> Aadhaar Verified Citizen                  </div>                </div>              </div>              <div className=\"space-y-2 text-sm\">                <div className=\"flex justify-between border-b border-slate-100 pb-2\">                  <span className=\"text-slate-500\">Phone</span>                  <span className=\"font-bold text-slate-900\">{phone || \'+91 98765 43210\'}</span>                </div>                <div className=\"flex justify-between border-b border-slate-100 py-2\">                  <span className=\"text-slate-500\">Location</span>                  <span className=\"font-bold text-slate-900\">Ward 37</span>                </div>                <div className=\"flex justify-between pt-2\">                  <span className=\"text-slate-500\">Preferred Language</span>                  <span className=\"font-bold text-slate-900\">English</span>                </div>              </div>            </div>            <p className=\"text-lg font-bold text-slate-800 mb-6\">Account created successfully.</p>                        <button               onClick={finishCitizenOnboarding}              className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg shadow-xl active:scale-95 transition-transform\"            >              Continue to CSCIRR            </button>          </div>        )}      </div>    </div>  );};"
