      target_content: "const TYPES = [\'Pothole\', \'Garbage accumulation\', \'Overflowing drain\', \'Broken streetlight\', \'Damaged footpath\', \'Water leakage\', \'Damaged traffic signal\', \'Public toilet maintenance\', \'Road debris\'];\n\nfor (let i = 0; i < 22; i++) {\n  const city = CITIES[Math.floor(Math.random() * CITIES.length)];\n  const authority = AUTHORITIES[Math.floor(Math.random() * AUTHORITIES.length)];\n  const department = DEPARTMENTS[Math.floor(Math.random() * DEPARTMENTS.length)];\n  const type = TYPES[Math.floor(Math.random() * TYPES.length)];\n  \n  const statusPool: Issue[\'status\'][] = [\'Submitted\', \'Under Review\', \'Assigned\', \'In Progress\', \'Resolved\', \'Awaiting Verification\', \'Closed\'];\n  const status = statusPool[Math.floor(Math.random() * statusPool.length)];\n  \n  const priorityPool: Issue[\'priority\'][] = [\'Low\', \'Medium\', \'High\', \'Critical\'];\n  const priority = priorityPool[Math.floor(Math.random() * priorityPool.length)];\n  \n  MOCK_ISSUES.push({\n    id: `CIV-106${i.toString().padStart(2, \'0\')}`,\n    title: `${type} in ${city}`,\n    type: type,\n    originalLanguage: Math.random() > 0.5 ? \'en\' : (Math.random() > 0.5 ? \'hi\' : \'ta\'),\n    originalDescription: `Issue reported regarding ${type}. Needs attention.`,\n    description: `Issue reported regarding ${type}. Needs attention.`,\n    location: `Random Street, ${city}`,\n    ward: `Ward ${Math.floor(Math.random() * 200)}`,\n    city: city,\n    authority: authority,\n    lat: 13.0 + Math.random(),\n    lng: 80.0 + Math.random(),\n    status: status,\n    priority: priority,\n    department: department,\n    reportedAt: pastDate(Math.floor(Math.random() * 10), Math.floor(Math.random() * 24)),\n    updatedAt: pastDate(Math.floor(Math.random() * 2), Math.floor(Math.random() * 10)),\n    reportsCount: Math.floor(Math.random() * 20) + 1,\n    aiConfidence: 70 + Math.floor(Math.random() * 30),\n    assignee: status === \'Submitted\' ? \'Unassigned\' : `Team ${Math.floor(Math.random() * 10)}`,\n    slaHours: 24 * (Math.floor(Math.random() * 3) + 1),\n    slaRemaining: status === \'Resolved\' || status === \'Closed\' ? \'Completed\' : `${Math.floor(Math.random() * 20)}h`,\n    images: { \n      before: \'https://images.unsplash.com/photo-1515162816999-a0c47dc192f7?auto=format&fit=crop&q=80&w=400&h=300\',\n      ...([\'Resolved\', \'Awaiting Verification\', \'Closed\'].includes(status) ? {after: \'https://images.unsplash.com/photo-1515162816999-a0c47dc192f7?auto=format&fit=crop&q=80&w=400&h=300\'} : {})\n    },\n    privacyProcessed: true,\n    timeline: [\n      { id: `t1-${i}`, title: \'Report submitted\', timestamp: pastDate(5), status: \'Submitted\', description: \'Citizen reported\' }\n    ]\n  });\n}"
      replacement_content: "const TYPE_IMAGES: Record<string, string[]> = {\n  \'Pothole\': [\n    \'https://images.unsplash.com/photo-1515162816999-a0c47dc192f7?auto=format&fit=crop&q=80&w=400&h=300\',\n    \'https://images.unsplash.com/photo-1596701062973-10e5bd75fa13?auto=format&fit=crop&q=80&w=400&h=300\',\n    \'https://images.unsplash.com/photo-1621415277800-47535565bb98?auto=format&fit=crop&q=80&w=400&h=300\'\n  ],\n  \'Garbage accumulation\': [\n    \'https://images.unsplash.com/photo-1532996122724-e3c354a0b15b?auto=format&fit=crop&q=80&w=400&h=300\',\n    \'https://images.unsplash.com/photo-1605600659908-0ef719419d41?auto=format&fit=crop&q=80&w=400&h=300\',\n    \'https://images.unsplash.com/photo-1528323273322-d81458248d40?auto=format&fit=crop&q=80&w=400&h=300\'\n  ],\n  \'Overflowing drain\': [\n    \'https://images.unsplash.com/photo-1628185038101-71fb7ca29b4e?auto=format&fit=crop&q=80&w=400&h=300\',\n    \'https://images.unsplash.com/photo-1584824388173-04177ed09ce8?auto=format&fit=crop&q=80&w=400&h=300\'\n  ],\n  \'Broken streetlight\': [\n    \'https://images.unsplash.com/photo-1617478753232-23c21a1f0a0d?auto=format&fit=crop&q=80&w=400&h=300\',\n    \'https://images.unsplash.com/photo-1542385150-a3e9c702c2e9?auto=format&fit=crop&q=80&w=400&h=300\'\n  ],\n  \'Damaged footpath\': [\n    \'https://images.unsplash.com/photo-1599587422956-654ec4711387?auto=format&fit=crop&q=80&w=400&h=300\',\n    \'https://images.unsplash.com/photo-1518972458428-f6556e87900b?auto=format&fit=crop&q=80&w=400&h=300\'\n  ],\n  \'Water leakage\': [\n    \'https://images.unsplash.com/photo-1519782800366-0744e4bb2dae?auto=format&fit=crop&q=80&w=400&h=300\',\n    \'https://images.unsplash.com/photo-1601055903647-8f3a3f3b9c48?auto=format&fit=crop&q=80&w=400&h=300\'\n  ],\n  \'Damaged traffic signal\': [\n    \'https://images.unsplash.com/photo-1554672979-994b79c32f8b?auto=format&fit=crop&q=80&w=400&h=300\',\n    \'https://images.unsplash.com/photo-1531061988880-97eb3388a10f?auto=format&fit=crop&q=80&w=400&h=300\'\n  ],\n  \'Public toilet maintenance\': [\n    \'https://images.unsplash.com/photo-1517415442581-2856402ecfb0?auto=format&fit=crop&q=80&w=400&h=300\'\n  ],\n  \'Road debris\': [\n    \'https://images.unsplash.com/photo-1574345248698-fb02bb38407e?auto=format&fit=crop&q=80&w=400&h=300\',\n    \'https://images.unsplash.com/photo-1589939705384-5185137a7f0f?auto=format&fit=crop&q=80&w=400&h=300\'\n  ]\n};\n\nconst TYPES = [\'Pothole\', \'Garbage accumulation\', \'Overflowing drain\', \'Broken streetlight\', \'Damaged footpath\', \'Water leakage\', \'Damaged traffic signal\', \'Public toilet maintenance\', \'Road debris\'];\n\nfor (let i = 0; i < 22; i++) {\n  const city = CITIES[Math.floor(Math.random() * CITIES.length)];\n  const authority = AUTHORITIES[Math.floor(Math.random() * AUTHORITIES.length)];\n  const department = DEPARTMENTS[Math.floor(Math.random() * DEPARTMENTS.length)];\n  const type = TYPES[Math.floor(Math.random() * TYPES.length)];\n  \n  const statusPool: Issue[\'status\'][] = [\'Submitted\', \'Under Review\', \'Assigned\', \'In Progress\', \'Resolved\', \'Awaiting Verification\', \'Closed\'];\n  const status = statusPool[Math.floor(Math.random() * statusPool.length)];\n  \n  const priorityPool: Issue[\'priority\'][] = [\'Low\', \'Medium\', \'High\', \'Critical\'];\n  const priority = priorityPool[Math.floor(Math.random() * priorityPool.length)];\n  \n  const typeImages = TYPE_IMAGES[type] || [\'https://images.unsplash.com/photo-1515162816999-a0c47dc192f7?auto=format&fit=crop&q=80&w=400&h=300\'];\n  const randomBeforeImg = typeImages[Math.floor(Math.random() * typeImages.length)];\n  const randomAfterImg = typeImages[Math.floor(Math.random() * typeImages.length)];\n  \n  MOCK_ISSUES.push({\n    id: `CIV-106${i.toString().padStart(2, \'0\')}`,\n    title: `${type} in ${city}`,\n    type: type,\n    originalLanguage: Math.random() > 0.5 ? \'en\' : (Math.random() > 0.5 ? \'hi\' : \'ta\'),\n    originalDescription: `Issue reported regarding ${type}. Needs attention.`,\n    description: `Issue reported regarding ${type}. Needs attention.`,\n    location: `Random Street, ${city}`,\n    ward: `Ward ${Math.floor(Math.random() * 200)}`,\n    city: city,\n    authority: authority,\n    lat: 13.0 + Math.random(),\n    lng: 80.0 + Math.random(),\n    status: status,\n    priority: priority,\n    department: department,\n    reportedAt: pastDate(Math.floor(Math.random() * 10), Math.floor(Math.random() * 24)),\n    updatedAt: pastDate(Math.floor(Math.random() * 2), Math.floor(Math.random() * 10)),\n    reportsCount: Math.floor(Math.random() * 20) + 1,\n    aiConfidence: 70 + Math.floor(Math.random() * 30),\n    assignee: status === \'Submitted\' ? \'Unassigned\' : `Team ${Math.floor(Math.random() * 10)}`,\n    slaHours: 24 * (Math.floor(Math.random() * 3) + 1),\n    slaRemaining: status === \'Resolved\' || status === \'Closed\' ? \'Completed\' : `${Math.floor(Math.random() * 20)}h`,\n    images: { \n      before: randomBeforeImg,\n      ...([\'Resolved\', \'Awaiting Verification\', \'Closed\'].includes(status) ? {after: randomAfterImg} : {})\n    },\n    privacyProcessed: true,\n    timeline: [\n      { id: `t1-${i}`, title: \'Report submitted\', timestamp: pastDate(5), status: \'Submitted\', description: \'Citizen reported\' }\n    ]\n  });\n}"
