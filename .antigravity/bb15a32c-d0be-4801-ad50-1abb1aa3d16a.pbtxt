    replacement_infos {
      original_chunk {
        target_content: "  useEffect(() => {\n    // Load auth state from local storage on mount\n    const storedAuth = localStorage.getItem(\'civicpulse_authenticated\');\n    const storedUser = localStorage.getItem(\'civicpulse_user\');\n    \n    if (storedAuth === \'true\' && storedUser) {\n      setAuthState(\'AUTHENTICATED\');\n      setUser(JSON.parse(storedUser));\n    }\n  }, []);\n\n  const loginCitizen = (citizenUser: CitizenUser) => {\n    localStorage.setItem(\'civicpulse_authenticated\', \'true\');\n    localStorage.setItem(\'civicpulse_user\', JSON.stringify(citizenUser));\n    setUser(citizenUser);\n    setAuthState(\'AUTHENTICATED\');\n  };\n\n  const loginGov = (govUser: GovUser) => {\n    localStorage.setItem(\'civicpulse_authenticated\', \'true\');\n    localStorage.setItem(\'civicpulse_user\', JSON.stringify(govUser));\n    setUser(govUser);\n    setAuthState(\'AUTHENTICATED\');\n  };\n\n  const logout = () => {\n    localStorage.removeItem(\'civicpulse_authenticated\');\n    localStorage.removeItem(\'civicpulse_user\');\n    setUser(null);\n    setAuthState(\'NOT_AUTHENTICATED\');\n  };"
        replacement_content: "  useEffect(() => {\n    // Load auth state from local storage on mount\n    const storedAuth = localStorage.getItem(\'cscirr_authenticated\');\n    const storedUser = localStorage.getItem(\'cscirr_user\');\n    \n    if (storedAuth === \'true\' && storedUser) {\n      setAuthState(\'AUTHENTICATED\');\n      setUser(JSON.parse(storedUser));\n    }\n  }, []);\n\n  const loginCitizen = (citizenUser: CitizenUser) => {\n    localStorage.setItem(\'cscirr_authenticated\', \'true\');\n    localStorage.setItem(\'cscirr_user\', JSON.stringify(citizenUser));\n    setUser(citizenUser);\n    setAuthState(\'AUTHENTICATED\');\n  };\n\n  const loginGov = (govUser: GovUser) => {\n    localStorage.setItem(\'cscirr_authenticated\', \'true\');\n    localStorage.setItem(\'cscirr_user\', JSON.stringify(govUser));\n    setUser(govUser);\n    setAuthState(\'AUTHENTICATED\');\n  };\n\n  const logout = () => {\n    localStorage.removeItem(\'cscirr_authenticated\');\n    localStorage.removeItem(\'cscirr_user\');\n    setUser(null);\n    setAuthState(\'NOT_AUTHENTICATED\');\n  };"
