        replacement_content: "  const loginCitizen = (cUser: CitizenUser) => {\n    localStorage.setItem(\'cscirr_citizen_auth\', \'true\');\n    localStorage.setItem(\'cscirr_citizen_user\', JSON.stringify(cUser));\n    localStorage.setItem(\'cscirr_active_app\', \'CITIZEN\');\n    setCitizenUser(cUser);\n    setCitizenAuthState(\'AUTHENTICATED\');\n    setActiveApp(\'CITIZEN\');\n  };\n\n  const loginGov = (gUser: GovUser) => {\n    localStorage.setItem(\'cscirr_gov_auth\', \'true\');\n    localStorage.setItem(\'cscirr_gov_user\', JSON.stringify(gUser));\n    localStorage.setItem(\'cscirr_active_app\', \'GOV\');\n    setGovUser(gUser);\n    setActiveApp(\'GOV\');\n  };\n\n  const logout = () => {\n    if (activeApp === \'CITIZEN\') {\n      localStorage.removeItem(\'cscirr_citizen_auth\');\n      localStorage.removeItem(\'cscirr_citizen_user\');\n      setCitizenUser(null);\n      setCitizenAuthState(\'NOT_AUTHENTICATED\');\n    } else {\n      localStorage.removeItem(\'cscirr_gov_auth\');\n      localStorage.removeItem(\'cscirr_gov_user\');\n      setGovUser(null);\n      // Optional: switch back to citizen app if logged out of gov\n      setActiveApp(\'CITIZEN\');\n      localStorage.setItem(\'cscirr_active_app\', \'CITIZEN\');\n    }\n  };"
      }
      num_matches: 1
    }
  }
}
