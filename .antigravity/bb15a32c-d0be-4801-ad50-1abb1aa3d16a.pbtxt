    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { ArrowLeft, CheckCircle2, XCircle, Users, AlertCircle, Info } from \'lucide-react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { StatusBadge } from \'./MyReports\';\nimport { formatDate } from \'../../utils\';\n\nexport const IssueDetail: React.FC<{ issueId: string, onBack: () => void }> = ({ issueId, onBack }) => {\n  const { issues, updateIssueStatus } = useApp();\n  const issue = issues.find(i => i.id === issueId);\n  const [showVerification, setShowVerification] = useState(issue?.status === \'Awaiting Verification\');\n\n  if (!issue) return null;\n\n  const handleVerify = (confirmed: boolean) => {\n    if (confirmed) {\n      updateIssueStatus(issue.id, \'Closed\', \'Citizen confirmed resolution.\');\n    } else {\n      updateIssueStatus(issue.id, \'Reopened\', \'Citizen reported issue is not resolved.\');\n    }\n    setShowVerification(false);\n  };\n\n  return (\n    <div className=\"flex flex-col bg-gray-50 min-h-full pb-20\">\n      <header className=\"bg-white px-4 py-3 border-b flex items-center gap-3 sticky top-0 z-20 shadow-sm\">\n        <button onClick={onBack} className=\"p-1 -ml-1 text-gray-500 hover:text-gray-900\">\n          <ArrowLeft size={24} />\n        </button>\n        <div>\n          <h2 className=\"text-lg font-bold text-gray-900 leading-tight\">Issue {issue.id}</h2>\n          <p className=\"text-[10px] text-gray-500 font-medium uppercase tracking-wide\">Reported {formatDate(issue.reportedAt)}</p>\n        </div>\n      </header>\n\n      {/* Main image */}\n      <div className=\"relative\">\n        <img src={issue.images.before} alt=\"Issue\" className=\"w-full h-56 object-cover\" />\n        <div className=\"absolute top-3 right-3\">\n          <StatusBadge status={issue.status} />\n        </div>\n      </div>\n\n      <div className=\"p-5\">\n        {/* Verification Card */}\n        {showVerification && (\n          <div className=\"bg-white border-2 border-blue-200 rounded-2xl p-5 shadow-lg mb-6 -mt-10 relative z-10 animate-in slide-in-from-bottom-4\">\n            <div className=\"flex items-center gap-2 text-blue-800 font-bold mb-2\">\n              <Info size={20} />\n              Verify Resolution\n            </div>\n            <p className=\"text-sm text-gray-600 mb-4\">\n              The municipal team has marked this issue as resolved. Is the problem actually fixed?\n            </p>\n            \n            <div className=\"grid grid-cols-2 gap-2 mb-5\">\n              <div>\n                <span className=\"text-[10px] font-bold text-gray-500 uppercase\">Before</span>\n                <img src={issue.images.before} className=\"w-full h-24 object-cover rounded-lg mt-1\" alt=\"Before\" />\n              </div>\n              <div>\n                <span className=\"text-[10px] font-bold text-green-600 uppercase\">After</span>\n                <img src={issue.images.after || issue.images.before} className=\"w-full h-24 object-cover rounded-lg mt-1 border border-green-200\" alt=\"After\" />\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-2\">\n              <button \n                onClick={() => handleVerify(true)}\n                className=\"w-full bg-green-600 text-white py-3 rounded-xl font-bold flex items-center justify-center gap-2 shadow-sm\"\n              >\n                <CheckCircle2 size={20} /> Confirm Resolution\n              </button>\n              <button \n                onClick={() => handleVerify(false)}\n                className=\"w-full bg-red-50 text-red-600 py-3 rounded-xl font-bold flex items-center justify-center gap-2 border border-red-200\"\n              >\n                <XCircle size={20} /> Not Resolved \342\200\224 Reopen\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Details Card */}\n        <div className=\"bg-white rounded-2xl p-5 shadow-sm border border-gray-100 mb-6\">\n          <div className=\"flex justify-between items-start mb-4\">\n            <div>\n              <h3 className=\"text-xl font-bold text-gray-900\">{issue.type}</h3>\n              <p className=\"text-sm text-gray-600 mt-1\">{issue.location}</p>\n            </div>\n            {issue.priority === \'Critical\' || issue.priority === \'High\' ? (\n              <span className=\"bg-red-100 text-red-700 px-2 py-1 rounded text-[10px] font-bold flex items-center gap-1 uppercase\">\n                <AlertCircle size={12} /> {issue.priority}\n              </span>\n            ) : null}\n          </div>\n\n          <div className=\"flex items-center gap-2 text-sm text-gray-700 bg-gray-50 p-3 rounded-xl border border-gray-100\">\n            <Users size={16} className=\"text-blue-500\" />\n            <span className=\"font-semibold text-gray-900\">{issue.reportsCount} citizens</span> \n            <span className=\"text-gray-500\">reported this issue</span>\n          </div>\n        </div>\n\n        {/* Timeline */}\n        <h3 className=\"font-bold text-gray-900 mb-4 px-1\">Issue Timeline</h3>\n        <div className=\"bg-white rounded-2xl p-5 shadow-sm border border-gray-100 relative\">\n          <div className=\"absolute top-5 bottom-5 left-[29px] w-0.5 bg-gray-200 z-0\" />\n          \n          <div className=\"space-y-6 relative z-10\">\n            {issue.timeline.map((event, i) => {\n              const isLast = i === issue.timeline.length - 1;\n              const isResolved = [\'Resolved\', \'Closed\'].includes(event.status);\n              \n              return (\n                <div key={event.id} className=\"flex gap-4\">\n                  <div className={`w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5 ${\n                    isResolved ? \'bg-green-500 text-white\' : \n                    isLast ? \'bg-blue-600 text-white ring-4 ring-blue-100\' : \'bg-gray-300\'\n                  }`}>\n                    {isResolved ? <CheckCircle2 size={12} /> : <div className=\"w-2 h-2 bg-white rounded-full\" />}\n                  </div>\n                  <div>\n                    <h4 className={`text-sm font-bold ${isLast ? \'text-gray-900\' : \'text-gray-600\'}`}>\n                      {event.title}\n                    </h4>\n                    <p className=\"text-xs text-gray-500 mt-0.5 mb-1\">{event.description}</p>\n                    <span className=\"text-[10px] text-gray-400 font-medium\">\n                      {formatDate(event.timestamp)}\n                    </span>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n        \n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { ArrowLeft, CheckCircle2, XCircle, Users, AlertCircle, Info } from \'lucide-react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { StatusBadge } from \'./MyReports\';\nimport { formatDate } from \'../../utils\';\n\nexport const IssueDetail: React.FC<{ issueId: string, onBack: () => void }> = ({ issueId, onBack }) => {\n  const { issues, updateIssueStatus } = useApp();\n  const issue = issues.find(i => i.id === issueId);\n  const [showVerification, setShowVerification] = useState(issue?.status === \'Awaiting Verification\');\n\n  if (!issue) return null;\n\n  const handleVerify = (confirmed: boolean) => {\n    if (confirmed) {\n      updateIssueStatus(issue.id, \'Closed\', \'Citizen confirmed resolution.\');\n    } else {\n      updateIssueStatus(issue.id, \'Reopened\', \'Citizen reported issue is not resolved.\');\n    }\n    setShowVerification(false);\n  };\n\n  return (\n    <div className=\"flex flex-col bg-slate-50 min-h-full pb-20\">\n      <header className=\"bg-white px-5 py-3 border-b border-slate-200 flex items-center gap-3 sticky top-0 z-20 shadow-sm\">\n        <button onClick={onBack} className=\"p-1 -ml-1 text-slate-500 hover:text-slate-900 transition-colors\">\n          <ArrowLeft size={24} />\n        </button>\n        <div>\n          <h2 className=\"text-lg font-bold text-slate-900 leading-tight tracking-tight\">Issue {issue.id}</h2>\n          <p className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">Reported {formatDate(issue.reportedAt)}</p>\n        </div>\n      </header>\n\n      {/* Main image */}\n      <div className=\"relative\">\n        <img src={issue.images.before} alt=\"Issue\" className=\"w-full h-56 object-cover\" />\n        <div className=\"absolute top-3 right-3 shadow-sm\">\n          <StatusBadge status={issue.status} />\n        </div>\n      </div>\n\n      <div className=\"p-5\">\n        {/* Verification Card */}\n        {showVerification && (\n          <div className=\"bg-white border-2 border-blue-200 rounded-2xl p-5 shadow-lg mb-6 -mt-10 relative z-10 animate-in slide-in-from-bottom-4\">\n            <div className=\"flex items-center gap-2 text-blue-800 font-bold mb-2 tracking-tight\">\n              <Info size={20} />\n              Verify Resolution\n            </div>\n            <p className=\"text-sm text-slate-600 mb-4\">\n              The municipal team has marked this issue as resolved. Is the problem actually fixed?\n            </p>\n            \n            <div className=\"grid grid-cols-2 gap-3 mb-5\">\n              <div>\n                <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Before</span>\n                <img src={issue.images.before} className=\"w-full h-24 object-cover rounded-lg mt-1 border border-slate-100\" alt=\"Before\" />\n              </div>\n              <div>\n                <span className=\"text-[10px] font-bold text-emerald-600 uppercase tracking-wider\">After</span>\n                <img src={issue.images.after || issue.images.before} className=\"w-full h-24 object-cover rounded-lg mt-1 border border-emerald-200\" alt=\"After\" />\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-2\">\n              <button \n                onClick={() => handleVerify(true)}\n                className=\"w-full bg-emerald-600 hover:bg-emerald-700 text-white py-3.5 rounded-xl font-bold flex items-center justify-center gap-2 shadow-sm transition-colors\"\n              >\n                <CheckCircle2 size={20} /> Confirm Resolution\n              </button>\n              <button \n                onClick={() => handleVerify(false)}\n                className=\"w-full bg-red-50 hover:bg-red-100 text-red-700 py-3.5 rounded-xl font-bold flex items-center justify-center gap-2 border border-red-200 transition-colors\"\n              >\n                <XCircle size={20} /> Not Resolved \342\200\224 Reopen\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Details Card */}\n        <div className=\"bg-white rounded-2xl p-5 shadow-sm border border-slate-200 mb-6\">\n          <div className=\"flex justify-between items-start mb-4\">\n            <div>\n              <h3 className=\"text-xl font-bold text-slate-900 tracking-tight\">{issue.type}</h3>\n              <p className=\"text-sm text-slate-600 mt-1\">{issue.location}</p>\n            </div>\n            {issue.priority === \'Critical\' || issue.priority === \'High\' ? (\n              <span className=\"bg-red-50 text-red-700 border border-red-200 px-2 py-1 rounded-md text-[10px] font-bold flex items-center gap-1 uppercase tracking-wider shrink-0\">\n                <AlertCircle size={12} /> {issue.priority}\n              </span>\n            ) : null}\n          </div>\n\n          <div className=\"flex items-center gap-2 text-sm text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-100\">\n            <Users size={16} className=\"text-blue-500\" />\n            <span className=\"font-bold text-slate-900\">{issue.reportsCount} citizens</span> \n            <span className=\"text-slate-500 font-medium\">reported this issue</span>\n          </div>\n        </div>\n\n        {/* Timeline */}\n        <h3 className=\"font-bold text-slate-900 mb-4 px-1 tracking-tight\">Issue Timeline</h3>\n        <div className=\"bg-white rounded-2xl p-5 shadow-sm border border-slate-200 relative\">\n          <div className=\"absolute top-5 bottom-5 left-[29px] w-0.5 bg-slate-100 z-0\" />\n          \n          <div className=\"space-y-6 relative z-10\">\n            {issue.timeline.map((event, i) => {\n              const isLast = i === issue.timeline.length - 1;\n              const isResolved = [\'Resolved\', \'Closed\'].includes(event.status);\n              \n              return (\n                <div key={event.id} className=\"flex gap-4\">\n                  <div className={`w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5 ${\n                    isResolved ? \'bg-emerald-500 text-white\' : \n                    isLast ? \'bg-blue-600 text-white ring-4 ring-blue-50\' : \'bg-slate-300\'\n                  }`}>\n                    {isResolved ? <CheckCircle2 size={12} /> : <div className=\"w-2 h-2 bg-white rounded-full\" />}\n                  </div>\n                  <div>\n                    <h4 className={`text-sm font-bold tracking-tight ${isLast ? \'text-slate-900\' : \'text-slate-600\'}`}>\n                      {event.title}\n                    </h4>\n                    <p className=\"text-xs text-slate-500 mt-1 mb-1.5\">{event.description}</p>\n                    <span className=\"text-[10px] text-slate-400 font-bold uppercase tracking-wider\">\n                      {formatDate(event.timestamp)}\n                    </span>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n        \n      </div>\n    </div>\n  );\n};"
    }
