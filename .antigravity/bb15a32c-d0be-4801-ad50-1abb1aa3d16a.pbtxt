      replacement_content: "import React, { useState } from \'react\';\nimport { Home, PlusCircle, ListTodo, Bell, User, WifiOff } from \'lucide-react\';\nimport { useApp } from \'../context/AppContext\';\nimport { CitizenHome } from \'./screens/Home\';\nimport { ReportFlow } from \'./screens/ReportFlow\';\nimport { MyReports } from \'./screens/MyReports\';\nimport { IssueDetail } from \'./screens/IssueDetail\';\nimport { cn } from \'../utils\';\n\nexport type CitizenScreen = \'home\' | \'report\' | \'my_reports\' | \'issue_detail\' | \'notifications\' | \'profile\';\n\nexport const CitizenApp: React.FC<{ onSwitchRole: () => void }> = ({ onSwitchRole }) => {\n  const [currentScreen, setCurrentScreen] = useState<CitizenScreen>(\'home\');\n  const [selectedIssueId, setSelectedIssueId] = useState<string | null>(null);\n  \n  const { isOffline, toggleOffline, offlineQueue } = useApp();\n\n  const navigateTo = (screen: CitizenScreen, issueId?: string) => {\n    if (issueId) setSelectedIssueId(issueId);\n    setCurrentScreen(screen);\n  };\n\n  return (\n    <div className=\"flex justify-center bg-gray-200 min-h-screen\">\n      {/* Mobile constrained wrapper */}\n      <div className=\"w-full max-w-md bg-gray-50 h-screen flex flex-col relative shadow-2xl overflow-hidden\">\n        \n        {/* Header */}\n        <header className=\"bg-white border-b px-4 py-3 flex items-center justify-between shrink-0 z-10 relative\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-lg\">\n              C\n            </div>\n            <div>\n              <h1 className=\"font-bold text-gray-900 leading-none\">CivicPulse</h1>\n              <span className=\"text-[10px] text-gray-500 font-medium\">Anna Nagar, Chennai</span>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <button onClick={toggleOffline} className={cn(\"p-2 rounded-full\", isOffline ? \"bg-red-100 text-red-600\" : \"bg-gray-100 text-gray-600\")}>\n              <WifiOff size={18} />\n            </button>\n            <button onClick={onSwitchRole} className=\"text-xs bg-gray-100 px-2 py-1 rounded text-gray-600 border font-medium\">\n              Gov View\n            </button>\n          </div>\n        </header>\n\n        {/* Offline Banner */}\n        {isOffline && (\n          <div className=\"bg-amber-100 border-b border-amber-200 p-2 flex flex-col items-center justify-center text-center shrink-0\">\n            <span className=\"text-amber-800 font-semibold text-xs flex items-center gap-1\">\n              <WifiOff size={12} /> Offline Mode\n            </span>\n            <span className=\"text-amber-700 text-[10px]\">\n              {offlineQueue.length > 0 \n                ? `${offlineQueue.length} reports waiting to sync` \n                : \'No internet connection\'}\n            </span>\n          </div>\n        )}\n\n        {/* Main Content Area */}\n        <main className=\"flex-1 overflow-y-auto relative pb-16\">\n          {currentScreen === \'home\' && <CitizenHome onNavigate={navigateTo} />}\n          {currentScreen === \'report\' && <ReportFlow onComplete={() => navigateTo(\'home\')} />}\n          {currentScreen === \'my_reports\' && <MyReports onNavigate={navigateTo} />}\n          {currentScreen === \'issue_detail\' && selectedIssueId && (\n            <IssueDetail issueId={selectedIssueId} onBack={() => navigateTo(\'my_reports\')} />\n          )}\n          {currentScreen === \'notifications\' && (\n            <div className=\"p-4 flex flex-col items-center justify-center h-full text-gray-500\">\n              <Bell className=\"w-12 h-12 mb-2 text-gray-300\" />\n              <p>No new notifications</p>\n            </div>\n          )}\n          {currentScreen === \'profile\' && (\n            <div className=\"p-4 flex flex-col items-center justify-center h-full text-gray-500\">\n              <User className=\"w-12 h-12 mb-2 text-gray-300\" />\n              <p>Profile Settings</p>\n            </div>\n          )}\n        </main>\n\n        {/* Bottom Nav */}\n        <nav className=\"absolute bottom-0 left-0 right-0 bg-white border-t flex justify-around items-center h-16 pb-safe shrink-0 z-20\">\n          <NavItem icon={<Home />} label=\"Home\" isActive={currentScreen === \'home\'} onClick={() => navigateTo(\'home\')} />\n          <NavItem \n            icon={<PlusCircle className=\"text-blue-600 w-7 h-7\" />} \n            label=\"Report\" \n            isActive={currentScreen === \'report\'} \n            onClick={() => navigateTo(\'report\')} \n            isPrimary \n          />\n          <NavItem icon={<ListTodo />} label=\"My Reports\" isActive={currentScreen === \'my_reports\' || currentScreen === \'issue_detail\'} onClick={() => navigateTo(\'my_reports\')} />\n          <NavItem icon={<Bell />} label=\"Alerts\" isActive={currentScreen === \'notifications\'} onClick={() => navigateTo(\'notifications\')} />\n          <NavItem icon={<User />} label=\"Profile\" isActive={currentScreen === \'profile\'} onClick={() => navigateTo(\'profile\')} />\n        </nav>\n      </div>\n    </div>\n  );\n};\n\nconst NavItem = ({ icon, label, isActive, onClick, isPrimary = false }: any) => (\n  <button \n    onClick={onClick} \n    className={cn(\n      \"flex flex-col items-center justify-center w-full h-full space-y-1 transition-colors\",\n      isActive ? \"text-blue-600\" : \"text-gray-500 hover:text-gray-900\"\n    )}\n  >\n    <div className={cn(\n      isPrimary && \"-mt-5 bg-white p-2 rounded-full border border-gray-100 shadow-sm\"\n    )}>\n      {React.cloneElement(icon, { size: isPrimary ? 28 : 20, className: isActive && !isPrimary ? \"text-blue-600\" : \"\" })}\n    </div>\n    <span className={cn(\"text-[10px] font-medium\", isActive ? \"text-blue-600 font-semibold\" : \"\")}>{label}</span>\n  </button>\n);\n"
    }
