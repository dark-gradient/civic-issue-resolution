      target_content: "import React from \'react\';\nimport { MapPin } from \'lucide-react\';\n\nexport const GovLiveMap: React.FC = () => {\n  return (\n    <div className=\"h-[calc(100vh-80px)] bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col animate-in fade-in duration-300 relative\">\n      <div className=\"absolute top-4 left-4 z-10 bg-white rounded-xl shadow-lg border border-slate-200 p-4 w-72\">\n        <h3 className=\"font-bold text-slate-900 mb-3 tracking-tight\">Map Controls</h3>\n        <div className=\"space-y-4\">\n          <div>\n            <label className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Issue Type</label>\n            <select className=\"w-full mt-1.5 border border-slate-200 rounded-lg p-2 text-sm bg-slate-50 text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all\">\n              <option>All Types</option>\n              <option>Potholes</option>\n              <option>Garbage</option>\n            </select>\n          </div>\n          <div>\n            <label className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Priority</label>\n            <select className=\"w-full mt-1.5 border border-slate-200 rounded-lg p-2 text-sm bg-slate-50 text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all\">\n              <option>All Priorities</option>\n              <option>Critical Only</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"flex-1 bg-slate-50 relative overflow-hidden\">\n         <div className=\"absolute inset-0 opacity-40\" style={{ backgroundImage: \'radial-gradient(#94a3b8 2px, transparent 2px)\', backgroundSize: \'30px 30px\' }}></div>\n         \n         <div className=\"absolute top-1/4 left-1/3\">\n           <div className=\"relative flex items-center justify-center cursor-pointer group\">\n             <div className=\"w-16 h-16 bg-red-500/20 rounded-full animate-pulse absolute\"></div>\n             <div className=\"w-10 h-10 bg-red-600 rounded-full border-4 border-white relative z-10 shadow-lg flex items-center justify-center text-white font-bold text-sm\">42</div>\n             <div className=\"absolute top-full mt-2 bg-white px-3 py-1.5 rounded-lg shadow-lg border border-slate-200 text-xs font-bold text-slate-700 whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity z-20\">\n               <span className=\"text-red-600\">High Priority Hotspot</span><br/>Ward 37 (Anna Nagar)\n             </div>\n           </div>\n         </div>\n\n         <div className=\"absolute bottom-1/3 right-1/4\">\n           <div className=\"relative flex items-center justify-center cursor-pointer group\">\n             <div className=\"w-10 h-10 bg-amber-500 rounded-full border-4 border-white relative z-10 shadow-lg flex items-center justify-center text-white font-bold text-sm\">18</div>\n             <div className=\"absolute top-full mt-2 bg-white px-3 py-1.5 rounded-lg shadow-lg border border-slate-200 text-xs font-bold text-slate-700 whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity z-20\">\n               <span className=\"text-amber-600\">Elevated Priority</span><br/>Ward 12 (T Nagar)\n             </div>\n           </div>\n         </div>\n\n         <div className=\"absolute top-1/2 left-2/3\">\n           <div className=\"relative flex items-center justify-center cursor-pointer group\">\n             <div className=\"w-8 h-8 bg-blue-500 rounded-full border-4 border-white relative z-10 shadow-lg flex items-center justify-center text-white font-bold text-xs\">5</div>\n             <div className=\"absolute top-full mt-2 bg-white px-3 py-1.5 rounded-lg shadow-lg border border-slate-200 text-xs font-bold text-slate-700 whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity z-20\">\n               Normal Priority<br/>Ward 68 (Koramangala)\n             </div>\n           </div>\n         </div>\n\n         <div className=\"absolute inset-0 flex items-center justify-center pointer-events-none opacity-20\">\n           <div className=\"text-center\">\n             <MapPin size={48} className=\"text-slate-300 mx-auto mb-2\" />\n             <h2 className=\"text-2xl font-bold text-slate-400 tracking-tight\">Interactive GIS Map</h2>\n             <p className=\"text-slate-500 font-medium\">Live clustering and heatmaps enabled.</p>\n           </div>\n         </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useMemo } from \'react\';\nimport { MapPin } from \'lucide-react\';\nimport { useApp } from \'../../context/AppContext\';\n\nexport const GovLiveMap: React.FC = () => {\n  const { issues } = useApp();\n\n  // Simple normalization of lat/lng to percentage bounds\n  const markers = useMemo(() => {\n    if (issues.length === 0) return [];\n    \n    const minLat = Math.min(...issues.map(i => i.lat));\n    const maxLat = Math.max(...issues.map(i => i.lat));\n    const minLng = Math.min(...issues.map(i => i.lng));\n    const maxLng = Math.max(...issues.map(i => i.lng));\n    \n    // Add some padding to bounds so pins don\'t hit edges\n    const latRange = (maxLat - minLat) || 0.1;\n    const lngRange = (maxLng - minLng) || 0.1;\n\n    return issues.map(issue => {\n      // Invert lat for Y axis (larger lat is North/up, meaning smaller top percentage)\n      const top = 10 + ((maxLat - issue.lat) / latRange) * 80;\n      const left = 10 + ((issue.lng - minLng) / lngRange) * 80;\n      \n      let color = \'bg-blue-500\';\n      if (issue.priority === \'Critical\') color = \'bg-red-600\';\n      else if (issue.priority === \'High\') color = \'bg-amber-500\';\n      else if (issue.priority === \'Medium\') color = \'bg-blue-500\';\n      else color = \'bg-slate-400\';\n\n      return { ...issue, top, left, color };\n    });\n  }, [issues]);\n\n  return (\n    <div className=\"h-[calc(100vh-80px)] bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col animate-in fade-in duration-300 relative\">\n      <div className=\"absolute top-4 left-4 z-10 bg-white rounded-xl shadow-lg border border-slate-200 p-4 w-72\">\n        <h3 className=\"font-bold text-slate-900 mb-3 tracking-tight\">Map Controls</h3>\n        <div className=\"space-y-4\">\n          <div>\n            <label className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Issue Type</label>\n            <select className=\"w-full mt-1.5 border border-slate-200 rounded-lg p-2 text-sm bg-slate-50 text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all\">\n              <option>All Types</option>\n              <option>Potholes</option>\n              <option>Garbage</option>\n            </select>\n          </div>\n          <div>\n            <label className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Priority</label>\n            <select className=\"w-full mt-1.5 border border-slate-200 rounded-lg p-2 text-sm bg-slate-50 text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all\">\n              <option>All Priorities</option>\n              <option>Critical Only</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"flex-1 bg-slate-50 relative overflow-hidden\">\n         <div className=\"absolute inset-0 opacity-40\" style={{ backgroundImage: \'radial-gradient(#94a3b8 2px, transparent 2px)\', backgroundSize: \'30px 30px\' }}></div>\n         \n         {markers.map(m => (\n           <div key={m.id} className=\"absolute\" style={{ top: `${m.top}%`, left: `${m.left}%` }}>\n             <div className=\"relative flex items-center justify-center cursor-pointer group\">\n               {m.priority === \'Critical\' && (\n                 <div className=\"w-8 h-8 bg-red-500/20 rounded-full animate-pulse absolute\"></div>\n               )}\n               <div className={`w-5 h-5 ${m.color} rounded-full border-2 border-white relative z-10 shadow-lg`}></div>\n               <div className=\"absolute top-full mt-2 bg-white px-3 py-1.5 rounded-lg shadow-lg border border-slate-200 text-xs font-bold text-slate-700 whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity z-20 pointer-events-none\">\n                 <span className={m.priority === \'Critical\' ? \'text-red-600\' : m.priority === \'High\' ? \'text-amber-600\' : \'text-blue-600\'}>\n                   {m.id} - {m.priority}\n                 </span><br/>\n                 {m.title}<br/>\n                 {m.city}, {m.ward}\n               </div>\n             </div>\n           </div>\n         ))}\n\n         <div className=\"absolute inset-0 flex items-center justify-center pointer-events-none opacity-20\">\n           <div className=\"text-center\">\n             <MapPin size={48} className=\"text-slate-300 mx-auto mb-2\" />\n             <h2 className=\"text-2xl font-bold text-slate-400 tracking-tight\">Interactive GIS Map</h2>\n             <p className=\"text-slate-500 font-medium\">Live clustering and heatmaps enabled.</p>\n           </div>\n         </div>\n      </div>\n    </div>\n  );\n};"
    }
