    instruction: "Apply Professional Polish theme to MyReports, updating the header, filters, layout, colors, and typography."
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { formatDate, cn } from \'../../utils\';\nimport { MapPin, WifiOff, Filter } from \'lucide-react\';\n\nexport const MyReports: React.FC<{ onNavigate: (s: any, id?: string) => void }> = ({ onNavigate }) => {\n  const { issues, offlineQueue } = useApp();\n  const [filter, setFilter] = useState<\'All\' | \'Active\' | \'Resolved\' | \'Reopened\'>(\'All\');\n\n  const filtered = issues.filter(issue => {\n    if (filter === \'All\') return true;\n    if (filter === \'Active\') return [\'Submitted\', \'Assigned\', \'In Progress\', \'Under Review\'].includes(issue.status);\n    if (filter === \'Resolved\') return [\'Resolved\', \'Closed\', \'Awaiting Verification\'].includes(issue.status);\n    if (filter === \'Reopened\') return issue.status === \'Reopened\';\n    return true;\n  });\n\n  return (\n    <div className=\"flex flex-col h-full\">\n      <div className=\"bg-white px-4 py-4 shadow-sm border-b sticky top-0 z-10\">\n        <h2 className=\"text-lg font-bold text-gray-900\">My Reports</h2>\n        \n        {/* Filters */}\n        <div className=\"flex gap-2 mt-4 overflow-x-auto no-scrollbar pb-1\">\n          {[\'All\', \'Active\', \'Resolved\', \'Reopened\'].map(f => (\n            <button \n              key={f}\n              onClick={() => setFilter(f as any)}\n              className={cn(\n                \"px-4 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap border transition-colors\",\n                filter === f \n                  ? \"bg-gray-900 text-white border-gray-900\" \n                  : \"bg-white text-gray-600 border-gray-200 hover:bg-gray-50\"\n              )}\n            >\n              {f}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      <div className=\"p-4 space-y-4\">\n        {/* Offline Queue UI */}\n        {offlineQueue.length > 0 && filter === \'All\' && (\n          <div className=\"bg-amber-50 border-l-4 border-amber-500 p-3 rounded-r shadow-sm\">\n            <div className=\"flex items-center gap-2 text-amber-800 font-bold text-sm mb-1\">\n              <WifiOff size={16} /> Pending Sync ({offlineQueue.length})\n            </div>\n            <p className=\"text-xs text-amber-700\">These reports will be uploaded when online.</p>\n          </div>\n        )}\n\n        {filtered.length === 0 ? (\n          <div className=\"text-center py-10 text-gray-500\">\n            No reports found for this filter.\n          </div>\n        ) : (\n          filtered.map(issue => (\n            <div \n              key={issue.id} \n              className=\"bg-white p-4 rounded-2xl shadow-sm border border-gray-100 flex flex-col gap-3 active:scale-[0.98] transition-transform\"\n              onClick={() => onNavigate(\'issue_detail\', issue.id)}\n            >\n              <div className=\"flex justify-between items-start\">\n                <div>\n                  <span className=\"text-[10px] font-mono font-bold text-gray-500 bg-gray-100 px-2 py-0.5 rounded\">{issue.id}</span>\n                  <h4 className=\"text-base font-bold text-gray-900 mt-1\">{issue.type}</h4>\n                </div>\n                <StatusBadge status={issue.status} />\n              </div>\n              \n              <div className=\"flex gap-3\">\n                <img src={issue.images.before} alt=\"\" className=\"w-20 h-20 rounded-xl object-cover\" />\n                <div className=\"flex-1 flex flex-col justify-end\">\n                  <div className=\"flex items-start text-sm text-gray-600 gap-1.5 mb-1.5\">\n                    <MapPin size={14} className=\"mt-0.5 text-gray-400 shrink-0\" /> \n                    <span className=\"line-clamp-2 leading-tight\">{issue.location}</span>\n                  </div>\n                  <div className=\"text-xs text-gray-400 font-medium\">\n                    Reported on {formatDate(issue.reportedAt).split(\',\')[0]}\n                  </div>\n                </div>\n              </div>\n            </div>\n          ))\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport const StatusBadge = ({ status }: { status: string }) => {\n  let color = \'bg-gray-100 text-gray-700\';\n  \n  if ([\'Submitted\', \'Under Review\'].includes(status)) color = \'bg-blue-50 text-blue-700 border border-blue-200\';\n  else if ([\'Assigned\', \'In Progress\'].includes(status)) color = \'bg-amber-50 text-amber-700 border border-amber-200\';\n  else if ([\'Resolved\', \'Closed\', \'Awaiting Verification\'].includes(status)) color = \'bg-green-50 text-green-700 border border-green-200\';\n  else if (status === \'Reopened\') color = \'bg-red-50 text-red-700 border border-red-200\';\n  \n  return (\n    <span className={cn(\"text-[10px] px-2.5 py-1 rounded-full font-bold uppercase tracking-wider\", color)}>\n      {status}\n    </span>\n  );\n}"
        replacement_content: "import React, { useState } from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { formatDate, cn } from \'../../utils\';\nimport { MapPin, WifiOff, Filter } from \'lucide-react\';\n\nexport const MyReports: React.FC<{ onNavigate: (s: any, id?: string) => void }> = ({ onNavigate }) => {\n  const { issues, offlineQueue } = useApp();\n  const [filter, setFilter] = useState<\'All\' | \'Active\' | \'Resolved\' | \'Reopened\'>(\'All\');\n\n  const filtered = issues.filter(issue => {\n    if (filter === \'All\') return true;\n    if (filter === \'Active\') return [\'Submitted\', \'Assigned\', \'In Progress\', \'Under Review\'].includes(issue.status);\n    if (filter === \'Resolved\') return [\'Resolved\', \'Closed\', \'Awaiting Verification\'].includes(issue.status);\n    if (filter === \'Reopened\') return issue.status === \'Reopened\';\n    return true;\n  });\n\n  return (\n    <div className=\"flex flex-col h-full bg-slate-50\">\n      <div className=\"bg-white px-5 py-4 shadow-sm border-b border-slate-200 sticky top-0 z-10\">\n        <h2 className=\"text-xl font-bold text-slate-900 tracking-tight\">My Reports</h2>\n        \n        {/* Filters */}\n        <div className=\"flex gap-2 mt-4 overflow-x-auto no-scrollbar pb-1\">\n          {[\'All\', \'Active\', \'Resolved\', \'Reopened\'].map(f => (\n            <button \n              key={f}\n              onClick={() => setFilter(f as any)}\n              className={cn(\n                \"px-4 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap border transition-colors\",\n                filter === f \n                  ? \"bg-slate-900 text-white border-slate-900\" \n                  : \"bg-white text-slate-600 border-slate-200 hover:bg-slate-50\"\n              )}\n            >\n              {f}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      <div className=\"p-4 space-y-3 pb-24\">\n        {/* Offline Queue UI */}\n        {offlineQueue.length > 0 && filter === \'All\' && (\n          <div className=\"bg-amber-50 border border-amber-200 p-3 rounded-xl shadow-sm\">\n            <div className=\"flex items-center gap-2 text-amber-800 font-bold text-sm mb-1\">\n              <WifiOff size={16} /> Pending Sync ({offlineQueue.length})\n            </div>\n            <p className=\"text-xs text-amber-700\">These reports will be uploaded when online.</p>\n          </div>\n        )}\n\n        {filtered.length === 0 ? (\n          <div className=\"text-center py-10 text-slate-500\">\n            No reports found for this filter.\n          </div>\n        ) : (\n          filtered.map(issue => (\n            <div \n              key={issue.id} \n              className=\"bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col gap-3 active:scale-[0.98] transition-transform cursor-pointer\"\n              onClick={() => onNavigate(\'issue_detail\', issue.id)}\n            >\n              <div className=\"flex justify-between items-start\">\n                <div>\n                  <span className=\"text-[10px] font-mono font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded border border-slate-200\">{issue.id}</span>\n                  <h4 className=\"text-base font-bold text-slate-900 mt-1 tracking-tight\">{issue.type}</h4>\n                </div>\n                <StatusBadge status={issue.status} />\n              </div>\n              \n              <div className=\"flex gap-3\">\n                <img src={issue.images.before} alt=\"\" className=\"w-20 h-20 rounded-lg object-cover border border-slate-100\" />\n                <div className=\"flex-1 flex flex-col justify-end\">\n                  <div className=\"flex items-start text-sm text-slate-600 gap-1.5 mb-1.5\">\n                    <MapPin size={14} className=\"mt-0.5 text-slate-400 shrink-0\" /> \n                    <span className=\"line-clamp-2 leading-tight\">{issue.location}</span>\n                  </div>\n                  <div className=\"text-xs text-slate-400 font-medium\">\n                    Reported on {formatDate(issue.reportedAt).split(\',\')[0]}\n                  </div>\n                </div>\n              </div>\n            </div>\n          ))\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport const StatusBadge = ({ status }: { status: string }) => {\n  let color = \'bg-slate-100 text-slate-700 border-slate-200\';\n  \n  if ([\'Submitted\', \'Under Review\'].includes(status)) color = \'bg-blue-50 text-blue-700 border-blue-200\';\n  else if ([\'Assigned\', \'In Progress\'].includes(status)) color = \'bg-amber-50 text-amber-700 border-amber-200\';\n  else if ([\'Resolved\', \'Closed\', \'Awaiting Verification\'].includes(status)) color = \'bg-emerald-50 text-emerald-700 border-emerald-200\';\n  else if (status === \'Reopened\') color = \'bg-red-50 text-red-700 border-red-200\';\n  \n  return (\n    <span className={cn(\"text-[10px] px-2.5 py-1 rounded-full font-bold uppercase tracking-wider border\", color)}>\n      {status}\n    </span>\n  );\n}"
      }
      num_matches: 1
    }
  }
