        replacement_content: "            {/* AI Panel */}\n            <div className=\"mt-8 bg-blue-50 border border-blue-100 rounded-xl p-4 shadow-sm\">\n              <div className=\"flex gap-3 items-start mb-4\">\n                <div className=\"bg-blue-600 text-white p-2 rounded-lg shrink-0\">\n                  <AlertTriangle size={20} />\n                </div>\n                <div className=\"flex-1\">\n                  <p className=\"text-[10px] font-bold text-blue-800 uppercase tracking-wider mb-1\">AI Triage Active</p>\n                  <p className=\"text-sm text-blue-900 font-medium\">Classified as <span className=\"font-bold border-b border-blue-400\">{category}</span> (96%)</p>\n                </div>\n                <button className=\"text-xs font-bold text-blue-700 bg-white px-2.5 py-1.5 rounded-md shadow-sm border border-blue-100\">\n                  Change\n                </button>\n              </div>\n              \n              <div className=\"bg-white/60 rounded-lg p-3 text-xs text-blue-800 font-medium space-y-2 border border-blue-100/50\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-1.5 h-1.5 rounded-full bg-blue-500\"></div>\n                  <span>Checking for duplicates at this GPS location...</span>\n                </div>\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-1.5 h-1.5 rounded-full bg-blue-500\"></div>\n                  <span>Will route to <strong className=\"font-bold text-blue-900\">Roads Dept (Ward 37)</strong></span>\n                </div>\n              </div>\n            </div>\n\n            <button \n              onClick={handleSubmit}"
      }
