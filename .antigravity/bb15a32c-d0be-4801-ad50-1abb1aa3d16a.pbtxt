  file_change {
    absolute_path_uri: "file:///src/government/GovApp.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { \n  LayoutDashboard, Map as MapIcon, Layers, Users, Truck, AlertTriangle, \n  MessageSquare, BarChart3, Settings, Search, Bell, UserCircle, Menu \n} from \'lucide-react\';\nimport { GovOverview } from \'./screens/Overview\';\nimport { GovLiveMap } from \'./screens/LiveMap\';\nimport { GovIssueQueue } from \'./screens/IssueQueue\';\nimport { GovIssueDetail } from \'./screens/IssueDetail\';\nimport { GovAnalytics } from \'./screens/Analytics\';\n\nexport type GovScreen = \'overview\' | \'map\' | \'queue\' | \'departments\' | \'field\' | \'sla\' | \'reports\' | \'analytics\' | \'hotspots\' | \'settings\' | \'issue_detail\';\n\nexport const GovApp: React.FC<{ onSwitchRole: () => void }> = ({ onSwitchRole }) => {\n  const [currentScreen, setCurrentScreen] = useState<GovScreen>(\'overview\');\n  const [selectedIssueId, setSelectedIssueId] = useState<string | null>(null);\n\n  const navigateTo = (screen: GovScreen, issueId?: string) => {\n    if (issueId) setSelectedIssueId(issueId);\n    setCurrentScreen(screen);\n  };\n\n  const navItems = [\n    { id: \'overview\', label: \'Command Center\', icon: LayoutDashboard },\n    { id: \'map\', label: \'Live Issue Map\', icon: MapIcon },\n    { id: \'queue\', label: \'Issue Queue\', icon: Layers, badge: 124 },\n    { id: \'analytics\', label: \'Analytics\', icon: BarChart3 },\n    { id: \'sla\', label: \'SLA Alerts\', icon: AlertTriangle, badge: 3 },\n  ];\n\n  return (\n    <main className=\"flex flex-1 overflow-hidden bg-slate-50\">\n      \n      {/* SIDEBAR */}\n      <aside className=\"w-64 bg-white border-r border-slate-200 flex flex-col shrink-0\">\n        <div className=\"p-4 border-b border-slate-100\">\n          <div className=\"relative\">\n            <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" size={18} />\n            <input \n              type=\"text\" \n              placeholder=\"Search ID, Ward, Status...\" \n              className=\"w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all placeholder-slate-400\"\n            />\n          </div>\n        </div>\n\n        <nav className=\"flex-1 overflow-y-auto p-3 space-y-1\">\n          <div className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2 mt-2 px-3\">Views</div>\n          {navItems.map(item => (\n            <button\n              key={item.id}\n              onClick={() => navigateTo(item.id as GovScreen)}\n              className={`w-full flex items-center space-x-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors ${\n                currentScreen === item.id || (currentScreen === \'issue_detail\' && item.id === \'queue\')\n                  ? \'bg-blue-50 text-blue-700\' \n                  : \'text-slate-600 hover:bg-slate-50\'\n              }`}\n            >\n              <item.icon size={18} className={currentScreen === item.id ? \'text-blue-600\' : \'text-slate-400\'} />\n              <span>{item.label}</span>\n              {item.badge && (\n                <span className=\"ml-auto bg-slate-100 text-slate-600 py-0.5 px-2 rounded-full text-xs font-bold\">\n                  {item.badge}\n                </span>\n              )}\n            </button>\n          ))}\n        </nav>\n      </aside>\n\n      {/* MAIN CONTENT WRAPPER */}\n      <div className=\"flex-1 flex flex-col min-w-0 bg-slate-50 overflow-auto p-6\">\n        {currentScreen === \'overview\' && <GovOverview onNavigate={navigateTo} />}\n        {currentScreen === \'map\' && <GovLiveMap />}\n        {currentScreen === \'queue\' && <GovIssueQueue onNavigate={navigateTo} />}\n        {currentScreen === \'issue_detail\' && selectedIssueId && (\n          <GovIssueDetail issueId={selectedIssueId} onBack={() => navigateTo(\'queue\')} />\n        )}\n        {currentScreen === \'analytics\' && <GovAnalytics />}\n        \n        {/* Placeholders for screens we are simplifying due to token limits */}\n        {[\'departments\', \'field\', \'sla\', \'reports\', \'hotspots\', \'settings\'].includes(currentScreen) && (\n          <div className=\"flex flex-col items-center justify-center h-full text-slate-400\">\n            <Settings size={48} className=\"mb-4 opacity-20\" />\n            <h2 className=\"text-2xl font-bold text-slate-300\">Module Under Construction</h2>\n            <p className=\"mt-2 text-slate-500\">The {currentScreen} dashboard is part of the full suite.</p>\n          </div>\n        )}\n      </div>\n    </main>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  LayoutDashboard, Map as MapIcon, Layers, Users, Truck, AlertTriangle, \n  MessageSquare, BarChart3, Settings, Search, Bell, UserCircle, Menu, LogOut \n} from \'lucide-react\';\nimport { GovOverview } from \'./screens/Overview\';\nimport { GovLiveMap } from \'./screens/LiveMap\';\nimport { GovIssueQueue } from \'./screens/IssueQueue\';\nimport { GovIssueDetail } from \'./screens/IssueDetail\';\nimport { GovAnalytics } from \'./screens/Analytics\';\nimport { useApp } from \'../context/AppContext\';\nimport { GovUser } from \'../types\';\n\nexport type GovScreen = \'overview\' | \'map\' | \'queue\' | \'departments\' | \'field\' | \'sla\' | \'reports\' | \'analytics\' | \'hotspots\' | \'settings\' | \'issue_detail\';\n\nexport const GovApp: React.FC = () => {\n  const [currentScreen, setCurrentScreen] = useState<GovScreen>(\'overview\');\n  const [selectedIssueId, setSelectedIssueId] = useState<string | null>(null);\n  const [isMenuOpen, setIsMenuOpen] = useState(false);\n  const { user, logout } = useApp();\n  const currentUser = user as GovUser;\n\n  const navigateTo = (screen: GovScreen, issueId?: string) => {\n    if (issueId) setSelectedIssueId(issueId);\n    setCurrentScreen(screen);\n  };\n\n  const navItems = [\n    { id: \'overview\', label: \'Command Center\', icon: LayoutDashboard },\n    { id: \'map\', label: \'Live Issue Map\', icon: MapIcon },\n    { id: \'queue\', label: \'Issue Queue\', icon: Layers, badge: 124 },\n    { id: \'analytics\', label: \'Analytics\', icon: BarChart3 },\n    { id: \'sla\', label: \'SLA Alerts\', icon: AlertTriangle, badge: 3 },\n  ];\n\n  return (\n    <div className=\"flex flex-col h-full overflow-hidden bg-slate-50\">\n      {/* GOV HEADER */}\n      <header className=\"bg-slate-900 border-b border-slate-800 px-6 py-3 flex items-center justify-between shrink-0 z-30 text-white shadow-md\">\n        <div className=\"flex items-center space-x-3\">\n          <div className=\"w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center font-bold text-xl\">\n            C\n          </div>\n          <div className=\"flex flex-col leading-tight\">\n            <span className=\"font-bold text-lg tracking-tight uppercase\">CivicPulse</span>\n            <span className=\"text-[10px] text-slate-400 font-medium tracking-widest uppercase\">Government Portal</span>\n          </div>\n        </div>\n        <div className=\"flex items-center space-x-4 relative\">\n          <div className=\"flex items-center space-x-3 text-right mr-2\">\n            <div className=\"flex flex-col\">\n              <span className=\"text-sm font-bold text-white\">{currentUser?.name}</span>\n              <span className=\"text-[10px] text-blue-400 font-bold uppercase tracking-wider\">{currentUser?.role}</span>\n            </div>\n            <div className=\"w-9 h-9 rounded-full bg-slate-700 flex items-center justify-center text-sm font-bold border border-slate-600\">\n              {currentUser?.name?.split(\' \').map(n => n[0]).join(\'\')}\n            </div>\n          </div>\n          \n          <button \n            onClick={() => setIsMenuOpen(!isMenuOpen)}\n            className=\"text-slate-400 hover:text-white transition-colors\"\n          >\n            <Settings size={20} />\n          </button>\n\n          {isMenuOpen && (\n            <div className=\"absolute top-10 right-0 w-56 bg-white rounded-xl shadow-xl border border-slate-200 py-2 z-50 animate-in fade-in zoom-in-95 duration-200\">\n              <div className=\"px-4 py-3 border-b border-slate-100\">\n                <div className=\"flex items-center gap-1 text-blue-600 text-xs font-bold mb-1\">\n                  \342\234\223 Official Account\n                </div>\n                <p className=\"text-xs text-slate-500\">{currentUser?.department} Department</p>\n              </div>\n              <div className=\"py-1\">\n                <button \n                  onClick={() => {\n                    setIsMenuOpen(false);\n                    if (window.confirm(\'Sign out of Government Portal?\')) {\n                      logout();\n                    }\n                  }} \n                  className=\"w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 font-bold flex items-center gap-2\"\n                >\n                  <LogOut size={16} /> Sign Out\n                </button>\n              </div>\n            </div>\n          )}\n        </div>\n      </header>\n\n      <main className=\"flex flex-1 overflow-hidden\">\n        {/* SIDEBAR */}\n        <aside className=\"w-64 bg-white border-r border-slate-200 flex flex-col shrink-0\">\n          <div className=\"p-4 border-b border-slate-100\">\n            <div className=\"relative\">\n              <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" size={18} />\n              <input \n                type=\"text\" \n                placeholder=\"Search ID, Ward, Status...\" \n                className=\"w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all placeholder-slate-400\"\n              />\n            </div>\n          </div>\n\n          <nav className=\"flex-1 overflow-y-auto p-3 space-y-1\">\n            <div className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2 mt-2 px-3\">Views</div>\n            {navItems.map(item => (\n              <button\n                key={item.id}\n                onClick={() => navigateTo(item.id as GovScreen)}\n                className={`w-full flex items-center space-x-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors ${\n                  currentScreen === item.id || (currentScreen === \'issue_detail\' && item.id === \'queue\')\n                    ? \'bg-blue-50 text-blue-700\' \n                    : \'text-slate-600 hover:bg-slate-50\'\n                }`}\n              >\n                <item.icon size={18} className={currentScreen === item.id ? \'text-blue-600\' : \'text-slate-400\'} />\n                <span>{item.label}</span>\n                {item.badge && (\n                  <span className=\"ml-auto bg-slate-100 text-slate-600 py-0.5 px-2 rounded-full text-xs font-bold\">\n                    {item.badge}\n                  </span>\n                )}\n              </button>\n            ))}\n          </nav>\n        </aside>\n\n        {/* MAIN CONTENT WRAPPER */}\n        <div className=\"flex-1 flex flex-col min-w-0 bg-slate-50 overflow-auto p-6 relative\">\n          {currentScreen === \'overview\' && <GovOverview onNavigate={navigateTo} />}\n          {currentScreen === \'map\' && <GovLiveMap />}\n          {currentScreen === \'queue\' && <GovIssueQueue onNavigate={navigateTo} />}\n          {currentScreen === \'issue_detail\' && selectedIssueId && (\n            <GovIssueDetail issueId={selectedIssueId} onBack={() => navigateTo(\'queue\')} />\n          )}\n          {currentScreen === \'analytics\' && <GovAnalytics />}\n          \n          {/* Placeholders for screens we are simplifying due to token limits */}\n          {[\'departments\', \'field\', \'sla\', \'reports\', \'hotspots\', \'settings\'].includes(currentScreen) && (\n            <div className=\"flex flex-col items-center justify-center h-full text-slate-400\">\n              <Settings size={48} className=\"mb-4 opacity-20\" />\n              <h2 className=\"text-2xl font-bold text-slate-300\">Module Under Construction</h2>\n              <p className=\"mt-2 text-slate-500\">The {currentScreen} dashboard is part of the full suite.</p>\n            </div>\n          )}\n        </div>\n      </main>\n    </div>\n  );\n};"
    }
