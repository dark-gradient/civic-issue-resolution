    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { ArrowLeft, CheckCircle2, XCircle, Users, AlertCircle, Info, Cpu, ShieldCheck } from \'lucide-react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { StatusBadge } from \'./MyReports\';\nimport { formatDate } from \'../../utils\';\n\nexport const IssueDetail: React.FC<{ issueId: string, onBack: () => void }> = ({ issueId, onBack }) => {\n  const { issues, updateIssueStatus } = useApp();\n  const issue = issues.find(i => i.id === issueId);\n  const showVerification = issue?.status === \'Awaiting Verification\';\n\n  if (!issue) return null;\n\n  const handleVerify = (confirmed: boolean) => {\n    if (confirmed) {\n      updateIssueStatus(issue.id, \'Closed\', \'Citizen confirmed resolution.\');\n    } else {\n      updateIssueStatus(issue.id, \'Reopened\', \'Citizen reported issue is not resolved.\');\n    }\n  };\n\n  return (\n    <div className=\"flex flex-col bg-slate-50 min-h-full pb-20\">\n      <header className=\"bg-white px-5 py-3 border-b border-slate-200 flex items-center gap-3 sticky top-0 z-20 shadow-sm\">\n        <button onClick={onBack} className=\"p-1 -ml-1 text-slate-500 hover:text-slate-900 transition-colors\">\n          <ArrowLeft size={24} />\n        </button>\n        <div>\n          <h2 className=\"text-lg font-bold text-slate-900 leading-tight tracking-tight\">Issue {issue.id}</h2>\n          <p className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">Reported {formatDate(issue.reportedAt)}</p>\n        </div>\n      </header>\n\n      {/* Main images */}\n      <div className=\"relative flex w-full h-56 bg-slate-200\">\n        <div className={`relative ${issue.images.after ? \'w-1/2 border-r-2 border-white\' : \'w-full h-full\'}`}>\n          <img src={issue.images.before} alt=\"Before\" className=\"w-full h-full object-cover\" />\n          {issue.privacyProcessed && (\n            <>\n              <div className=\"absolute top-1/3 right-1/4 w-12 h-12 backdrop-blur-xl bg-white/10 rounded-full border border-white/20 shadow-sm\" />\n              <div className=\"absolute bottom-3 left-3 flex items-center gap-1 text-[10px] font-bold text-emerald-700 bg-emerald-50/90 backdrop-blur-sm px-2 py-1 rounded shadow-sm border border-emerald-200\">\n                <ShieldCheck size={12} /> Faces Blurred\n              </div>\n            </>\n          )}\n        </div>\n        {issue.images.after && (\n          <div className=\"relative w-1/2 h-full\">\n            <img src={issue.images.after} alt=\"After\" className=\"w-full h-full object-cover\" />\n          </div>\n        )}\n        <div className=\"absolute top-3 right-3 shadow-sm z-10\">\n          <StatusBadge status={issue.status} />\n        </div>\n        {issue.images.after && (\n          <div className=\"absolute bottom-3 left-0 right-0 flex justify-between px-4 z-10\">\n            <span className=\"bg-slate-900/60 backdrop-blur-sm text-white text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider\">Before</span>\n            <span className=\"bg-emerald-600/80 backdrop-blur-sm text-white text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider\">After</span>\n          </div>\n        )}\n      </div>\n\n      <div className=\"p-5\">\n        {/* Verification Card */}\n        {showVerification && (\n          <div className=\"bg-white border-2 border-blue-200 rounded-2xl p-5 shadow-lg mb-6 -mt-10 relative z-10 animate-in slide-in-from-bottom-4\">\n            <div className=\"flex items-center gap-2 text-blue-800 font-bold mb-2 tracking-tight\">\n              <Info size={20} />\n              Verify Resolution\n            </div>\n            <p className=\"text-sm text-slate-600 mb-4\">\n              The municipal team has marked this issue as resolved. Is the problem actually fixed?\n            </p>\n            \n            <div className=\"grid grid-cols-2 gap-3 mb-5\">\n              <div>\n                <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Before</span>\n                <img src={issue.images.before} className=\"w-full h-24 object-cover rounded-lg mt-1 border border-slate-100\" alt=\"Before\" />\n              </div>\n              <div>\n                <span className=\"text-[10px] font-bold text-emerald-600 uppercase tracking-wider\">After</span>\n                <img src={issue.images.after || issue.images.before} className=\"w-full h-24 object-cover rounded-lg mt-1 border border-emerald-200\" alt=\"After\" />\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-2\">\n              <button \n                onClick={() => handleVerify(true)}\n                className=\"w-full bg-emerald-600 hover:bg-emerald-700 text-white py-3.5 rounded-xl font-bold flex items-center justify-center gap-2 shadow-sm transition-colors\"\n              >\n                <CheckCircle2 size={20} /> Confirm Resolution\n              </button>\n              <button \n                onClick={() => handleVerify(false)}\n                className=\"w-full bg-red-50 hover:bg-red-100 text-red-700 py-3.5 rounded-xl font-bold flex items-center justify-center gap-2 border border-red-200 transition-colors\"\n              >\n                <XCircle size={20} /> Not Resolved \342\200\224 Reopen\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Details Card */}\n        <div className=\"bg-white rounded-2xl p-5 shadow-sm border border-slate-200 mb-6 relative overflow-hidden\">\n          {issue.reportsCount > 1 && (\n            <div className=\"absolute top-0 left-0 right-0 bg-indigo-50 border-b border-indigo-100 py-1.5 px-5 flex items-center justify-between\">\n               <span className=\"text-[10px] font-bold text-indigo-700 uppercase tracking-wider flex items-center gap-1.5\">\n                 <Cpu size={12} /> AI Canonical Merge\n               </span>\n            </div>\n          )}\n          \n          <div className={`flex justify-between items-start mb-4 ${issue.reportsCount > 1 ? \'mt-6\' : \'\'}`}>\n            <div>\n              <h3 className=\"text-xl font-bold text-slate-900 tracking-tight\">{issue.type}</h3>\n              <p className=\"text-sm text-slate-600 mt-1\">{issue.location}</p>\n            </div>\n            {issue.priority === \'Critical\' || issue.priority === \'High\' ? (\n              <span className=\"bg-red-50 text-red-700 border border-red-200 px-2 py-1 rounded-md text-[10px] font-bold flex items-center gap-1 uppercase tracking-wider shrink-0\">\n                <AlertCircle size={12} /> {issue.priority}\n              </span>\n            ) : null}\n          </div>\n\n          <div className=\"flex items-center gap-2 text-sm text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-100\">\n            <Users size={16} className=\"text-blue-500\" />\n            <span className=\"font-bold text-slate-900\">{issue.reportsCount} citizens</span> \n            <span className=\"text-slate-500 font-medium\">reported this issue</span>\n          </div>\n\n          <div className=\"mt-3 flex items-center gap-1.5 text-xs font-bold text-emerald-600 bg-emerald-50 px-3 py-1.5 rounded-lg border border-emerald-100 w-fit\">\n            <CheckCircle2 size={14} /> Reported by You\n          </div>\n        </div>\n\n        {/* Timeline */}\n        <h3 className=\"font-bold text-slate-900 mb-4 px-1 tracking-tight\">Issue Timeline</h3>\n        <div className=\"bg-white rounded-2xl p-5 shadow-sm border border-slate-200 relative\">\n          <div className=\"absolute top-5 bottom-5 left-[29px] w-0.5 bg-slate-100 z-0\" />\n          \n          <div className=\"space-y-6 relative z-10\">\n            {issue.timeline.map((event, i) => {\n              const isLast = i === issue.timeline.length - 1;\n              const isResolved = [\'Resolved\', \'Closed\'].includes(event.status);\n              \n              return (\n                <div key={event.id} className=\"flex gap-4\">\n                  <div className={`w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5 ${\n                    isResolved ? \'bg-emerald-500 text-white\' : \n                    isLast ? \'bg-blue-600 text-white ring-4 ring-blue-50\' : \'bg-slate-300\'\n                  }`}>\n                    {isResolved ? <CheckCircle2 size={12} /> : <div className=\"w-2 h-2 bg-white rounded-full\" />}\n                  </div>\n                  <div>\n                    <h4 className={`text-sm font-bold tracking-tight ${isLast ? \'text-slate-900\' : \'text-slate-600\'}`}>\n                      {event.title}\n                    </h4>\n                    <p className=\"text-xs text-slate-500 mt-1 mb-1.5\">{event.description}</p>\n                    <span className=\"text-[10px] text-slate-400 font-bold uppercase tracking-wider\">\n                      {formatDate(event.timestamp)}\n                    </span>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n        \n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { ArrowLeft, CheckCircle2, XCircle, MapPin, ShieldCheck } from \'lucide-react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { CitizenStatusBadge, getSimplifiedStatus } from \'./MyReports\';\nimport { formatDate } from \'../../utils\';\n\nexport const IssueDetail: React.FC<{ issueId: string, onBack: () => void }> = ({ issueId, onBack }) => {\n  const { issues, updateIssueStatus } = useApp();\n  const issue = issues.find(i => i.id === issueId);\n  const showVerification = issue?.status === \'Awaiting Verification\';\n  const [reopenMessage, setReopenMessage] = useState(false);\n\n  if (!issue) return null;\n\n  const handleVerify = (confirmed: boolean) => {\n    if (confirmed) {\n      updateIssueStatus(issue.id, \'Closed\', \'Citizen confirmed resolution.\');\n    } else {\n      updateIssueStatus(issue.id, \'Reopened\', \'Citizen reported issue is not resolved.\');\n      setReopenMessage(true);\n    }\n  };\n\n  const simpleStatus = getSimplifiedStatus(issue.status);\n\n  return (\n    <div className=\"flex flex-col bg-slate-50 min-h-full pb-20\">\n      <header className=\"bg-white px-5 py-3 border-b border-slate-200 flex items-center gap-3 sticky top-0 z-20 shadow-sm\">\n        <button onClick={onBack} className=\"p-1 -ml-1 text-slate-500 hover:text-slate-900 transition-colors\">\n          <ArrowLeft size={24} />\n        </button>\n        <div>\n          <h2 className=\"text-lg font-bold text-slate-900 leading-tight tracking-tight\">Your Report</h2>\n          <p className=\"text-[10px] text-slate-500 font-bold uppercase tracking-wider\">Reported {formatDate(issue.reportedAt).split(\',\')[0]}</p>\n        </div>\n      </header>\n\n      {/* Main image */}\n      <div className=\"relative flex w-full h-64 bg-slate-200\">\n        <img src={issue.images.before} alt=\"Problem\" className=\"w-full h-full object-cover\" />\n        \n        {issue.privacyProcessed && (\n          <div className=\"absolute bottom-3 left-3 flex items-center gap-1.5 text-xs font-bold text-emerald-700 bg-emerald-50/90 backdrop-blur-sm px-3 py-1.5 rounded shadow-sm border border-emerald-200\">\n            <ShieldCheck size={16} /> Faces protected\n          </div>\n        )}\n      </div>\n\n      <div className=\"p-5\">\n        <div className=\"flex justify-between items-start mb-6\">\n          <CitizenStatusBadge status={issue.status} />\n        </div>\n        \n        <div className=\"bg-white rounded-2xl p-5 shadow-sm border-2 border-slate-200 mb-6\">\n          <h3 className=\"text-xl font-bold text-slate-900 tracking-tight mb-2\">{issue.title}</h3>\n          \n          {issue.description && (\n            <p className=\"text-slate-600 mb-4\">{issue.description}</p>\n          )}\n\n          <div className=\"flex items-start text-sm text-slate-700 gap-2 font-medium bg-slate-50 p-3 rounded-xl border border-slate-100\">\n            <MapPin size={18} className=\"mt-0.5 text-blue-500 shrink-0\" /> \n            <span>{issue.location}</span>\n          </div>\n        </div>\n\n        {/* Verification Card */}\n        {showVerification && !reopenMessage && (\n          <div className=\"bg-white border-2 border-blue-200 rounded-2xl p-5 shadow-lg relative z-10 animate-in slide-in-from-bottom-4\">\n            <h3 className=\"text-xl font-bold text-slate-900 mb-2\">Work completed</h3>\n            <p className=\"text-slate-600 mb-6 font-medium\">\n              Is the problem fixed?\n            </p>\n            \n            {issue.images.after && (\n              <div className=\"mb-6\">\n                <span className=\"text-xs font-bold text-emerald-600 uppercase tracking-wider mb-1 block\">Work Photo</span>\n                <img src={issue.images.after} className=\"w-full h-40 object-cover rounded-xl border-2 border-emerald-200\" alt=\"Fixed\" />\n              </div>\n            )}\n\n            <div className=\"flex flex-col gap-3\">\n              <button \n                onClick={() => handleVerify(true)}\n                className=\"w-full bg-emerald-600 hover:bg-emerald-700 text-white py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 shadow-sm transition-colors\"\n              >\n                <CheckCircle2 size={24} /> Yes, fixed\n              </button>\n              <button \n                onClick={() => handleVerify(false)}\n                className=\"w-full bg-white text-slate-700 py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 border-2 border-slate-200 hover:bg-slate-50 transition-colors\"\n              >\n                <XCircle size={24} /> No, still a problem\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Reopen Message */}\n        {reopenMessage && (\n          <div className=\"bg-amber-50 border-2 border-amber-200 rounded-2xl p-6 shadow-sm text-center animate-in zoom-in duration-300\">\n            <p className=\"text-amber-800 font-bold text-lg\">Thank you.</p>\n            <p className=\"text-amber-700 font-medium mt-1\">We\'ll ask the responsible team to look at it again.</p>\n          </div>\n        )}\n\n      </div>\n    </div>\n  );\n};"
    }
