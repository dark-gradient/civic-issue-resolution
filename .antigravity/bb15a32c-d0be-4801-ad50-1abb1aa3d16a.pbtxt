    instruction: "Apply Professional Polish theme to GovIssueQueue, updating colors, borders, typography and backgrounds."
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { Search, Filter, ChevronDown, MoreHorizontal, Download } from \'lucide-react\';\nimport { StatusBadge } from \'../../citizen/screens/MyReports\';\nimport { cn } from \'../../utils\';\n\nexport const GovIssueQueue: React.FC<{ onNavigate: (s: any, id?: string) => void }> = ({ onNavigate }) => {\n  const { issues } = useApp();\n  const [searchTerm, setSearchTerm] = useState(\'\');\n\n  return (\n    <div className=\"h-full flex flex-col bg-white border rounded-xl shadow-sm overflow-hidden animate-in fade-in duration-300 max-w-[1600px] mx-auto\">\n      \n      {/* Toolbar */}\n      <div className=\"p-4 border-b flex items-center justify-between bg-gray-50 shrink-0\">\n        <div className=\"flex gap-3\">\n          <div className=\"relative\">\n            <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-400\" size={16} />\n            <input \n              type=\"text\" \n              placeholder=\"Search ID, Type, Ward...\" \n              value={searchTerm}\n              onChange={e => setSearchTerm(e.target.value)}\n              className=\"pl-9 pr-4 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none w-72\"\n            />\n          </div>\n          <button className=\"flex items-center gap-2 px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium bg-white hover:bg-gray-50 text-gray-700\">\n            <Filter size={16} /> Filters\n          </button>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <button className=\"flex items-center gap-2 px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium bg-white hover:bg-gray-50 text-gray-700\">\n            <Download size={16} /> Export\n          </button>\n          <button className=\"px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-bold shadow-sm transition-colors\">\n            Bulk Assign\n          </button>\n        </div>\n      </div>\n\n      {/* Table */}\n      <div className=\"flex-1 overflow-auto\">\n        <table className=\"w-full text-sm text-left whitespace-nowrap\">\n          <thead className=\"text-xs text-gray-500 bg-white border-b uppercase sticky top-0 z-10 shadow-sm\">\n            <tr>\n              <th className=\"px-6 py-4 font-bold\">Priority</th>\n              <th className=\"px-6 py-4 font-bold\">Issue ID</th>\n              <th className=\"px-6 py-4 font-bold\">Details</th>\n              <th className=\"px-6 py-4 font-bold\">Location</th>\n              <th className=\"px-6 py-4 font-bold\">AI Intel</th>\n              <th className=\"px-6 py-4 font-bold\">Assignment</th>\n              <th className=\"px-6 py-4 font-bold\">SLA Limit</th>\n              <th className=\"px-6 py-4 font-bold\">Status</th>\n              <th className=\"px-6 py-4 font-bold text-center\">Action</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-gray-100\">\n            {issues.filter(i => \n              i.id.includes(searchTerm) || \n              i.type.toLowerCase().includes(searchTerm.toLowerCase()) ||\n              i.ward.toLowerCase().includes(searchTerm.toLowerCase())\n            ).map(issue => (\n              <tr key={issue.id} className=\"hover:bg-blue-50/50 transition-colors group cursor-pointer\" onClick={() => onNavigate(\'issue_detail\', issue.id)}>\n                <td className=\"px-6 py-4\">\n                  <div className=\"flex items-center gap-2\">\n                    <div className={cn(\n                      \"w-2 h-2 rounded-full\",\n                      issue.priority === \'Critical\' ? \"bg-red-500\" :\n                      issue.priority === \'High\' ? \"bg-orange-500\" :\n                      issue.priority === \'Medium\' ? \"bg-amber-500\" : \"bg-gray-400\"\n                    )} />\n                    <span className=\"font-bold text-gray-700\">{issue.priority}</span>\n                  </div>\n                </td>\n                <td className=\"px-6 py-4\">\n                  <span className=\"font-mono font-bold text-blue-600 bg-blue-50 px-2 py-1 rounded\">{issue.id}</span>\n                </td>\n                <td className=\"px-6 py-4\">\n                  <div className=\"font-bold text-gray-900\">{issue.type}</div>\n                  <div className=\"text-xs text-gray-500\">{issue.reportsCount} citizen reports</div>\n                </td>\n                <td className=\"px-6 py-4\">\n                  <div className=\"font-medium text-gray-800\">{issue.ward}</div>\n                  <div className=\"text-xs text-gray-500 truncate max-w-[150px]\">{issue.location}</div>\n                </td>\n                <td className=\"px-6 py-4\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-xs font-bold text-green-700 bg-green-50 px-2 py-0.5 rounded border border-green-200\">{issue.aiConfidence}% match</span>\n                  </div>\n                </td>\n                <td className=\"px-6 py-4\">\n                  <div className=\"font-medium text-gray-800\">{issue.department}</div>\n                  <div className=\"text-xs text-gray-500\">{issue.assignee}</div>\n                </td>\n                <td className=\"px-6 py-4\">\n                  <div className={cn(\"font-bold\", issue.slaRemaining.startsWith(\'-\') ? \"text-red-600\" : \"text-gray-700\")}>\n                    {issue.slaRemaining}\n                  </div>\n                </td>\n                <td className=\"px-6 py-4\">\n                  <StatusBadge status={issue.status} />\n                </td>\n                <td className=\"px-6 py-4 text-center\">\n                  <button \n                    onClick={(e) => { e.stopPropagation(); onNavigate(\'issue_detail\', issue.id); }}\n                    className=\"text-gray-400 hover:text-blue-600 p-1 rounded transition-colors\"\n                  >\n                    <MoreHorizontal size={20} />\n                  </button>\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      </div>\n      \n      <div className=\"p-4 border-t bg-gray-50 flex items-center justify-between text-sm text-gray-500 shrink-0\">\n        <div>Showing {issues.length} issues</div>\n        <div className=\"flex gap-2\">\n          <button className=\"px-3 py-1 border rounded bg-white hover:bg-gray-100 disabled:opacity-50\" disabled>Previous</button>\n          <button className=\"px-3 py-1 border rounded bg-white hover:bg-gray-100\">Next</button>\n        </div>\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { Search, Filter, ChevronDown, MoreHorizontal, Download } from \'lucide-react\';\nimport { StatusBadge } from \'../../citizen/screens/MyReports\';\nimport { cn } from \'../../utils\';\n\nexport const GovIssueQueue: React.FC<{ onNavigate: (s: any, id?: string) => void }> = ({ onNavigate }) => {\n  const { issues } = useApp();\n  const [searchTerm, setSearchTerm] = useState(\'\');\n\n  return (\n    <div className=\"h-full flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden animate-in fade-in duration-300 max-w-7xl mx-auto w-full\">\n      \n      {/* Toolbar */}\n      <div className=\"p-4 border-b border-slate-100 flex items-center justify-between bg-white shrink-0\">\n        <div className=\"flex gap-3\">\n          <div className=\"relative\">\n            <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" size={16} />\n            <input \n              type=\"text\" \n              placeholder=\"Search ID, Type, Ward...\" \n              value={searchTerm}\n              onChange={e => setSearchTerm(e.target.value)}\n              className=\"pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none w-72 transition-all placeholder-slate-400\"\n            />\n          </div>\n          <button className=\"flex items-center gap-2 px-4 py-2 border border-slate-200 rounded-lg text-sm font-medium bg-white hover:bg-slate-50 text-slate-700 transition-colors\">\n            <Filter size={16} /> Filters\n          </button>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <button className=\"flex items-center gap-2 px-4 py-2 border border-slate-200 rounded-lg text-sm font-medium bg-white hover:bg-slate-50 text-slate-700 transition-colors\">\n            <Download size={16} /> Export\n          </button>\n          <button className=\"px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-bold shadow-sm transition-colors\">\n            Bulk Assign\n          </button>\n        </div>\n      </div>\n\n      {/* Table */}\n      <div className=\"flex-1 overflow-auto\">\n        <table className=\"w-full text-sm text-left whitespace-nowrap\">\n          <thead className=\"text-xs text-slate-500 bg-slate-50/50 uppercase tracking-wider sticky top-0 z-10\">\n            <tr>\n              <th className=\"px-6 py-4 font-semibold\">Priority</th>\n              <th className=\"px-6 py-4 font-semibold\">Issue ID</th>\n              <th className=\"px-6 py-4 font-semibold\">Details</th>\n              <th className=\"px-6 py-4 font-semibold\">Location</th>\n              <th className=\"px-6 py-4 font-semibold\">AI Intel</th>\n              <th className=\"px-6 py-4 font-semibold\">Assignment</th>\n              <th className=\"px-6 py-4 font-semibold\">SLA Limit</th>\n              <th className=\"px-6 py-4 font-semibold\">Status</th>\n              <th className=\"px-6 py-4 font-semibold text-center\">Action</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100\">\n            {issues.filter(i => \n              i.id.includes(searchTerm) || \n              i.type.toLowerCase().includes(searchTerm.toLowerCase()) ||\n              i.ward.toLowerCase().includes(searchTerm.toLowerCase())\n            ).map(issue => (\n              <tr key={issue.id} className=\"hover:bg-slate-50 transition-colors group cursor-pointer\" onClick={() => onNavigate(\'issue_detail\', issue.id)}>\n                <td className=\"px-6 py-4\">\n                  <div className=\"flex items-center gap-2\">\n                    <div className={cn(\n                      \"w-2 h-2 rounded-full\",\n                      issue.priority === \'Critical\' ? \"bg-red-500\" :\n                      issue.priority === \'High\' ? \"bg-amber-500\" :\n                      issue.priority === \'Medium\' ? \"bg-blue-500\" : \"bg-slate-400\"\n                    )} />\n                    <span className=\"font-bold text-slate-700\">{issue.priority}</span>\n                  </div>\n                </td>\n                <td className=\"px-6 py-4\">\n                  <span className=\"font-mono font-bold text-blue-700 bg-blue-50 border border-blue-100 px-2.5 py-1 rounded-md\">{issue.id}</span>\n                </td>\n                <td className=\"px-6 py-4\">\n                  <div className=\"font-bold text-slate-900\">{issue.type}</div>\n                  <div className=\"text-xs text-slate-500\">{issue.reportsCount} citizen reports</div>\n                </td>\n                <td className=\"px-6 py-4\">\n                  <div className=\"font-medium text-slate-800\">{issue.ward}</div>\n                  <div className=\"text-xs text-slate-500 truncate max-w-[150px]\">{issue.location}</div>\n                </td>\n                <td className=\"px-6 py-4\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200\">{issue.aiConfidence}% match</span>\n                  </div>\n                </td>\n                <td className=\"px-6 py-4\">\n                  <div className=\"font-medium text-slate-800\">{issue.department}</div>\n                  <div className=\"text-xs text-slate-500\">{issue.assignee}</div>\n                </td>\n                <td className=\"px-6 py-4\">\n                  <div className={cn(\"font-bold\", issue.slaRemaining.startsWith(\'-\') ? \"text-red-600\" : \"text-slate-700\")}>\n                    {issue.slaRemaining}\n                  </div>\n                </td>\n                <td className=\"px-6 py-4\">\n                  <StatusBadge status={issue.status} />\n                </td>\n                <td className=\"px-6 py-4 text-center\">\n                  <button \n                    onClick={(e) => { e.stopPropagation(); onNavigate(\'issue_detail\', issue.id); }}\n                    className=\"text-slate-400 hover:text-blue-600 p-1 rounded transition-colors\"\n                  >\n                    <MoreHorizontal size={20} />\n                  </button>\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      </div>\n      \n      <div className=\"p-4 border-t border-slate-100 bg-white flex items-center justify-between text-sm text-slate-500 shrink-0\">\n        <div>Showing {issues.length} issues</div>\n        <div className=\"flex gap-2\">\n          <button className=\"px-3 py-1.5 border border-slate-200 rounded-lg bg-white hover:bg-slate-50 font-medium disabled:opacity-50 transition-colors\" disabled>Previous</button>\n          <button className=\"px-3 py-1.5 border border-slate-200 rounded-lg bg-white hover:bg-slate-50 font-medium transition-colors\">Next</button>\n        </div>\n      </div>\n    </div>\n  );\n};"
