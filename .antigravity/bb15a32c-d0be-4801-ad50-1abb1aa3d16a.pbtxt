r          </button>        </div>      </div>      {/* Main 3-Column Layout */}      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">                {/* COL 1: Evidence (3 cols) */}        <div className=\"lg:col-span-3 space-y-6\">          <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col\">"
    }
