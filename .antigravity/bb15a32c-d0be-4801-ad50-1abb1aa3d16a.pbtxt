    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer, LineChart, Line } from \'recharts\';\nimport { useApp } from \'../../context/AppContext\';\n\nexport const GovAnalytics: React.FC = () => {\n  const { issues } = useApp();\n\n  const deptData = [\n    { name: \'Roads\', open: 420, resolved: 1200 },\n    { name: \'Sanitation\', open: 380, resolved: 1400 },\n    { name: \'Electrical\', open: 150, resolved: 800 },\n    { name: \'Drainage\', open: 290, resolved: 600 },\n    { name: \'Water\', open: 110, resolved: 450 },\n  ];\n\n  const trendData = [\n    { name: \'Jan\', issues: 1200 },\n    { name: \'Feb\', issues: 1900 },\n    { name: \'Mar\', issues: 1500 },\n    { name: \'Apr\', issues: 2200 },\n    { name: \'May\', issues: 1800 },\n    { name: \'Jun\', issues: 2481 }, // Current\n  ];\n\n  return (\n    <div className=\"max-w-[1600px] mx-auto animate-in fade-in duration-300 space-y-6 pb-10\">\n      <div>\n        <h2 className=\"text-2xl font-bold text-gray-900\">City Analytics Dashboard</h2>\n        <p className=\"text-sm text-gray-500\">Macro-level operational performance and trends.</p>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        \n        {/* Chart 1 */}\n        <div className=\"bg-white p-5 rounded-xl shadow-sm border border-gray-200\">\n          <h3 className=\"font-bold text-gray-900 mb-6\">Department Workload & Resolution</h3>\n          <div className=\"h-80\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <BarChart data={deptData} margin={{ top: 5, right: 30, left: 20, bottom: 5 }}>\n                <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#e2e8f0\" />\n                <XAxis dataKey=\"name\" axisLine={false} tickLine={false} tick={{fill: \'#64748b\', fontSize: 12}} />\n                <YAxis axisLine={false} tickLine={false} tick={{fill: \'#64748b\', fontSize: 12}} />\n                <Tooltip cursor={{fill: \'#f1f5f9\'}} contentStyle={{borderRadius: \'8px\', border: \'none\', boxShadow: \'0 4px 6px -1px rgb(0 0 0 / 0.1)\'}} />\n                <Legend iconType=\"circle\" wrapperStyle={{fontSize: \'12px\'}} />\n                <Bar dataKey=\"open\" name=\"Open Issues\" fill=\"#ef4444\" radius={[4, 4, 0, 0]} barSize={20} />\n                <Bar dataKey=\"resolved\" name=\"Resolved Issues\" fill=\"#10b981\" radius={[4, 4, 0, 0]} barSize={20} />\n              </BarChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Chart 2 */}\n        <div className=\"bg-white p-5 rounded-xl shadow-sm border border-gray-200\">\n          <h3 className=\"font-bold text-gray-900 mb-6\">Report Volume Trend (YTD)</h3>\n          <div className=\"h-80\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <LineChart data={trendData} margin={{ top: 5, right: 30, left: 20, bottom: 5 }}>\n                <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#e2e8f0\" />\n                <XAxis dataKey=\"name\" axisLine={false} tickLine={false} tick={{fill: \'#64748b\', fontSize: 12}} />\n                <YAxis axisLine={false} tickLine={false} tick={{fill: \'#64748b\', fontSize: 12}} />\n                <Tooltip contentStyle={{borderRadius: \'8px\', border: \'none\', boxShadow: \'0 4px 6px -1px rgb(0 0 0 / 0.1)\'}} />\n                <Line type=\"monotone\" dataKey=\"issues\" name=\"Total Reports\" stroke=\"#3b82f6\" strokeWidth={3} dot={{r: 4, strokeWidth: 2}} activeDot={{r: 6}} />\n              </LineChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
