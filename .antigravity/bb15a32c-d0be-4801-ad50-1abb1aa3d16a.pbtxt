    instruction: "Apply Professional Polish theme to GovIssueDetail, updating borders, backgrounds, text colors, and component styles."
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { ArrowLeft, MapPin, ShieldAlert, Cpu, Layers, UserPlus, FileCheck, XCircle, CheckCircle2, AlertTriangle, Truck, Clock } from \'lucide-react\';\nimport { StatusBadge } from \'../../citizen/screens/MyReports\';\nimport { formatDate, cn } from \'../../utils\';\n\nexport const GovIssueDetail: React.FC<{ issueId: string, onBack: () => void }> = ({ issueId, onBack }) => {\n  const { issues, updateIssueStatus, updateIssueAssignment } = useApp();\n  const issue = issues.find(i => i.id === issueId);\n\n  if (!issue) return null;\n\n  return (\n    <div className=\"max-w-[1600px] mx-auto animate-in fade-in duration-300\">\n      \n      {/* Header */}\n      <div className=\"flex items-center justify-between mb-6\">\n        <div className=\"flex items-center gap-4\">\n          <button onClick={onBack} className=\"p-2 bg-white border border-gray-200 rounded-lg text-gray-500 hover:text-gray-900 shadow-sm transition-colors\">\n            <ArrowLeft size={20} />\n          </button>\n          <div>\n            <div className=\"flex items-center gap-3\">\n              <h2 className=\"text-2xl font-bold text-gray-900\">Issue #{issue.id}</h2>\n              <StatusBadge status={issue.status} />\n              <span className={cn(\n                \"text-xs font-bold uppercase px-2.5 py-1 rounded-full\",\n                issue.priority === \'Critical\' ? \"bg-red-100 text-red-700\" :\n                issue.priority === \'High\' ? \"bg-orange-100 text-orange-700\" :\n                \"bg-gray-100 text-gray-700\"\n              )}>\n                {issue.priority} PRIORITY\n              </span>\n            </div>\n          </div>\n        </div>\n        \n        <div className=\"flex gap-3\">\n          <button className=\"px-4 py-2 border border-gray-300 rounded-lg text-sm font-bold bg-white text-gray-700 hover:bg-gray-50 shadow-sm\">\n            Print Dossier\n          </button>\n        </div>\n      </div>\n\n      {/* Main 3-Column Layout */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n        \n        {/* COL 1: Evidence (3 cols) */}\n        <div className=\"lg:col-span-3 space-y-6\">\n          <div className=\"bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col\">\n            <div className=\"p-3 border-b bg-gray-50 font-bold text-gray-800 text-sm flex items-center gap-2\">\n              <MapPin size={16} className=\"text-blue-500\" /> Location Evidence\n            </div>\n            <div className=\"p-4 space-y-4\">\n              <div>\n                <p className=\"text-xs font-bold text-gray-500 uppercase tracking-wider mb-2\">Primary Photo</p>\n                <img src={issue.images.before} alt=\"Reported\" className=\"w-full h-48 object-cover rounded-lg border border-gray-100 shadow-sm\" />\n              </div>\n              <div className=\"bg-gray-50 p-3 rounded-lg border text-sm\">\n                <p className=\"font-bold text-gray-900\">{issue.ward}</p>\n                <p className=\"text-gray-600 mt-1\">{issue.location}</p>\n                <p className=\"text-xs text-gray-400 mt-2 font-mono\">{issue.lat.toFixed(4)}, {issue.lng.toFixed(4)}</p>\n              </div>\n              \n              <div className=\"h-32 bg-blue-50 rounded-lg border border-blue-100 relative overflow-hidden flex items-center justify-center\">\n                 <div className=\"absolute inset-0\" style={{ backgroundImage: \'radial-gradient(#93c5fd 1px, transparent 1px)\', backgroundSize: \'10px 10px\' }}></div>\n                 <MapPin size={32} className=\"text-red-500 relative z-10\" />\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* COL 2: Intelligence & Citizen Reports (5 cols) */}\n        <div className=\"lg:col-span-5 space-y-6\">\n          <div className=\"bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col\">\n            <div className=\"p-3 border-b bg-gray-50 font-bold text-gray-800 text-sm flex items-center gap-2\">\n              <Cpu size={16} className=\"text-indigo-500\" /> Platform Intelligence\n            </div>\n            <div className=\"p-5 grid grid-cols-2 gap-x-6 gap-y-6\">\n              \n              <div>\n                <p className=\"text-[10px] font-bold text-gray-500 uppercase tracking-wider\">AI Classification</p>\n                <p className=\"text-lg font-bold text-gray-900 mt-0.5\">{issue.type}</p>\n                <div className=\"flex items-center gap-2 mt-1\">\n                  <div className=\"h-1.5 flex-1 bg-gray-100 rounded-full overflow-hidden\">\n                    <div className=\"h-full bg-indigo-500 rounded-full\" style={{ width: `${issue.aiConfidence}%` }} />\n                  </div>\n                  <span className=\"text-xs font-bold text-indigo-700\">{issue.aiConfidence}%</span>\n                </div>\n              </div>\n\n              <div>\n                <p className=\"text-[10px] font-bold text-gray-500 uppercase tracking-wider\">Spam/Fake Risk</p>\n                <div className=\"flex items-center gap-2 mt-1.5\">\n                  <ShieldAlert size={18} className=\"text-green-500\" />\n                  <span className=\"font-bold text-green-700\">Low (2%)</span>\n                </div>\n              </div>\n\n              <div>\n                <p className=\"text-[10px] font-bold text-gray-500 uppercase tracking-wider\">Jurisdiction</p>\n                <p className=\"text-sm font-bold text-gray-900 mt-1\">Municipal Corporation</p>\n                <p className=\"text-xs text-gray-500\">{issue.department} Dept.</p>\n              </div>\n\n              <div>\n                <p className=\"text-[10px] font-bold text-gray-500 uppercase tracking-wider\">Nearby Risks</p>\n                <p className=\"text-sm font-bold text-amber-600 mt-1 flex items-center gap-1\">\n                  <AlertTriangle size={14} /> School Zone (120m)\n                </p>\n              </div>\n\n            </div>\n          </div>\n\n          <div className=\"bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col\">\n            <div className=\"p-3 border-b bg-gray-50 font-bold text-gray-800 text-sm flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <Layers size={16} className=\"text-blue-500\" /> Duplicate Cluster\n              </div>\n              <span className=\"bg-blue-100 text-blue-800 text-xs font-bold px-2 py-0.5 rounded-full\">{issue.reportsCount} Reports</span>\n            </div>\n            <div className=\"p-4\">\n              <p className=\"text-sm text-gray-600 mb-4\">\n                The platform has automatically merged <strong className=\"text-gray-900\">{issue.reportsCount}</strong> individual citizen reports into this canonical issue to prevent municipal operational duplication.\n              </p>\n              \n              <div className=\"space-y-3\">\n                {[1, 2, 3].map((n) => (\n                  <div key={n} className=\"flex gap-3 items-center p-2 rounded-lg hover:bg-gray-50 border border-transparent hover:border-gray-100\">\n                    <img src={issue.images.before} className=\"w-10 h-10 rounded object-cover opacity-80\" alt=\"\" />\n                    <div className=\"flex-1\">\n                      <p className=\"text-xs font-bold text-gray-800\">Report #{Math.floor(Math.random() * 90000)}</p>\n                      <p className=\"text-[10px] text-gray-500 truncate max-w-[200px]\">\"{issue.description}\"</p>\n                    </div>\n                    <span className=\"text-[10px] text-gray-400\">{formatDate(issue.reportedAt).split(\',\')[0]}</span>\n                  </div>\n                ))}\n                <button className=\"w-full py-2 text-xs font-bold text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors\">\n                  View All {issue.reportsCount} Reports\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* COL 3: Workflow & Actions (4 cols) */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          <div className=\"bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col border-t-4 border-t-blue-600\">\n            <div className=\"p-4 border-b\">\n              <h3 className=\"font-bold text-gray-900\">Operational Workflow</h3>\n            </div>\n            <div className=\"p-5 space-y-5\">\n              \n              <div>\n                <p className=\"text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1\">Current Owner</p>\n                <div className=\"flex justify-between items-center bg-gray-50 p-3 rounded-lg border border-gray-100\">\n                  <div>\n                    <p className=\"font-bold text-gray-900 text-sm\">{issue.assignee}</p>\n                    <p className=\"text-xs text-gray-500\">{issue.department} Department</p>\n                  </div>\n                  <button className=\"p-2 bg-white rounded shadow-sm border text-blue-600 hover:bg-blue-50\">\n                    <UserPlus size={16} />\n                  </button>\n                </div>\n              </div>\n\n              <div>\n                <p className=\"text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1\">SLA Status</p>\n                <div className=\"flex justify-between items-end\">\n                  <div>\n                    <p className={cn(\"text-2xl font-bold\", issue.slaRemaining.startsWith(\'-\') ? \"text-red-600\" : \"text-gray-900\")}>\n                      {issue.slaRemaining}\n                    </p>\n                    <p className=\"text-xs text-gray-500 mt-0.5\">remaining of {issue.slaHours}h SLA</p>\n                  </div>\n                  {issue.slaRemaining.startsWith(\'-\') && (\n                    <span className=\"bg-red-100 text-red-700 text-[10px] font-bold px-2 py-1 rounded uppercase animate-pulse\">Breached</span>\n                  )}\n                </div>\n              </div>\n\n              <hr className=\"border-gray-100\" />\n\n              <div className=\"space-y-2\">\n                <p className=\"text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-2\">Actions</p>\n                \n                {issue.status === \'Submitted\' || issue.status === \'Under Review\' ? (\n                  <button \n                    onClick={() => updateIssueAssignment(issue.id, \'Rapid Response Team\')}\n                    className=\"w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-bold text-sm shadow-sm transition-colors flex justify-center items-center gap-2\"\n                  >\n                    <UserPlus size={18} /> Assign to Field Team\n                  </button>\n                ) : issue.status === \'Assigned\' ? (\n                  <button \n                    onClick={() => updateIssueStatus(issue.id, \'In Progress\', \'Team dispatched to site.\')}\n                    className=\"w-full bg-amber-500 hover:bg-amber-600 text-white py-3 rounded-xl font-bold text-sm shadow-sm transition-colors flex justify-center items-center gap-2\"\n                  >\n                    <Truck size={18} /> Mark as In Progress\n                  </button>\n                ) : issue.status === \'In Progress\' || issue.status === \'Reopened\' ? (\n                  <button \n                    onClick={() => updateIssueStatus(issue.id, \'Awaiting Verification\', \'Work completed. Awaiting citizen confirmation.\')}\n                    className=\"w-full bg-green-600 hover:bg-green-700 text-white py-3 rounded-xl font-bold text-sm shadow-sm transition-colors flex justify-center items-center gap-2\"\n                  >\n                    <CheckCircle2 size={18} /> Submit for Citizen Verification\n                  </button>\n                ) : issue.status === \'Awaiting Verification\' ? (\n                  <div className=\"bg-blue-50 border border-blue-200 text-blue-800 p-3 rounded-lg text-sm font-semibold flex items-center gap-2 justify-center\">\n                    <Clock size={16} /> Awaiting Citizen Verification\n                  </div>\n                ) : (\n                  <div className=\"bg-gray-100 border border-gray-200 text-gray-600 p-3 rounded-lg text-sm font-semibold flex items-center gap-2 justify-center\">\n                    <CheckCircle2 size={16} /> Issue Closed\n                  </div>\n                )}\n                \n                {issue.status !== \'Closed\' && issue.status !== \'Awaiting Verification\' && (\n                  <button className=\"w-full bg-white border border-red-200 hover:bg-red-50 text-red-600 py-2.5 rounded-xl font-bold text-sm transition-colors\">\n                    Escalate Issue\n                  </button>\n                )}\n              </div>\n\n            </div>\n          </div>\n\n          {/* Timeline */}\n          <div className=\"bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col p-5\">\n            <h3 className=\"font-bold text-gray-900 mb-4\">Audit Trail</h3>\n            <div className=\"space-y-4 relative before:absolute before:inset-0 before:ml-[11px] before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-slate-300 before:to-transparent hidden-before-psuedo\">\n              <div className=\"absolute left-3 top-2 bottom-2 w-0.5 bg-gray-200\" />\n              {issue.timeline.map((event, i) => (\n                <div key={event.id} className=\"relative z-10 flex gap-3\">\n                  <div className=\"w-6 h-6 rounded-full bg-blue-100 border-2 border-white text-blue-600 flex items-center justify-center shrink-0 shadow-sm mt-0.5\">\n                    <div className=\"w-2 h-2 bg-blue-600 rounded-full\" />\n                  </div>\n                  <div>\n                    <p className=\"text-sm font-bold text-gray-900\">{event.title}</p>\n                    <p className=\"text-[10px] text-gray-500 mb-0.5\">{formatDate(event.timestamp)}</p>\n                    <p className=\"text-xs text-gray-600\">{event.description}</p>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { ArrowLeft, MapPin, ShieldAlert, Cpu, Layers, UserPlus, FileCheck, XCircle, CheckCircle2, AlertTriangle, Truck, Clock } from \'lucide-react\';\nimport { StatusBadge } from \'../../citizen/screens/MyReports\';\nimport { formatDate, cn } from \'../../utils\';\n\nexport const GovIssueDetail: React.FC<{ issueId: string, onBack: () => void }> = ({ issueId, onBack }) => {\n  const { issues, updateIssueStatus, updateIssueAssignment } = useApp();\n  const issue = issues.find(i => i.id === issueId);\n\n  if (!issue) return null;\n\n  return (\n    <div className=\"max-w-7xl mx-auto animate-in fade-in duration-300 w-full\">\n      \n      {/* Header */}\n      <div className=\"flex items-center justify-between mb-6\">\n        <div className=\"flex items-center gap-4\">\n          <button onClick={onBack} className=\"p-2 bg-white border border-slate-200 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-50 shadow-sm transition-colors\">\n            <ArrowLeft size={20} />\n          </button>\n          <div>\n            <div className=\"flex items-center gap-3\">\n              <h2 className=\"text-2xl font-bold text-slate-900 tracking-tight\">Issue #{issue.id}</h2>\n              <StatusBadge status={issue.status} />\n              <span className={cn(\n                \"text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full\",\n                issue.priority === \'Critical\' ? \"bg-red-100 text-red-700\" :\n                issue.priority === \'High\' ? \"bg-amber-100 text-amber-700\" :\n                \"bg-slate-100 text-slate-700\"\n              )}>\n                {issue.priority} PRIORITY\n              </span>\n            </div>\n          </div>\n        </div>\n        \n        <div className=\"flex gap-3\">\n          <button className=\"px-4 py-2 border border-slate-200 rounded-lg text-sm font-bold bg-white text-slate-700 hover:bg-slate-50 shadow-sm transition-colors\">\n            Print Dossier\n          </button>\n        </div>\n      </div>\n\n      {/* Main 3-Column Layout */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n        \n        {/* COL 1: Evidence (3 cols) */}\n        <div className=\"lg:col-span-3 space-y-6\">\n          <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col\">\n            <div className=\"px-4 py-3 border-b border-slate-100 bg-white font-bold text-slate-800 text-sm flex items-center gap-2 tracking-tight\">\n              <MapPin size={16} className=\"text-blue-600\" /> Location Evidence\n            </div>\n            <div className=\"p-4 space-y-4\">\n              <div>\n                <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2\">Primary Photo</p>\n                <img src={issue.images.before} alt=\"Reported\" className=\"w-full h-48 object-cover rounded-lg border border-slate-100 shadow-sm\" />\n              </div>\n              <div className=\"bg-slate-50 p-3 rounded-lg border border-slate-100 text-sm\">\n                <p className=\"font-bold text-slate-900\">{issue.ward}</p>\n                <p className=\"text-slate-600 mt-1\">{issue.location}</p>\n                <p className=\"text-xs text-slate-400 mt-2 font-mono\">{issue.lat.toFixed(4)}, {issue.lng.toFixed(4)}</p>\n              </div>\n              \n              <div className=\"h-32 bg-blue-50 rounded-lg border border-blue-100 relative overflow-hidden flex items-center justify-center\">\n                 <div className=\"absolute inset-0\" style={{ backgroundImage: \'radial-gradient(#93c5fd 1px, transparent 1px)\', backgroundSize: \'10px 10px\' }}></div>\n                 <MapPin size={32} className=\"text-red-500 relative z-10\" />\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* COL 2: Intelligence & Citizen Reports (5 cols) */}\n        <div className=\"lg:col-span-5 space-y-6\">\n          <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col\">\n            <div className=\"px-4 py-3 border-b border-slate-100 bg-white font-bold text-slate-800 text-sm flex items-center gap-2 tracking-tight\">\n              <Cpu size={16} className=\"text-indigo-600\" /> Platform Intelligence\n            </div>\n            <div className=\"p-5 grid grid-cols-2 gap-x-6 gap-y-6\">\n              \n              <div>\n                <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">AI Classification</p>\n                <p className=\"text-lg font-bold text-slate-900 mt-0.5 tracking-tight\">{issue.type}</p>\n                <div className=\"flex items-center gap-2 mt-1\">\n                  <div className=\"h-1.5 flex-1 bg-slate-100 rounded-full overflow-hidden\">\n                    <div className=\"h-full bg-indigo-500 rounded-full\" style={{ width: `${issue.aiConfidence}%` }} />\n                  </div>\n                  <span className=\"text-xs font-bold text-indigo-700\">{issue.aiConfidence}%</span>\n                </div>\n              </div>\n\n              <div>\n                <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Spam/Fake Risk</p>\n                <div className=\"flex items-center gap-2 mt-1.5\">\n                  <ShieldAlert size={18} className=\"text-emerald-500\" />\n                  <span className=\"font-bold text-emerald-700 tracking-tight\">Low (2%)</span>\n                </div>\n              </div>\n\n              <div>\n                <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Jurisdiction</p>\n                <p className=\"text-sm font-bold text-slate-900 mt-1\">Municipal Corporation</p>\n                <p className=\"text-xs text-slate-500\">{issue.department} Dept.</p>\n              </div>\n\n              <div>\n                <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Nearby Risks</p>\n                <p className=\"text-sm font-bold text-amber-600 mt-1 flex items-center gap-1\">\n                  <AlertTriangle size={14} /> School Zone (120m)\n                </p>\n              </div>\n\n            </div>\n          </div>\n\n          <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col\">\n            <div className=\"px-4 py-3 border-b border-slate-100 bg-white font-bold text-slate-800 text-sm flex items-center justify-between tracking-tight\">\n              <div className=\"flex items-center gap-2\">\n                <Layers size={16} className=\"text-blue-600\" /> Duplicate Cluster\n              </div>\n              <span className=\"bg-blue-50 text-blue-700 border border-blue-100 text-[10px] font-bold px-2 py-0.5 rounded-full tracking-wider uppercase\">{issue.reportsCount} Reports</span>\n            </div>\n            <div className=\"p-4\">\n              <p className=\"text-sm text-slate-600 mb-4\">\n                The platform has automatically merged <strong className=\"text-slate-900\">{issue.reportsCount}</strong> individual citizen reports into this canonical issue to prevent municipal operational duplication.\n              </p>\n              \n              <div className=\"space-y-3\">\n                {[1, 2, 3].map((n) => (\n                  <div key={n} className=\"flex gap-3 items-center p-2 rounded-lg hover:bg-slate-50 border border-transparent hover:border-slate-100 transition-colors\">\n                    <img src={issue.images.before} className=\"w-10 h-10 rounded-md object-cover opacity-80\" alt=\"\" />\n                    <div className=\"flex-1\">\n                      <p className=\"text-xs font-bold text-slate-800\">Report #{Math.floor(Math.random() * 90000)}</p>\n                      <p className=\"text-[10px] text-slate-500 truncate max-w-[200px]\">\"{issue.description}\"</p>\n                    </div>\n                    <span className=\"text-[10px] text-slate-400 font-medium\">{formatDate(issue.reportedAt).split(\',\')[0]}</span>\n                  </div>\n                ))}\n                <button className=\"w-full py-2 text-xs font-bold text-blue-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors shadow-sm\">\n                  View All {issue.reportsCount} Reports\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* COL 3: Workflow & Actions (4 cols) */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col border-t-4 border-t-blue-600\">\n            <div className=\"px-4 py-3 border-b border-slate-100 bg-white\">\n              <h3 className=\"font-bold text-slate-900 tracking-tight\">Operational Workflow</h3>\n            </div>\n            <div className=\"p-5 space-y-5\">\n              \n              <div>\n                <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2\">Current Owner</p>\n                <div className=\"flex justify-between items-center bg-slate-50 p-3 rounded-lg border border-slate-100\">\n                  <div>\n                    <p className=\"font-bold text-slate-900 text-sm tracking-tight\">{issue.assignee}</p>\n                    <p className=\"text-xs text-slate-500\">{issue.department} Department</p>\n                  </div>\n                  <button className=\"p-2 bg-white rounded-md shadow-sm border border-slate-200 text-blue-600 hover:bg-slate-50 transition-colors\">\n                    <UserPlus size={16} />\n                  </button>\n                </div>\n              </div>\n\n              <div>\n                <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2\">SLA Status</p>\n                <div className=\"flex justify-between items-end\">\n                  <div>\n                    <p className={cn(\"text-2xl font-bold tracking-tight\", issue.slaRemaining.startsWith(\'-\') ? \"text-red-600\" : \"text-slate-900\")}>\n                      {issue.slaRemaining}\n                    </p>\n                    <p className=\"text-xs text-slate-500 mt-0.5 font-medium\">remaining of {issue.slaHours}h SLA</p>\n                  </div>\n                  {issue.slaRemaining.startsWith(\'-\') && (\n                    <span className=\"bg-red-50 text-red-700 border border-red-200 text-[10px] font-bold px-2 py-1 rounded-md uppercase tracking-wider animate-pulse\">Breached</span>\n                  )}\n                </div>\n              </div>\n\n              <hr className=\"border-slate-100\" />\n\n              <div className=\"space-y-2.5\">\n                <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2\">Actions</p>\n                \n                {issue.status === \'Submitted\' || issue.status === \'Under Review\' ? (\n                  <button \n                    onClick={() => updateIssueAssignment(issue.id, \'Rapid Response Team\')}\n                    className=\"w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-bold text-[15px] shadow-sm transition-colors flex justify-center items-center gap-2\"\n                  >\n                    <UserPlus size={18} /> Assign to Field Team\n                  </button>\n                ) : issue.status === \'Assigned\' ? (\n                  <button \n                    onClick={() => updateIssueStatus(issue.id, \'In Progress\', \'Team dispatched to site.\')}\n                    className=\"w-full bg-amber-500 hover:bg-amber-600 text-white py-3 rounded-xl font-bold text-[15px] shadow-sm transition-colors flex justify-center items-center gap-2\"\n                  >\n                    <Truck size={18} /> Mark as In Progress\n                  </button>\n                ) : issue.status === \'In Progress\' || issue.status === \'Reopened\' ? (\n                  <button \n                    onClick={() => updateIssueStatus(issue.id, \'Awaiting Verification\', \'Work completed. Awaiting citizen confirmation.\')}\n                    className=\"w-full bg-emerald-600 hover:bg-emerald-700 text-white py-3 rounded-xl font-bold text-[15px] shadow-sm transition-colors flex justify-center items-center gap-2\"\n                  >\n                    <CheckCircle2 size={18} /> Submit for Citizen Verification\n                  </button>\n                ) : issue.status === \'Awaiting Verification\' ? (\n                  <div className=\"bg-blue-50 border border-blue-200 text-blue-800 p-3 rounded-lg text-sm font-semibold flex items-center gap-2 justify-center\">\n                    <Clock size={16} /> Awaiting Citizen Verification\n                  </div>\n                ) : (\n                  <div className=\"bg-slate-50 border border-slate-200 text-slate-600 p-3 rounded-lg text-sm font-semibold flex items-center gap-2 justify-center\">\n                    <CheckCircle2 size={16} /> Issue Closed\n                  </div>\n                )}\n                \n                {issue.status !== \'Closed\' && issue.status !== \'Awaiting Verification\' && (\n                  <button className=\"w-full bg-white border border-slate-200 hover:bg-red-50 text-red-600 hover:border-red-200 py-3 rounded-xl font-bold text-[15px] transition-colors shadow-sm mt-2\">\n                    Escalate Issue\n                  </button>\n                )}\n              </div>\n\n            </div>\n          </div>\n\n          {/* Timeline */}\n          <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col p-5\">\n            <h3 className=\"font-bold text-slate-900 mb-4 tracking-tight\">Audit Trail</h3>\n            <div className=\"space-y-4 relative\">\n              <div className=\"absolute left-3 top-2 bottom-2 w-0.5 bg-slate-200\" />\n              {issue.timeline.map((event, i) => (\n                <div key={event.id} className=\"relative z-10 flex gap-3\">\n                  <div className=\"w-6 h-6 rounded-full bg-blue-50 border-2 border-white text-blue-600 flex items-center justify-center shrink-0 shadow-sm mt-0.5\">\n                    <div className=\"w-2 h-2 bg-blue-600 rounded-full\" />\n                  </div>\n                  <div>\n                    <p className=\"text-sm font-bold text-slate-900 tracking-tight\">{event.title}</p>\n                    <p className=\"text-[10px] text-slate-500 mb-0.5 font-medium uppercase tracking-wider\">{formatDate(event.timestamp)}</p>\n                    <p className=\"text-xs text-slate-600\">{event.description}</p>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </div>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
