    replacement_infos {
      original_chunk {
        target_content: "  // Auth state\n  const [authState, setAuthState] = useState<AuthState>(\'NOT_AUTHENTICATED\');\n  const [user, setUser] = useState<User | null>(null);\n\n  useEffect(() => {\n    // Load auth state from local storage on mount\n    const storedAuth = localStorage.getItem(\'cscirr_authenticated\');\n    const storedUser = localStorage.getItem(\'cscirr_user\');\n    \n    if (storedAuth === \'true\' && storedUser) {\n      setAuthState(\'AUTHENTICATED\');\n      setUser(JSON.parse(storedUser));\n    }"
        replacement_content: "  // Auth state\n  const [citizenAuthState, setCitizenAuthState] = useState<AuthState>(\'NOT_AUTHENTICATED\');\n  const [citizenUser, setCitizenUser] = useState<CitizenUser | null>(null);\n  \n  const [govUser, setGovUser] = useState<GovUser | null>(null);\n\n  // We still provide active context alias for ease of use in deep components,\n  // but it\'s better to explicitly check which app is active.\n  const [activeApp, setActiveApp] = useState<\'CITIZEN\' | \'GOV\'>(\'CITIZEN\');\n\n  useEffect(() => {\n    const storedCitizenAuth = localStorage.getItem(\'cscirr_citizen_auth\');\n    const storedCitizenUser = localStorage.getItem(\'cscirr_citizen_user\');\n    \n    if (storedCitizenAuth === \'true\' && storedCitizenUser) {\n      setCitizenAuthState(\'AUTHENTICATED\');\n      setCitizenUser(JSON.parse(storedCitizenUser));\n    }\n\n    const storedGovAuth = localStorage.getItem(\'cscirr_gov_auth\');\n    const storedGovUser = localStorage.getItem(\'cscirr_gov_user\');\n\n    if (storedGovAuth === \'true\' && storedGovUser) {\n      setGovUser(JSON.parse(storedGovUser));\n    }\n    \n    const storedApp = localStorage.getItem(\'cscirr_active_app\');\n    if (storedApp === \'GOV\' || storedApp === \'CITIZEN\') {\n      setActiveApp(storedApp);\n    }\n"
      }
      num_matches: 1
    }
  }
}
