        target_content: "import React, { createContext, useContext, useState, useEffect } from \'react\';\nimport { Issue, IssueStatus, AuthState, User, CitizenUser, GovUser } from \'../types\';\nimport { MOCK_ISSUES } from \'../data\';\n\ninterface AppContextType {\n  issues: Issue[];\n  addIssue: (issue: Issue) => void;\n  updateIssueStatus: (id: string, status: IssueStatus, comment?: string, afterImage?: string) => void;\n  updateIssueAssignment: (id: string, assignee: string) => void;\n  isOffline: boolean;\n  toggleOffline: () => void;\n  offlineQueue: Issue[];\n  authState: AuthState;\n  setAuthState: (state: AuthState) => void;\n  user: User | null;\n  loginCitizen: (user: CitizenUser) => void;\n  loginGov: (user: GovUser) => void;\n  logout: () => void;\n}\n\nconst AppContext = createContext<AppContextType | undefined>(undefined);\n\nexport const AppProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const [issues, setIssues] = useState<Issue[]>(MOCK_ISSUES);\n  const [isOffline, setIsOffline] = useState(false);\n  const [offlineQueue, setOfflineQueue] = useState<Issue[]>([]);\n  \n  // Auth state\n  const [authState, setAuthState] = useState<AuthState>(\'NOT_AUTHENTICATED\');\n  const [user, setUser] = useState<User | null>(null);\n\n  useEffect(() => {\n    // Load auth state from local storage on mount\n    const storedAuth = localStorage.getItem(\'cscirr_authenticated\');\n    const storedUser = localStorage.getItem(\'cscirr_user\');\n    \n    if (storedAuth === \'true\' && storedUser) {\n      setAuthState(\'AUTHENTICATED\');\n      setUser(JSON.parse(storedUser));\n    }\n  }, []);\n\n  const loginCitizen = (citizenUser: CitizenUser) => {"
        replacement_content: "import React, { createContext, useContext, useState, useEffect } from \'react\';\nimport { Issue, IssueStatus, AuthState, User, CitizenUser, GovUser } from \'../types\';\nimport { MOCK_ISSUES } from \'../data\';\nimport { translations, LanguageCode } from \'../translations\';\n\ninterface AppContextType {\n  issues: Issue[];\n  addIssue: (issue: Issue) => void;\n  updateIssueStatus: (id: string, status: IssueStatus, comment?: string, afterImage?: string) => void;\n  updateIssueAssignment: (id: string, assignee: string) => void;\n  isOffline: boolean;\n  toggleOffline: () => void;\n  offlineQueue: Issue[];\n  authState: AuthState;\n  setAuthState: (state: AuthState) => void;\n  user: User | null;\n  loginCitizen: (user: CitizenUser) => void;\n  loginGov: (user: GovUser) => void;\n  logout: () => void;\n  language: LanguageCode;\n  setLanguage: (lang: LanguageCode) => void;\n  t: (key: keyof typeof translations.en) => string;\n  resetDemoData: () => void;\n}\n\nconst AppContext = createContext<AppContextType | undefined>(undefined);\n\nexport const AppProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const [issues, setIssues] = useState<Issue[]>(MOCK_ISSUES);\n  const [isOffline, setIsOffline] = useState(false);\n  const [offlineQueue, setOfflineQueue] = useState<Issue[]>([]);\n  const [language, setLanguageState] = useState<LanguageCode>(\'en\');\n  \n  // Auth state\n  const [authState, setAuthState] = useState<AuthState>(\'NOT_AUTHENTICATED\');\n  const [user, setUser] = useState<User | null>(null);\n\n  useEffect(() => {\n    // Load auth state from local storage on mount\n    const storedAuth = localStorage.getItem(\'cscirr_authenticated\');\n    const storedUser = localStorage.getItem(\'cscirr_user\');\n    \n    if (storedAuth === \'true\' && storedUser) {\n      setAuthState(\'AUTHENTICATED\');\n      setUser(JSON.parse(storedUser));\n    }\n\n    // Load language from local storage or detect via geolocation\n    const storedLang = localStorage.getItem(\'cscirr_language\') as LanguageCode | null;\n    if (storedLang && [\'en\', \'ta\', \'hi\'].includes(storedLang)) {\n      setLanguageState(storedLang);\n    } else {\n      // Simple GPS-based default language detection\n      if (navigator.geolocation) {\n        navigator.geolocation.getCurrentPosition(\n          (position) => {\n            const { latitude, longitude } = position.coords;\n            // Rough bounding box for Tamil Nadu\n            if (latitude >= 8.0 && latitude <= 13.5 && longitude >= 76.0 && longitude <= 80.5) {\n              setLanguageState(\'ta\');\n            } \n            // Rough bounding box for North India (Hindi speaking regions)\n            else if (latitude >= 20.0 && latitude <= 35.0 && longitude >= 70.0 && longitude <= 88.0) {\n              setLanguageState(\'hi\');\n            } else {\n              setLanguageState(\'en\');\n            }\n          },\n          () => {\n            setLanguageState(\'en\');\n          },\n          { timeout: 5000 }\n        );\n      }\n    }\n  }, []);\n\n  const setLanguage = (lang: LanguageCode) => {\n    setLanguageState(lang);\n    localStorage.setItem(\'cscirr_language\', lang);\n  };\n\n  const t = (key: keyof typeof translations.en) => {\n    return translations[language][key] || translations.en[key] || key;\n  };\n\n  const resetDemoData = () => {\n    setIssues(MOCK_ISSUES);\n    setOfflineQueue([]);\n  };\n\n  const loginCitizen = (citizenUser: CitizenUser) => {"
      }
      num_matches: 1
    }
  }
}
