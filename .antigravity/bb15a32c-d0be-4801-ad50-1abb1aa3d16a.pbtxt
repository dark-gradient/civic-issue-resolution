    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useApp } from \'../context/AppContext\';\nimport { ShieldCheck, User, Building, Smartphone, CheckCircle } from \'lucide-react\';\nimport { CitizenUser, GovUser } from \'../types\';\n\nexport const AuthFlow: React.FC = () => {\n  const { authState, setAuthState, loginCitizen, loginGov } = useApp();\n  const [view, setView] = useState<\'WELCOME\' | \'CITIZEN_AUTH\' | \'GOV_AUTH\'>(\'WELCOME\');\n  \n  // Citizen Auth State\n  const [phone, setPhone] = useState(\'\');\n  const [otp, setOtp] = useState(\'\');\n  const [aadhaar, setAadhaar] = useState(\'\');\n  const [aadhaarOtp, setAadhaarOtp] = useState(\'\');\n\n  // Gov Auth State\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [role, setRole] = useState(\'Department Officer\');\n\n  const handleCitizenMobileSubmit = () => {\n    if (phone.length >= 10) {\n      setAuthState(\'MOBILE_VERIFIED\');\n    }\n  };\n\n  const handleCitizenOtpSubmit = () => {\n    if (otp.length === 6) {\n      setAuthState(\'IDENTITY_VERIFICATION_PENDING\');\n    }\n  };\n\n  const handleAadhaarSubmit = () => {\n    if (aadhaarOtp.length === 6) {\n      setAuthState(\'IDENTITY_VERIFIED\');\n    }\n  };\n\n  const finishCitizenOnboarding = () => {\n    const mockUser: CitizenUser = {\n      type: \'Citizen\',\n      id: `usr-${Date.now()}`,\n      name: \'Arun Kumar\',\n      phone: phone || \'+91 98765 43210\',\n      aadhaarVerified: true,\n      preferredLanguage: \'English\',\n      location: \'Ward 37\',\n      createdAt: new Date().toISOString(),\n      reportsCount: 27,\n      resolvedCount: 18,\n      reopenedCount: 2,\n      contributionScore: 92\n    };\n    loginCitizen(mockUser);\n  };\n\n  const handleGovLogin = () => {\n    const mockGov: GovUser = {\n      type: \'Government\',\n      id: `gov-${Date.now()}`,\n      name: \'Priya Raman\',\n      role: role as any,\n      department: \'Roads\'\n    };\n    loginGov(mockGov);\n  };\n\n  if (view === \'WELCOME\') {\n    return (\n      <div className=\"flex flex-col items-center justify-center min-h-screen bg-slate-50 p-6\">\n        <div className=\"w-16 h-16 bg-blue-600 rounded-2xl flex items-center justify-center font-bold text-4xl text-white shadow-lg mb-6\">\n          C\n        </div>\n        <h1 className=\"text-4xl font-bold text-slate-900 tracking-tight mb-2\">CivicPulse</h1>\n        <p className=\"text-lg text-slate-500 font-medium tracking-widest uppercase mb-12\">Report. Resolve. Verify.</p>\n        \n        <div className=\"w-full max-w-md space-y-4\">\n          <button \n            onClick={() => setView(\'CITIZEN_AUTH\')}\n            className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg shadow-xl shadow-blue-900/20 flex items-center justify-center space-x-3 active:scale-95 transition-transform\"\n          >\n            <User size={24} />\n            <span>Create / Verify Account</span>\n          </button>\n          \n          <button \n            className=\"w-full bg-white text-slate-700 py-4 rounded-xl font-bold text-lg border-2 border-slate-200 shadow-sm flex items-center justify-center space-x-3 active:scale-95 transition-transform\"\n          >\n            <span>About CivicPulse</span>\n          </button>\n        </div>\n\n        <button \n          onClick={() => setView(\'GOV_AUTH\')}\n          className=\"mt-16 text-slate-400 font-medium hover:text-slate-600 flex items-center gap-2 transition-colors\"\n        >\n          <Building size={16} /> Government Staff Login\n        </button>\n      </div>\n    );\n  }\n\n  if (view === \'GOV_AUTH\') {\n    return (\n      <div className=\"flex flex-col items-center justify-center min-h-screen bg-slate-900 p-6 text-white\">\n        <div className=\"w-full max-w-md\">\n          <button onClick={() => setView(\'WELCOME\')} className=\"text-slate-400 mb-8 hover:text-white flex items-center gap-2\">\n            &larr; Back\n          </button>\n          \n          <div className=\"flex items-center gap-3 mb-8\">\n            <div className=\"w-10 h-10 bg-slate-800 rounded-lg flex items-center justify-center border border-slate-700\">\n              <Building size={20} className=\"text-slate-300\" />\n            </div>\n            <div>\n              <h2 className=\"text-2xl font-bold\">Government Portal</h2>\n              <p className=\"text-sm text-slate-400\">Secure staff login</p>\n            </div>\n          </div>\n          \n          <div className=\"bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-2xl space-y-4\">\n            <div>\n              <label className=\"block text-sm font-medium text-slate-400 mb-1\">Official Email / Employee ID</label>\n              <input \n                type=\"text\" \n                className=\"w-full bg-slate-900 border border-slate-700 rounded-lg p-3 text-white focus:border-blue-500 outline-none\"\n                placeholder=\"ID or Email\"\n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n              />\n            </div>\n            <div>\n              <label className=\"block text-sm font-medium text-slate-400 mb-1\">Password</label>\n              <input \n                type=\"password\" \n                className=\"w-full bg-slate-900 border border-slate-700 rounded-lg p-3 text-white focus:border-blue-500 outline-none\"\n                placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                value={password}\n                onChange={(e) => setPassword(e.target.value)}\n              />\n            </div>\n            <div>\n              <label className=\"block text-sm font-medium text-slate-400 mb-1\">Role (Demo selection)</label>\n              <select \n                className=\"w-full bg-slate-900 border border-slate-700 rounded-lg p-3 text-white focus:border-blue-500 outline-none\"\n                value={role}\n                onChange={(e) => setRole(e.target.value)}\n              >\n                <option>Municipal Administrator</option>\n                <option>Department Supervisor</option>\n                <option>Department Officer</option>\n                <option>Field Staff</option>\n                <option>Analyst</option>\n              </select>\n            </div>\n            \n            <button \n              onClick={handleGovLogin}\n              className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg mt-4 hover:bg-blue-500 transition-colors\"\n            >\n              Secure Login\n            </button>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  // CITIZEN AUTH FLOW\n  return (\n    <div className=\"flex flex-col items-center justify-center min-h-screen bg-slate-50 p-6\">\n      <div className=\"w-full max-w-md\">\n        <button onClick={() => { setView(\'WELCOME\'); setAuthState(\'NOT_AUTHENTICATED\'); }} className=\"text-slate-500 mb-8 hover:text-slate-900 font-bold flex items-center gap-2\">\n          &larr; Back\n        </button>\n\n        {authState === \'NOT_AUTHENTICATED\' && (\n          <div className=\"animate-in fade-in slide-in-from-bottom-4 duration-300\">\n            <h2 className=\"text-3xl font-bold text-slate-900 mb-2\">Create your CivicPulse Account</h2>\n            <p className=\"text-slate-500 mb-8 font-medium\">Your account helps us prevent duplicate and fraudulent reports and lets you track issues from report to resolution.</p>\n            \n            <div className=\"bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-4\">\n              <div>\n                <label className=\"block text-sm font-bold text-slate-700 mb-2\">Mobile Number</label>\n                <div className=\"flex gap-2\">\n                  <div className=\"bg-slate-100 border border-slate-200 rounded-xl px-4 py-4 font-bold text-slate-600 flex items-center justify-center\">\n                    +91\n                  </div>\n                  <input \n                    type=\"tel\" \n                    className=\"flex-1 border-2 border-slate-200 rounded-xl p-4 text-lg font-bold focus:border-blue-500 outline-none\"\n                    placeholder=\"Mobile Number\"\n                    value={phone}\n                    onChange={(e) => setPhone(e.target.value)}\n                  />\n                </div>\n              </div>\n              <button \n                onClick={handleCitizenMobileSubmit}\n                className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg active:scale-95 transition-transform\"\n              >\n                Continue\n              </button>\n            </div>\n          </div>\n        )}\n\n        {authState === \'MOBILE_VERIFIED\' && (\n          <div className=\"animate-in fade-in slide-in-from-right-4 duration-300\">\n            <h2 className=\"text-3xl font-bold text-slate-900 mb-2\">OTP Verification</h2>\n            <p className=\"text-slate-500 mb-8 font-medium\">OTP sent to your registered mobile number.</p>\n            \n            <div className=\"bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-6\">\n              <div>\n                <input \n                  type=\"text\" \n                  className=\"w-full border-2 border-slate-200 rounded-xl p-4 text-center tracking-[1em] text-2xl font-bold focus:border-blue-500 outline-none\"\n                  placeholder=\"------\"\n                  maxLength={6}\n                  value={otp}\n                  onChange={(e) => setOtp(e.target.value)}\n                />\n              </div>\n              <button \n                onClick={handleCitizenOtpSubmit}\n                className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg active:scale-95 transition-transform\"\n              >\n                Verify Mobile\n              </button>\n            </div>\n          </div>\n        )}\n\n        {authState === \'IDENTITY_VERIFICATION_PENDING\' && (\n          <div className=\"animate-in fade-in slide-in-from-right-4 duration-300\">\n            <h2 className=\"text-3xl font-bold text-slate-900 mb-2\">Verify your identity</h2>\n            <p className=\"text-slate-500 mb-6 font-medium\">Use Aadhaar-based identity verification to create your CivicPulse account.</p>\n            \n            <div className=\"bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm\">\n              <div className=\"bg-amber-50 border-b border-amber-100 px-4 py-3 flex items-center gap-2 text-amber-800\">\n                <ShieldCheck size={18} />\n                <span className=\"text-xs font-bold uppercase tracking-wider\">Aadhaar Verification \342\200\224 Demo</span>\n              </div>\n              <div className=\"p-6 space-y-4\">\n                <div>\n                  <label className=\"block text-sm font-bold text-slate-700 mb-2\">Masked Aadhaar</label>\n                  <input \n                    type=\"text\" \n                    className=\"w-full border-2 border-slate-200 rounded-xl p-4 text-lg font-bold outline-none bg-slate-50\"\n                    placeholder=\"XXXX XXXX 1234\"\n                    value={aadhaar}\n                    onChange={(e) => setAadhaar(e.target.value)}\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-sm font-bold text-slate-700 mb-2\">6-digit OTP</label>\n                  <input \n                    type=\"text\" \n                    className=\"w-full border-2 border-slate-200 rounded-xl p-4 text-center tracking-[1em] text-2xl font-bold focus:border-blue-500 outline-none\"\n                    placeholder=\"------\"\n                    maxLength={6}\n                    value={aadhaarOtp}\n                    onChange={(e) => setAadhaarOtp(e.target.value)}\n                  />\n                </div>\n                <button \n                  onClick={handleAadhaarSubmit}\n                  className=\"w-full bg-slate-900 text-white py-4 rounded-xl font-bold text-lg active:scale-95 transition-transform mt-2\"\n                >\n                  Verify Identity\n                </button>\n              </div>\n            </div>\n            <p className=\"text-xs text-slate-400 mt-6 text-center px-4\">\n              Your Aadhaar number is not displayed publicly. The prototype stores only a verified-account state and non-sensitive profile information.\n            </p>\n          </div>\n        )}\n\n        {authState === \'IDENTITY_VERIFIED\' && (\n          <div className=\"animate-in fade-in zoom-in-95 duration-500 flex flex-col items-center justify-center text-center py-12\">\n            <div className=\"w-24 h-24 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mb-6 shadow-sm border-4 border-white\">\n              <CheckCircle size={48} />\n            </div>\n            <h2 className=\"text-3xl font-bold text-slate-900 mb-2\">Identity Verified</h2>\n            <p className=\"text-slate-500 mb-8 font-medium\">Your CivicPulse account is now verified.</p>\n            \n            <div className=\"bg-white rounded-2xl p-6 border border-slate-200 shadow-sm w-full text-left mb-8\">\n              <div className=\"flex items-center gap-4 mb-4\">\n                <div className=\"w-16 h-16 bg-blue-100 text-blue-700 rounded-full flex items-center justify-center text-2xl font-bold\">\n                  AK\n                </div>\n                <div>\n                  <h3 className=\"text-xl font-bold text-slate-900\">Arun Kumar</h3>\n                  <div className=\"flex items-center gap-1 text-emerald-600 text-xs font-bold mt-1 bg-emerald-50 px-2 py-1 rounded w-fit\">\n                    <ShieldCheck size={12} /> Aadhaar Verified Citizen\n                  </div>\n                </div>\n              </div>\n              <div className=\"space-y-2 text-sm\">\n                <div className=\"flex justify-between border-b border-slate-100 pb-2\">\n                  <span className=\"text-slate-500\">Phone</span>\n                  <span className=\"font-bold text-slate-900\">{phone || \'+91 98765 43210\'}</span>\n                </div>\n                <div className=\"flex justify-between border-b border-slate-100 py-2\">\n                  <span className=\"text-slate-500\">Location</span>\n                  <span className=\"font-bold text-slate-900\">Ward 37</span>\n                </div>\n                <div className=\"flex justify-between pt-2\">\n                  <span className=\"text-slate-500\">Preferred Language</span>\n                  <span className=\"font-bold text-slate-900\">English</span>\n                </div>\n              </div>\n            </div>\n\n            <p className=\"text-lg font-bold text-slate-800 mb-6\">Account created successfully.</p>\n            \n            <button \n              onClick={finishCitizenOnboarding}\n              className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg shadow-xl active:scale-95 transition-transform\"\n            >\n              Continue to CivicPulse\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
