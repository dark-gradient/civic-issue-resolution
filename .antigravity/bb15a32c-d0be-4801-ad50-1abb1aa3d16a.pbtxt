    combined_output {
      full: "import React, { useMemo } from \'react\';import { MapPin } from \'lucide-react\';import { useApp } from \'../../context/AppContext\';export const GovLiveMap: React.FC = () => {  const { issues } = useApp();  // Simple normalization of lat/lng to percentage bounds  const markers = useMemo(() => {    if (issues.length === 0) return [];        const minLat = Math.min(...issues.map(i => i.lat));    const maxLat = Math.max(...issues.map(i => i.lat));    const minLng = Math.min(...issues.map(i => i.lng));    const maxLng = Math.max(...issues.map(i => i.lng));        // Add some padding to bounds so pins don\'t hit edges    const latRange = (maxLat - minLat) || 0.1;    const lngRange = (maxLng - minLng) || 0.1;    return issues.map(issue => {      // Invert lat for Y axis (larger lat is North/up, meaning smaller top percentage)      const top = 10 + ((maxLat - issue.lat) / latRange) * 80;      const left = 10 + ((issue.lng - minLng) / lngRange) * 80;            let color = \'bg-blue-500\';      if (issue.priority === \'Critical\') color = \'bg-red-600\';      else if (issue.priority === \'High\') color = \'bg-amber-500\';      else if (issue.priority === \'Medium\') color = \'bg-blue-500\';      else color = \'bg-slate-400\';      return { ...issue, top, left, color };    });  }, [issues]);  return (    <div className=\"h-[calc(100vh-80px)] bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col animate-in fade-in duration-300 relative\">      <div className=\"absolute top-4 left-4 z-10 bg-white rounded-xl shadow-lg border border-slate-200 p-4 w-72\">        <h3 className=\"font-bold text-slate-900 mb-3 tracking-tight\">Map Controls</h3>        <div className=\"space-y-4\">          <div>            <label className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Issue Type</label>            <select className=\"w-full mt-1.5 border border-slate-200 rounded-lg p-2 text-sm bg-slate-50 text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all\">              <option>All Types</option>              <option>Potholes</option>              <option>Garbage</option>            </select>          </div>          <div>            <label className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Priority</label>            <select className=\"w-full mt-1.5 border border-slate-200 rounded-lg p-2 text-sm bg-slate-50 text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all\">              <option>All Priorities</option>              <option>Critical Only</option>            </select>          </div>        </div>      </div>      <div className=\"flex-1 bg-slate-50 relative overflow-hidden\">         <div className=\"absolute inset-0 opacity-40\" style={{ backgroundImage: \'radial-gradient(#94a3b8 2px, transparent 2px)\', backgroundSize: \'30px 30px\' }}></div>                  {markers.map(m => (           <div key={m.id} className=\"absolute\" style={{ top: `${m.top}%`, left: `${m.left}%` }}>             <div className=\"relative flex items-center justify-center cursor-pointer group\">               {m.priority === \'Critical\' && (                 <div className=\"w-8 h-8 bg-red-500/20 rounded-full animate-pulse absolute\"></div>               )}               <div className={`w-5 h-5 ${m.color} rounded-full border-2 border-white relative z-10 shadow-lg`}></div>               <div className=\"absolute top-full mt-2 bg-white px-3 py-1.5 rounded-lg shadow-lg border border-slate-200 text-xs font-bold text-slate-700 whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity z-20 pointer-events-none\">                 <span className={m.priority === \'Critical\' ? \'text-red-600\' : m.priority === \'High\' ? \'text-amber-600\' : \'text-blue-600\'}>                   {m.id} - {m.priority}                 </span><br/>                 {m.title}<br/>                 {m.city}, {m.ward}               </div>             </div>           </div>         ))}         <div className=\"absolute inset-0 flex items-center justify-center pointer-events-none opacity-20\">           <div className=\"text-center\">             <MapPin size={48} className=\"text-slate-300 mx-auto mb-2\" />             <h2 className=\"text-2xl font-bold text-slate-400 tracking-tight\">Interactive GIS Map</h2>             <p className=\"text-slate-500 font-medium\">Live clustering and heatmaps enabled.</p>           </div>         </div>      </div>    </div>  );};"
    }
    command_line: "cat src/government/screens/LiveMap.tsx"
    proposed_command_line: "cat src/government/screens/LiveMap.tsx"
    shell_name: "bash"
  }
}
