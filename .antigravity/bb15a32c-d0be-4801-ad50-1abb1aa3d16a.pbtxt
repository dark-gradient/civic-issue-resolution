      target_content: "import React from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { AlertCircle, Clock, CheckCircle2, TrendingUp, MapPin, Download, ListTodo, AlertTriangle } from \'lucide-react\';\nimport { StatusBadge } from \'../../citizen/screens/MyReports\';\nimport { cn } from \'../../utils\';\n\nexport const GovOverview: React.FC<{ onNavigate: (s: any, id?: string) => void }> = ({ onNavigate }) => {\n  const { issues } = useApp();\n\n  // Mock stats mapping\n  const stats = [\n    { label: \'Active Issues\', value: issues.length, trend: \'+12% this week\', icon: ListTodo, color: \'text-blue-600\', bg: \'bg-blue-100\', trendColor: \'text-slate-500\' },\n    { label: \'Critical / Unassigned\', value: issues.filter(i => i.priority === \'Critical\' && i.assignee === \'Unassigned\').length, trend: \'Action Required\', icon: AlertCircle, color: \'text-red-600\', bg: \'bg-red-100\', trendColor: \'text-red-600 font-bold\' },\n    { label: \'Reopened by Citizen\', value: issues.filter(i => i.status === \'Reopened\').length, trend: \'Escalated\', icon: AlertTriangle, color: \'text-amber-600\', bg: \'bg-amber-100\', trendColor: \'text-amber-600 font-bold\' },\n    { label: \'SLA Breaching (<2h)\', value: issues.filter(i => i.slaRemaining.includes(\'1h\') || i.slaRemaining.startsWith(\'-\')).length, trend: \'Immediate\', icon: Clock, color: \'text-indigo-600\', bg: \'bg-indigo-100\', trendColor: \'text-indigo-600 font-bold\' },\n  ];\n\n  return (\n    <div className=\"max-w-6xl mx-auto w-full animate-in fade-in duration-300\">\n      \n      {/* Page Header */}\n      <div className=\"flex justify-between items-end mb-6\">\n        <div>\n          <h2 className=\"text-2xl font-bold text-slate-900 tracking-tight\">Command Center</h2>\n          <p className=\"text-sm text-slate-500 mt-1\">Real-time civic operations overview</p>\n        </div>\n        <div className=\"flex space-x-2\">\n          <button className=\"px-4 py-2 bg-white border border-slate-200 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50 transition-colors shadow-sm flex items-center space-x-2\">\n            <Download size={18} />\n            <span>Export Report</span>\n          </button>\n        </div>\n      </div>\n\n      {/* KPI Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6\">\n        {stats.map((stat, i) => (\n          <div key={i} className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between\">\n            <div className=\"flex justify-between items-start mb-2\">\n              <span className=\"text-sm font-semibold text-slate-500 uppercase tracking-wider\">{stat.label}</span>\n              <div className={cn(\"p-1 rounded-md shrink-0\", stat.bg, stat.color)}>\n                <stat.icon size={20} />\n              </div>\n            </div>\n            <div className=\"flex items-baseline space-x-2 mt-2\">\n              <span className=\"text-3xl font-bold text-slate-900\">{stat.value}</span>\n              <span className={cn(\"text-xs px-1.5 py-0.5 rounded\", stat.trendColor)}>\n                {stat.trend}\n              </span>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        \n        {/* Left: Priority Queue */}\n        <div className=\"lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col overflow-hidden\">\n          <div className=\"px-5 py-4 border-b border-slate-100 flex justify-between items-center bg-white\">\n            <h3 className=\"font-bold text-slate-800 text-base\">Priority Action Queue</h3>\n            <button onClick={() => onNavigate(\'queue\')} className=\"text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline\">View All</button>\n          </div>\n          \n          <div className=\"overflow-x-auto flex-1\">\n            <table className=\"w-full text-sm text-left\">\n              <thead className=\"text-xs text-slate-500 bg-slate-50/50 uppercase tracking-wider\">\n                <tr>\n                  <th className=\"px-5 py-3 font-semibold\">Priority</th>\n                  <th className=\"px-5 py-3 font-semibold\">Issue Details</th>\n                  <th className=\"px-5 py-3 font-semibold\">Location</th>\n                  <th className=\"px-5 py-3 font-semibold\">Assignee</th>\n                  <th className=\"px-5 py-3 font-semibold text-right\">Action</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100\">\n                {issues.slice(0, 5).map(issue => (\n                  <tr key={issue.id} className=\"hover:bg-slate-50 transition-colors\">\n                    <td className=\"px-5 py-3\">\n                      <span className={cn(\n                        \"text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded\",\n                        issue.priority === \'Critical\' ? \"bg-red-100 text-red-700\" :\n                        issue.priority === \'High\' ? \"bg-amber-100 text-amber-700\" :\n                        \"bg-slate-100 text-slate-700\"\n                      )}>\n                        {issue.priority}\n                      </span>\n                    </td>\n                    <td className=\"px-5 py-3\">\n                      <div className=\"font-bold text-slate-900\">{issue.id}</div>\n                      <div className=\"text-xs text-slate-500\">{issue.type} ({issue.reportsCount} reps)</div>\n                    </td>\n                    <td className=\"px-5 py-3\">\n                      <div className=\"text-slate-900 font-medium\">{issue.ward}</div>\n                      <div className=\"text-xs text-slate-500 truncate max-w-[120px]\">{issue.location}</div>\n                    </td>\n                    <td className=\"px-5 py-3\">\n                      <div className=\"text-slate-900 font-medium\">{issue.department}</div>\n                      <div className=\"text-xs text-slate-500\">{issue.assignee}</div>\n                    </td>\n                    <td className=\"px-5 py-3 text-right\">\n                      <button \n                        onClick={() => onNavigate(\'issue_detail\', issue.id)}\n                        className=\"text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 px-3 py-1.5 rounded-lg shadow-sm transition-colors\"\n                      >\n                        Manage\n                      </button>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        {/* Right: Department Workload Widget */}\n        <div className=\"lg:col-span-1 bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col overflow-hidden\">\n          <div className=\"px-5 py-4 border-b border-slate-100 flex justify-between items-center bg-white\">\n            <h3 className=\"font-bold text-slate-800 text-base\">Department Workload</h3>\n            <button onClick={() => onNavigate(\'departments\')} className=\"text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline\">View All</button>\n          </div>\n          <div className=\"flex-1 p-5 space-y-5 overflow-y-auto\">\n            \n            {/* Roads */}\n            <div>\n              <div className=\"flex justify-between items-end mb-1\">\n                <span className=\"font-bold text-slate-700 text-sm\">Roads</span>\n                <span className=\"text-xs font-bold text-red-600\">84% Capacity</span>\n              </div>\n              <div className=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                <div className=\"bg-red-500 h-2 rounded-full\" style={{ width: \'84%\' }}></div>\n              </div>\n              <div className=\"flex justify-between text-[10px] text-slate-500 mt-1\">\n                <span>{issues.filter(i => i.department === \'Roads\').length} Open Issues</span>\n                <span>3 SLA Alerts</span>\n              </div>\n            </div>\n\n            {/* Sanitation */}\n            <div>\n              <div className=\"flex justify-between items-end mb-1\">\n                <span className=\"font-bold text-slate-700 text-sm\">Sanitation</span>\n                <span className=\"text-xs font-bold text-amber-600\">62% Capacity</span>\n              </div>\n              <div className=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                <div className=\"bg-amber-500 h-2 rounded-full\" style={{ width: \'62%\' }}></div>\n              </div>\n              <div className=\"flex justify-between text-[10px] text-slate-500 mt-1\">\n                <span>{issues.filter(i => i.department === \'Sanitation\').length} Open Issues</span>\n                <span>1 SLA Alert</span>\n              </div>\n            </div>\n\n            {/* Electrical */}\n            <div>\n              <div className=\"flex justify-between items-end mb-1\">\n                <span className=\"font-bold text-slate-700 text-sm\">Electrical</span>\n                <span className=\"text-xs font-bold text-emerald-600\">35% Capacity</span>\n              </div>\n              <div className=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                <div className=\"bg-emerald-500 h-2 rounded-full\" style={{ width: \'35%\' }}></div>\n              </div>\n              <div className=\"flex justify-between text-[10px] text-slate-500 mt-1\">\n                <span>{issues.filter(i => i.department === \'Electrical\').length} Open Issues</span>\n                <span>0 SLA Alerts</span>\n              </div>\n            </div>\n            \n            {/* Water */}\n            <div>\n              <div className=\"flex justify-between items-end mb-1\">\n                <span className=\"font-bold text-slate-700 text-sm\">Water</span>\n                <span className=\"text-xs font-bold text-emerald-600\">41% Capacity</span>\n              </div>\n              <div className=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                <div className=\"bg-emerald-500 h-2 rounded-full\" style={{ width: \'41%\' }}></div>\n              </div>\n              <div className=\"flex justify-between text-[10px] text-slate-500 mt-1\">\n                <span>{issues.filter(i => i.department === \'Water\').length} Open Issues</span>\n                <span>0 SLA Alerts</span>\n              </div>\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { AlertCircle, Clock, CheckCircle2, TrendingUp, MapPin, Download, ListTodo, AlertTriangle } from \'lucide-react\';\nimport { StatusBadge } from \'../../citizen/screens/MyReports\';\nimport { cn } from \'../../utils\';\n\nexport const GovOverview: React.FC<{ onNavigate: (s: any, id?: string) => void }> = ({ onNavigate }) => {\n  const { issues } = useApp();\n\n  const activeIssues = issues.filter(i => ![\'Resolved\', \'Closed\'].includes(i.status));\n  const unassignedCritical = activeIssues.filter(i => i.priority === \'Critical\' && i.assignee === \'Unassigned\');\n  const reopenedIssues = issues.filter(i => i.status === \'Reopened\');\n  const slaBreached = issues.filter(i => i.slaRemaining.startsWith(\'-\') || i.slaRemaining === \'0h\');\n\n  // Mock stats mapping\n  const stats = [\n    { label: \'Active Issues\', value: activeIssues.length, trend: \'+12% this week\', icon: ListTodo, color: \'text-blue-600\', bg: \'bg-blue-100\', trendColor: \'text-slate-500\' },\n    { label: \'Critical / Unassigned\', value: unassignedCritical.length, trend: \'Action Required\', icon: AlertCircle, color: \'text-red-600\', bg: \'bg-red-100\', trendColor: \'text-red-600 font-bold\' },\n    { label: \'Reopened by Citizen\', value: reopenedIssues.length, trend: \'Escalated\', icon: AlertTriangle, color: \'text-amber-600\', bg: \'bg-amber-100\', trendColor: \'text-amber-600 font-bold\' },\n    { label: \'SLA Breaching\', value: slaBreached.length, trend: \'Immediate\', icon: Clock, color: \'text-indigo-600\', bg: \'bg-indigo-100\', trendColor: \'text-indigo-600 font-bold\' },\n  ];\n\n  return (\n    <div className=\"max-w-6xl mx-auto w-full animate-in fade-in duration-300\">\n      \n      {/* Page Header */}\n      <div className=\"flex justify-between items-end mb-6\">\n        <div>\n          <h2 className=\"text-2xl font-bold text-slate-900 tracking-tight\">Command Center</h2>\n          <p className=\"text-sm text-slate-500 mt-1\">Real-time civic operations overview</p>\n        </div>\n        <div className=\"flex space-x-2\">\n          <button className=\"px-4 py-2 bg-white border border-slate-200 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50 transition-colors shadow-sm flex items-center space-x-2\">\n            <Download size={18} />\n            <span>Export Report</span>\n          </button>\n        </div>\n      </div>\n\n      {/* KPI Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6\">\n        {stats.map((stat, i) => (\n          <div key={i} className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between\">\n            <div className=\"flex justify-between items-start mb-2\">\n              <span className=\"text-sm font-semibold text-slate-500 uppercase tracking-wider\">{stat.label}</span>\n              <div className={cn(\"p-1 rounded-md shrink-0\", stat.bg, stat.color)}>\n                <stat.icon size={20} />\n              </div>\n            </div>\n            <div className=\"flex items-baseline space-x-2 mt-2\">\n              <span className=\"text-3xl font-bold text-slate-900\">{stat.value}</span>\n              <span className={cn(\"text-xs px-1.5 py-0.5 rounded\", stat.trendColor)}>\n                {stat.trend}\n              </span>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        \n        {/* Left: Priority Queue */}\n        <div className=\"lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col overflow-hidden\">\n          <div className=\"px-5 py-4 border-b border-slate-100 flex justify-between items-center bg-white\">\n            <h3 className=\"font-bold text-slate-800 text-base\">Priority Action Queue</h3>\n            <button onClick={() => onNavigate(\'queue\')} className=\"text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline\">View All</button>\n          </div>\n          \n          <div className=\"overflow-x-auto flex-1\">\n            <table className=\"w-full text-sm text-left\">\n              <thead className=\"text-xs text-slate-500 bg-slate-50/50 uppercase tracking-wider\">\n                <tr>\n                  <th className=\"px-5 py-3 font-semibold\">Priority</th>\n                  <th className=\"px-5 py-3 font-semibold\">Issue Details</th>\n                  <th className=\"px-5 py-3 font-semibold\">Location</th>\n                  <th className=\"px-5 py-3 font-semibold\">Assignee</th>\n                  <th className=\"px-5 py-3 font-semibold text-right\">Action</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100\">\n                {activeIssues.slice(0, 5).map(issue => (\n                  <tr key={issue.id} className=\"hover:bg-slate-50 transition-colors\">\n                    <td className=\"px-5 py-3\">\n                      <span className={cn(\n                        \"text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded\",\n                        issue.priority === \'Critical\' ? \"bg-red-100 text-red-700\" :\n                        issue.priority === \'High\' ? \"bg-amber-100 text-amber-700\" :\n                        \"bg-slate-100 text-slate-700\"\n                      )}>\n                        {issue.priority}\n                      </span>\n                    </td>\n                    <td className=\"px-5 py-3\">\n                      <div className=\"font-bold text-slate-900\">{issue.id}</div>\n                      <div className=\"text-xs text-slate-500\">{issue.type} ({issue.reportsCount} reps)</div>\n                    </td>\n                    <td className=\"px-5 py-3\">\n                      <div className=\"text-slate-900 font-medium\">{issue.ward}</div>\n                      <div className=\"text-xs text-slate-500 truncate max-w-[120px]\">{issue.location}</div>\n                    </td>\n                    <td className=\"px-5 py-3\">\n                      <div className=\"text-slate-900 font-medium\">{issue.department}</div>\n                      <div className=\"text-xs text-slate-500\">{issue.assignee}</div>\n                    </td>\n                    <td className=\"px-5 py-3 text-right\">\n                      <button \n                        onClick={() => onNavigate(\'issue_detail\', issue.id)}\n                        className=\"text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 px-3 py-1.5 rounded-lg shadow-sm transition-colors\"\n                      >\n                        Manage\n                      </button>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        {/* Right: Department Workload Widget */}\n        <div className=\"lg:col-span-1 bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col overflow-hidden\">\n          <div className=\"px-5 py-4 border-b border-slate-100 flex justify-between items-center bg-white\">\n            <h3 className=\"font-bold text-slate-800 text-base\">Department Workload</h3>\n            <button onClick={() => onNavigate(\'departments\')} className=\"text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline\">View All</button>\n          </div>\n          <div className=\"flex-1 p-5 space-y-5 overflow-y-auto\">\n            \n            {/* Roads */}\n            <div>\n              <div className=\"flex justify-between items-end mb-1\">\n                <span className=\"font-bold text-slate-700 text-sm\">Roads</span>\n                <span className=\"text-xs font-bold text-red-600\">84% Capacity</span>\n              </div>\n              <div className=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                <div className=\"bg-red-500 h-2 rounded-full\" style={{ width: \'84%\' }}></div>\n              </div>\n              <div className=\"flex justify-between text-[10px] text-slate-500 mt-1\">\n                <span>{activeIssues.filter(i => i.department === \'Roads\').length} Open Issues</span>\n                <span>{slaBreached.filter(i => i.department === \'Roads\').length} SLA Alerts</span>\n              </div>\n            </div>\n\n            {/* Sanitation */}\n            <div>\n              <div className=\"flex justify-between items-end mb-1\">\n                <span className=\"font-bold text-slate-700 text-sm\">Sanitation</span>\n                <span className=\"text-xs font-bold text-amber-600\">62% Capacity</span>\n              </div>\n              <div className=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                <div className=\"bg-amber-500 h-2 rounded-full\" style={{ width: \'62%\' }}></div>\n              </div>\n              <div className=\"flex justify-between text-[10px] text-slate-500 mt-1\">\n                <span>{activeIssues.filter(i => i.department === \'Sanitation\').length} Open Issues</span>\n                <span>{slaBreached.filter(i => i.department === \'Sanitation\').length} SLA Alerts</span>\n              </div>\n            </div>\n\n            {/* Electrical */}\n            <div>\n              <div className=\"flex justify-between items-end mb-1\">\n                <span className=\"font-bold text-slate-700 text-sm\">Electrical</span>\n                <span className=\"text-xs font-bold text-emerald-600\">35% Capacity</span>\n              </div>\n              <div className=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                <div className=\"bg-emerald-500 h-2 rounded-full\" style={{ width: \'35%\' }}></div>\n              </div>\n              <div className=\"flex justify-between text-[10px] text-slate-500 mt-1\">\n                <span>{activeIssues.filter(i => i.department === \'Electrical\').length} Open Issues</span>\n                <span>{slaBreached.filter(i => i.department === \'Electrical\').length} SLA Alerts</span>\n              </div>\n            </div>\n            \n            {/* Water */}\n            <div>\n              <div className=\"flex justify-between items-end mb-1\">\n                <span className=\"font-bold text-slate-700 text-sm\">Water</span>\n                <span className=\"text-xs font-bold text-emerald-600\">41% Capacity</span>\n              </div>\n              <div className=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                <div className=\"bg-emerald-500 h-2 rounded-full\" style={{ width: \'41%\' }}></div>\n              </div>\n              <div className=\"flex justify-between text-[10px] text-slate-500 mt-1\">\n                <span>{activeIssues.filter(i => i.department === \'Water\').length} Open Issues</span>\n                <span>{slaBreached.filter(i => i.department === \'Water\').length} SLA Alerts</span>\n              </div>\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n};"
