e=\"px-4 py-2 bg-white border border-slate-200 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50 transition-colors shadow-sm flex items-center space-x-2\">`);\n\nfs.writeFileSync(\'src/government/screens/Overview.tsx\', code);\nEOF\nnode implement_export.cjs"
