    replacement_infos {
      original_chunk {
        target_content: "        {/* STEP 1: Capture */}\n        {step === 1 && (\n          <div className=\"animate-in fade-in slide-in-from-right-4 duration-300\">\n            <h2 className=\"text-3xl font-bold mb-2 text-slate-900 tracking-tight\">What needs fixing?</h2>\n            <p className=\"text-slate-500 mb-8 font-medium\">Take a clear photo of the problem.</p>\n            \n            {image ? (\n              <div className=\"mb-8\">\n                <div className=\"relative rounded-2xl overflow-hidden border-4 border-white shadow-md\">\n                  <img src={image} alt=\"Captured\" className=\"w-full h-64 object-cover\" />\n                  \n                  {/* Simulated Face Blur Box */}\n                  {privacyProtected && (\n                    <div className=\"absolute top-1/4 right-1/4 w-16 h-16 backdrop-blur-xl bg-white/10 rounded-full border border-white/20 shadow-sm\" />\n                  )}\n\n                  <button onClick={() => { setImage(null); setPrivacyProtected(false); }} className=\"absolute top-2 right-2 bg-slate-900/60 text-white p-2 rounded-full backdrop-blur-sm\">\n                    <Edit2 size={16} />\n                  </button>\n                </div>\n                \n                {privacyProtected && (\n                  <div className=\"mt-3\">\n                    <div className=\"flex items-center justify-between\">\n                      <div className=\"flex items-center gap-1.5 text-xs font-bold text-emerald-600 bg-emerald-50 px-3 py-1.5 rounded-lg border border-emerald-100\">\n                        <ShieldCheck size={14} /> Faces automatically blurred\n                      </div>\n                      <button onClick={() => setShowPrivacyInfo(!showPrivacyInfo)} className=\"text-slate-400 hover:text-slate-600\">\n                        <Info size={16} />\n                      </button>\n                    </div>\n                    {showPrivacyInfo && (\n                      <div className=\"mt-2 p-3 bg-slate-100 rounded-lg text-xs text-slate-600 border border-slate-200\">\n                        Personal faces detected in uploaded images are automatically blurred before the image is shared with municipal authorities. Citizen privacy protected automatically.\n                      </div>\n                    )}\n                  </div>\n                )}\n              </div>\n            ) : isProcessingPrivacy ? (\n              <div className=\"bg-slate-100 rounded-3xl h-64 flex flex-col items-center justify-center text-slate-400 border-2 border-dashed border-slate-300 mb-8\">\n                <ShieldCheck size={48} className=\"mb-4 text-blue-500 animate-pulse\" />\n                <p className=\"font-bold text-slate-700 text-lg\">Protecting privacy...</p>\n                <p className=\"text-sm text-slate-500 mt-1\">Detecting faces</p>\n              </div>\n            ) : (\n              <div className=\"bg-slate-100 rounded-3xl h-64 flex flex-col items-center justify-center text-slate-400 border-2 border-dashed border-slate-300 mb-8\">\n                <Camera size={64} className=\"mb-4 opacity-30 text-slate-400\" />\n                <p className=\"font-bold text-slate-500 text-lg\">No photo yet</p>\n              </div>\n            )}\n            \n            <div className=\"space-y-4\">\n              <button \n                onClick={handleCapture}\n                className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-3 shadow-xl shadow-blue-900/20 active:scale-95 transition-transform\"\n              >\n                <Camera size={24} /> Take Photo\n              </button>\n              <button \n                onClick={handleCapture}\n                className=\"w-full bg-white border-2 border-slate-200 text-slate-700 py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-3 active:bg-slate-50 transition-colors shadow-sm\"\n              >\n                <Upload size={24} /> Choose from Gallery\n              </button>\n            </div>\n          </div>\n        )}"
        replacement_content: "        {/* STEP 1: Capture */}\n        {step === 1 && (\n          <div className=\"animate-in fade-in slide-in-from-right-4 duration-300\">\n            <h2 className=\"text-3xl font-bold mb-2 text-slate-900 tracking-tight\">See a problem?</h2>\n            <p className=\"text-slate-500 mb-8 font-medium\">Take a photo of it.</p>\n            \n            {image ? (\n              <div className=\"mb-8\">\n                <div className=\"relative rounded-2xl overflow-hidden border-4 border-white shadow-md\">\n                  <img src={image} alt=\"Captured\" className=\"w-full h-64 object-cover\" />\n                  \n                  {/* Simulated Face Blur Box */}\n                  {privacyProtected && (\n                    <div className=\"absolute top-1/4 right-1/4 w-16 h-16 backdrop-blur-xl bg-white/10 rounded-full border border-white/20 shadow-sm\" />\n                  )}\n\n                  <button onClick={() => { setImage(null); setPrivacyProtected(false); }} className=\"absolute top-2 right-2 bg-slate-900/60 text-white p-2 rounded-full backdrop-blur-sm\">\n                    <Edit2 size={16} />\n                  </button>\n                </div>\n                \n                {privacyProtected && (\n                  <div className=\"mt-3\">\n                    <div className=\"flex items-center justify-center gap-1.5 text-xs font-bold text-emerald-600 bg-emerald-50 px-3 py-2 rounded-lg border border-emerald-100 w-full\">\n                      <ShieldCheck size={16} /> People\'s faces are protected\n                    </div>\n                  </div>\n                )}\n              </div>\n            ) : isProcessingPrivacy ? (\n              <div className=\"bg-slate-100 rounded-3xl h-64 flex flex-col items-center justify-center text-slate-400 border-2 border-dashed border-slate-300 mb-8\">\n                <ShieldCheck size={48} className=\"mb-4 text-blue-500 animate-pulse\" />\n                <p className=\"font-bold text-slate-700 text-lg\">Protecting privacy...</p>\n                <p className=\"text-sm text-slate-500 mt-1\">Detecting faces</p>\n              </div>\n            ) : (\n              <div className=\"bg-slate-100 rounded-3xl h-64 flex flex-col items-center justify-center text-slate-400 border-2 border-dashed border-slate-300 mb-8\">\n                <Camera size={64} className=\"mb-4 opacity-30 text-slate-400\" />\n                <p className=\"font-bold text-slate-500 text-lg\">No photo yet</p>\n              </div>\n            )}\n            \n            <div className=\"space-y-4\">\n              {image ? (\n                <button \n                  onClick={() => setStep(2)}\n                  className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-3 shadow-xl shadow-blue-900/20 active:scale-95 transition-transform\"\n                >\n                  Continue\n                </button>\n              ) : (\n                <>\n                  <button \n                    onClick={handleCapture}\n                    className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-3 shadow-xl shadow-blue-900/20 active:scale-95 transition-transform\"\n                  >\n                    <Camera size={24} /> Take Photo\n                  </button>\n                  <button \n                    onClick={handleCapture}\n                    className=\"w-full bg-white border-2 border-slate-200 text-slate-700 py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-3 active:bg-slate-50 transition-colors shadow-sm\"\n                  >\n                    <Upload size={24} /> Choose from Gallery\n                  </button>\n                </>\n              )}\n            </div>\n          </div>\n        )}"
