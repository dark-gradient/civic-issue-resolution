      original_chunk {
        target_content: "        {/* STEP 2: Location */}\n        {step === 2 && (\n          <div className=\"animate-in fade-in slide-in-from-right-4 duration-300\">\n            <h2 className=\"text-3xl font-bold mb-2 text-slate-900 tracking-tight\">Where is it?</h2>\n            <p className=\"text-slate-500 mb-6 font-medium\">We found you using GPS.</p>\n            \n            <div className=\"bg-slate-100 rounded-2xl p-2 mb-6 border border-slate-200 relative overflow-hidden h-48 flex items-center justify-center shadow-inner\">\n              {/* Fake Map */}\n              <div className=\"absolute inset-0 bg-blue-50 grid\" style={{ backgroundImage: \'radial-gradient(#93c5fd 1px, transparent 1px)\', backgroundSize: \'20px 20px\' }}></div>\n              <div className=\"z-10 bg-white p-3 rounded-full shadow-lg text-blue-600 border border-slate-100\">\n                <MapPin size={32} className=\"animate-bounce\" />\n              </div>\n            </div>\n            \n            <div className=\"bg-emerald-50 border border-emerald-100 rounded-xl p-4 shadow-sm flex items-center gap-4\">\n              <div className=\"bg-emerald-500 text-white p-2 rounded-full shrink-0\">\n                <MapPin size={24} />\n              </div>\n              <div className=\"flex-1\">\n                <p className=\"text-xs text-emerald-700 font-bold uppercase tracking-wider mb-0.5\">Location Found</p>\n                <h3 className=\"font-bold text-emerald-900 text-lg tracking-tight\">{location}</h3>\n              </div>\n            </div>\n\n            <button \n              onClick={() => setStep(3)}\n              className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg mt-8 shadow-xl shadow-blue-900/20 active:scale-95 transition-transform\"\n            >\n              Yes, this is correct\n            </button>\n            <button className=\"w-full py-4 font-bold text-slate-500 mt-2\">\n              No, let me change it\n            </button>\n          </div>\n        )}\n\n        {/* STEP 3 & 4: Details & AI */}\n        {step === 3 && (\n          <div className=\"animate-in fade-in slide-in-from-right-4 duration-300\">\n            <h2 className=\"text-3xl font-bold mb-2 text-slate-900 tracking-tight\">Add Details</h2>\n            <p className=\"text-slate-500 mb-6 font-medium\">Type or speak to describe the issue.</p>\n            \n            <div className=\"relative\">\n              <textarea \n                value={description}\n                onChange={(e) => setDescription(e.target.value)}\n                className=\"w-full border-2 border-slate-200 bg-white rounded-xl p-5 text-lg focus:border-blue-500 outline-none text-slate-800 resize-none shadow-sm\"\n                rows={4}\n                placeholder=\"E.g., Huge pothole...\"\n              />\n              <button className=\"absolute bottom-4 right-4 bg-red-500 text-white p-3 rounded-full shadow-md active:scale-95 transition-transform\">\n                <Mic size={24} />\n              </button>\n            </div>\n            \n            <div className=\"flex gap-2 mt-4\">\n              <button className=\"flex-1 py-2 bg-blue-50 border-2 border-blue-200 rounded-lg text-sm font-bold text-blue-800\">English</button>\n              <button className=\"flex-1 py-2 bg-white border-2 border-slate-200 rounded-lg text-sm font-bold text-slate-500\">\340\256\244\340\256\256\340\256\277\340\256\264\340\257\215</button>\n              <button className=\"flex-1 py-2 bg-white border-2 border-slate-200 rounded-lg text-sm font-bold text-slate-500\">\340\244\271\340\244\277\340\244\250\340\245\215\340\244\246\340\245\200</button>\n            </div>\n\n            {/* Simple AI Assist Panel */}\n            <div className=\"mt-8 bg-blue-50 border border-blue-100 rounded-xl p-4 flex items-center gap-4 shadow-sm\">\n              <div className=\"w-12 h-12 bg-white rounded-full flex items-center justify-center shrink-0 border border-blue-100 shadow-sm text-2xl\">\n                 \342\234\250\n              </div>\n              <div className=\"flex-1\">\n                <p className=\"text-sm font-bold text-blue-900 tracking-tight\">AI sees a {category}</p>\n                <p className=\"text-xs text-blue-700 font-medium mt-0.5\">We will route this directly to the Roads team.</p>\n              </div>\n            </div>\n\n            <button \n              onClick={() => setStep(4)}\n              className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg mt-8 shadow-xl shadow-blue-900/20 flex justify-center items-center gap-2 active:scale-95 transition-transform\"\n            >\n              Continue\n            </button>\n          </div>\n        )}\n\n        {/* STEP 4: Duplicate Warning */}\n        {step === 4 && (\n          <div className=\"animate-in fade-in slide-in-from-right-4 duration-300\">\n            <h2 className=\"text-3xl font-bold mb-2 text-slate-900 tracking-tight\">Similar Issue Found</h2>\n            <p className=\"text-slate-500 mb-6 font-medium\">We found a nearby existing issue.</p>\n            \n            <div className=\"bg-amber-50 border-2 border-amber-200 rounded-2xl p-5 mb-8\">\n              <div className=\"flex items-center gap-3 mb-3\">\n                <AlertTriangle className=\"text-amber-600\" size={24} />\n                <h3 className=\"font-bold text-amber-900 text-lg\">CIV-10482</h3>\n              </div>\n              <p className=\"text-amber-800 font-medium mb-3\">43 citizens have already reported this problem.</p>\n              <div className=\"bg-white/60 p-3 rounded-lg border border-amber-200/50\">\n                <p className=\"font-bold text-slate-900\">{category}</p>\n                <p className=\"text-sm text-slate-600\">{location}</p>\n              </div>\n            </div>\n\n            <button \n              onClick={handleSubmit}\n              disabled={isSubmitting}\n              className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg shadow-xl shadow-blue-900/20 flex justify-center items-center gap-2 disabled:opacity-70 active:scale-95 transition-transform mb-4\"\n            >\n              {isSubmitting ? \'Sending...\' : \'Add My Report\'}\n            </button>\n            <button \n              onClick={handleSubmit}\n              disabled={isSubmitting}\n              className=\"w-full bg-white border-2 border-slate-200 text-slate-700 py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 disabled:opacity-70 active:scale-95 transition-transform\"\n            >\n              Report as Different Issue\n            </button>\n          </div>\n        )}"
        replacement_content: "        {/* STEP 2: Details & Location */}\n        {step === 2 && (\n          <div className=\"animate-in fade-in slide-in-from-right-4 duration-300\">\n            <div className=\"bg-slate-100 rounded-xl overflow-hidden mb-6 h-32 relative\">\n              <img src={image || \'\'} alt=\"Report\" className=\"w-full h-full object-cover opacity-60\" />\n            </div>\n\n            <h2 className=\"text-3xl font-bold mb-2 text-slate-900 tracking-tight\">What is the problem?</h2>\n            \n            <div className=\"relative mt-4 mb-6\">\n              <textarea \n                value={description}\n                onChange={(e) => setDescription(e.target.value)}\n                className=\"w-full border-2 border-slate-200 bg-white rounded-xl p-5 text-lg focus:border-blue-500 outline-none text-slate-800 resize-none shadow-sm\"\n                rows={4}\n                placeholder=\"Example: There is a big pothole here.\"\n              />\n              <button className=\"absolute bottom-4 right-4 bg-red-500 text-white px-4 py-2 rounded-full shadow-md active:scale-95 transition-transform flex items-center gap-2 font-bold\">\n                <Mic size={20} /> Speak instead\n              </button>\n            </div>\n            \n            <div className=\"bg-slate-100 border border-slate-200 rounded-xl p-4 shadow-sm flex items-center justify-between mb-8\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"bg-blue-500 text-white p-2 rounded-full shrink-0\">\n                  <MapPin size={20} />\n                </div>\n                <div>\n                  <p className=\"font-bold text-slate-900 tracking-tight\">\360\237\223\215 Location detected</p>\n                  <p className=\"text-xs text-slate-500\">Anna Nagar Main Road</p>\n                </div>\n              </div>\n              <button className=\"text-blue-600 text-sm font-bold underline\">Change</button>\n            </div>\n\n            <button \n              onClick={handleSubmit}\n              disabled={isSubmitting}\n              className=\"w-full bg-blue-600 text-white py-5 rounded-xl font-bold text-xl flex justify-center items-center gap-2 shadow-xl shadow-blue-900/20 active:scale-95 transition-transform disabled:opacity-70\"\n            >\n              {isSubmitting ? \'Sending...\' : \'Submit Report\'}\n            </button>\n          </div>\n        )}"
      }
      num_matches: 1
    }
    replacement_infos {
      original_chunk {
        target_content: "        {/* STEP 5: Success */}\n        {step === 5 && (\n          <div className=\"h-full flex flex-col items-center justify-center text-center animate-in zoom-in duration-500 pb-10\">\n            <div className=\"w-24 h-24 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mb-6 shadow-sm border-4 border-white\">\n              <CheckCircle size={48} />\n            </div>\n            <h2 className=\"text-3xl font-bold text-slate-900 mb-2 tracking-tight\">Thank You!</h2>\n            <div className=\"bg-slate-100 border border-slate-200 px-4 py-2 rounded-lg font-mono text-slate-700 font-bold tracking-widest mb-4 text-lg\">\n              {generatedId}\n            </div>\n            \n            {isOffline ? (\n              <div className=\"bg-amber-50 border border-amber-200 p-4 rounded-xl mb-8 w-full text-left flex items-start gap-3\">\n                <div className=\"mt-0.5\">\342\232\240\357\270\217</div>\n                <div>\n                  <p className=\"text-amber-800 font-bold text-lg mb-1\">Saved Offline</p>\n                  <p className=\"text-amber-700 text-sm\">We will send this automatically when you have internet.</p>\n                </div>\n              </div>\n            ) : (\n              <p className=\"text-slate-500 mb-8 max-w-[250px] text-lg font-medium\">\n                We have received your report and will notify you of updates.\n              </p>\n            )}\n\n            <button \n              onClick={onComplete}\n              className=\"w-full bg-slate-900 text-white py-4 rounded-xl font-bold text-lg shadow-lg active:scale-95 transition-transform mt-4\"\n            >\n              Go to Home\n            </button>\n          </div>\n        )}"
        replacement_content: "        {/* STEP 3: Success */}\n        {step === 3 && (\n          <div className=\"h-full flex flex-col items-center justify-center text-center animate-in zoom-in duration-500 pb-10\">\n            <div className=\"w-24 h-24 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mb-6 shadow-sm border-4 border-white\">\n              <CheckCircle size={48} />\n            </div>\n            <h2 className=\"text-3xl font-bold text-slate-900 mb-2 tracking-tight\">Report submitted</h2>\n            <div className=\"bg-slate-100 border border-slate-200 px-4 py-2 rounded-lg font-mono text-slate-700 font-bold tracking-widest mb-4 text-lg\">\n              {generatedId}\n            </div>\n            \n            {isOffline ? (\n              <div className=\"bg-amber-50 border border-amber-200 p-4 rounded-xl mb-8 w-full text-left flex items-start gap-3\">\n                <div className=\"mt-0.5\">\342\232\240\357\270\217</div>\n                <div>\n                  <p className=\"text-amber-800 font-bold text-lg mb-1\">Saved Offline</p>\n                  <p className=\"text-amber-700 text-sm\">It will be sent when internet returns.</p>\n                </div>\n              </div>\n            ) : (\n              <p className=\"text-slate-500 mb-8 max-w-[250px] text-lg font-medium\">\n                Thank you for reporting this civic issue.\n              </p>\n            )}\n\n            <button \n              onClick={onComplete}\n              className=\"w-full bg-slate-900 text-white py-4 rounded-xl font-bold text-lg shadow-lg active:scale-95 transition-transform mt-4\"\n            >\n              Track Report\n            </button>\n          </div>\n        )}"
      }
      num_matches: 1
    }
  }
}
