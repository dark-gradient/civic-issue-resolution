    generator_model: MODEL_GOOGLE_GEMINI_INTERNAL_BYOM
    execution_id: "bb15a32c-d0be-4801-ad50-1abb1aa3d16a"
    source_trajectory_step_info {
      trajectory_id: "bb15a32c-d0be-4801-ad50-1abb1aa3d16a"
      step_index: 32
      metadata_index: 6
      cascade_id: "bb15a32c-d0be-4801-ad50-1abb1aa3d16a"
