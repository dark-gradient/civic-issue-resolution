nces</label>                  <div className=\"flex items-center gap-3\">                    <input type=\"checkbox\" defaultChecked className=\"w-5 h-5 text-blue-600 rounded\" />                    <span className=\"text-slate-700\">Email alerts for Critical SLAs</span>                  </div>                </div>              </div>            </div>          )}        </div>      </main>    </div>  );};"
