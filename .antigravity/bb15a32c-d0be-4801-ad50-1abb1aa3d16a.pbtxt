    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { CitizenApp } from \'./citizen/CitizenApp\';\nimport { GovApp } from \'./government/GovApp\';\nimport { AppProvider } from \'./context/AppContext\';\n\nexport default function App() {\n  const [role, setRole] = useState<\'Citizen\' | \'Government\'>(\'Citizen\');\n\n  return (\n    <AppProvider>\n      <div className=\"flex flex-col h-screen w-full bg-slate-50 font-sans text-slate-900 overflow-hidden\">\n        <nav className=\"flex items-center justify-between px-6 py-3 bg-slate-900 text-white shadow-lg z-50 shrink-0\">\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center font-bold text-xl\">\n              C\n            </div>\n            <div className=\"flex flex-col leading-tight\">\n              <span className=\"font-bold text-lg tracking-tight uppercase\">CivicPulse</span>\n              <span className=\"text-[10px] text-slate-400 font-medium tracking-widest uppercase\">Report. Resolve. Verify.</span>\n            </div>\n          </div>\n          <div className=\"flex items-center bg-slate-800 rounded-full p-1 space-x-1\">\n            <button\n              onClick={() => setRole(\'Government\')}\n              className={`px-4 py-1.5 text-xs font-semibold rounded-full transition-colors ${role === \'Government\' ? \'bg-slate-700\' : \'hover:bg-slate-700\'}`}\n            >\n              GOVERNMENT PORTAL\n            </button>\n            <button\n              onClick={() => setRole(\'Citizen\')}\n              className={`px-4 py-1.5 text-xs font-semibold rounded-full transition-colors ${role === \'Citizen\' ? \'bg-blue-600\' : \'hover:bg-blue-500\'}`}\n            >\n              CITIZEN APP\n            </button>\n          </div>\n          <div className=\"flex items-center space-x-4\">\n            <div className=\"flex flex-col items-end\">\n              <span className=\"text-xs font-medium\">Chennai Municipal Corp.</span>\n              <span className=\"text-[10px] text-slate-400\">27 Aug 2026, 11:14 AM</span>\n            </div>\n            <div className=\"w-8 h-8 rounded-full bg-slate-700 border border-slate-600 flex items-center justify-center text-xs\">\n              AD\n            </div>\n          </div>\n        </nav>\n        {role === \'Citizen\' ? (\n          <CitizenApp onSwitchRole={() => setRole(\'Government\')} />\n        ) : (\n          <GovApp onSwitchRole={() => setRole(\'Citizen\')} />\n        )}\n      </div>\n    </AppProvider>\n  );\n}"
      replacement_content: "import React from \'react\';\nimport { CitizenApp } from \'./citizen/CitizenApp\';\nimport { GovApp } from \'./government/GovApp\';\nimport { AppProvider, useApp } from \'./context/AppContext\';\nimport { AuthFlow } from \'./auth/AuthFlow\';\n\nconst MainApp: React.FC = () => {\n  const { authState, user } = useApp();\n\n  if (authState !== \'AUTHENTICATED\' || !user) {\n    return <AuthFlow />;\n  }\n\n  return (\n    <div className=\"flex flex-col h-screen w-full bg-slate-50 font-sans text-slate-900 overflow-hidden\">\n      {user.type === \'Citizen\' ? (\n        <CitizenApp />\n      ) : (\n        <GovApp />\n      )}\n    </div>\n  );\n};\n\nexport default function App() {\n  return (\n    <AppProvider>\n      <MainApp />\n    </AppProvider>\n  );\n}"
    }
