    replacement_chunks {
      target_content: "import React from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { MapPin, Clock, ArrowRight, CheckCircle2, AlertCircle } from \'lucide-react\';\nimport { formatDate } from \'../../utils\';\n\nexport const CitizenHome: React.FC<{ onNavigate: (screen: any, issueId?: string) => void }> = ({ onNavigate }) => {\n  const { issues } = useApp();\n  \n  // Calculate summary\n  const total = issues.length;\n  const resolved = issues.filter(i => i.status === \'Resolved\' || i.status === \'Closed\').length;\n  const inProgress = issues.filter(i => i.status === \'In Progress\' || i.status === \'Assigned\').length;\n  const reopened = issues.filter(i => i.status === \'Reopened\').length;\n\n  return (\n    <div className=\"flex flex-col\">\n      {/* Hero */}\n      <div className=\"bg-blue-600 text-white px-5 py-8 rounded-b-3xl shadow-md\">\n        <h2 className=\"text-2xl font-bold mb-1\">See a civic problem?</h2>\n        <p className=\"text-blue-100 mb-6 text-sm\">Report it in a few seconds.</p>\n        \n        <button \n          onClick={() => onNavigate(\'report\')}\n          className=\"w-full bg-white text-blue-700 py-3.5 rounded-xl font-bold text-lg shadow-lg flex items-center justify-center gap-2 hover:bg-gray-50 active:scale-[0.98] transition-transform\"\n        >\n          + Report an Issue\n        </button>\n        \n        <button \n          onClick={() => onNavigate(\'my_reports\')}\n          className=\"w-full mt-3 text-white border border-blue-400 py-3 rounded-xl font-medium text-sm flex items-center justify-center gap-2 hover:bg-blue-700 transition-colors\"\n        >\n          Track My Reports <ArrowRight size={16} />\n        </button>\n      </div>\n\n      {/* Summary Stats */}\n      <div className=\"px-4 -mt-4 relative z-10\">\n        <div className=\"bg-white rounded-xl shadow-sm border p-4 grid grid-cols-4 gap-2 text-center divide-x\">\n          <div>\n            <div className=\"text-xl font-bold text-gray-800\">{total}</div>\n            <div className=\"text-[10px] text-gray-500 font-medium uppercase mt-1\">Total</div>\n          </div>\n          <div>\n            <div className=\"text-xl font-bold text-green-600\">{resolved}</div>\n            <div className=\"text-[10px] text-gray-500 font-medium uppercase mt-1\">Resolved</div>\n          </div>\n          <div>\n            <div className=\"text-xl font-bold text-blue-600\">{inProgress}</div>\n            <div className=\"text-[10px] text-gray-500 font-medium uppercase mt-1\">Progress</div>\n          </div>\n          <div>\n            <div className=\"text-xl font-bold text-red-500\">{reopened}</div>\n            <div className=\"text-[10px] text-gray-500 font-medium uppercase mt-1\">Reopened</div>\n          </div>\n        </div>\n      </div>\n\n      {/* Recent Nearby */}\n      <div className=\"p-4 mt-2\">\n        <div className=\"flex justify-between items-center mb-4\">\n          <h3 className=\"font-bold text-gray-800\">Recent Issues Near You</h3>\n          <button className=\"text-xs text-blue-600 font-semibold\" onClick={() => onNavigate(\'my_reports\')}>View All</button>\n        </div>\n\n        <div className=\"space-y-3\">\n          {issues.slice(0, 3).map(issue => (\n            <div \n              key={issue.id} \n              className=\"bg-white p-3 rounded-xl shadow-sm border flex gap-3 cursor-pointer hover:border-blue-300\"\n              onClick={() => onNavigate(\'issue_detail\', issue.id)}\n            >\n              <img src={issue.images.before} alt=\"Issue\" className=\"w-20 h-20 rounded-lg object-cover\" />\n              <div className=\"flex-1 flex flex-col justify-between py-0.5\">\n                <div>\n                  <h4 className=\"text-sm font-bold text-gray-900 line-clamp-1\">{issue.title}</h4>\n                  <div className=\"flex items-center text-xs text-gray-500 mt-1 gap-1\">\n                    <MapPin size={12} /> <span className=\"line-clamp-1\">{issue.location}</span>\n                  </div>\n                </div>\n                <div className=\"flex items-center justify-between mt-2\">\n                  <span className=\"text-[10px] px-2 py-1 bg-gray-100 rounded-md font-medium text-gray-700\">\n                    {issue.status}\n                  </span>\n                  <div className=\"flex items-center text-[10px] text-gray-400 gap-1\">\n                    <Clock size={10} /> {formatDate(issue.reportedAt).split(\',\')[0]}\n                  </div>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { MapPin, Clock, ArrowRight, CheckCircle2, AlertCircle, PlusCircle } from \'lucide-react\';\nimport { formatDate } from \'../../utils\';\n\nexport const CitizenHome: React.FC<{ onNavigate: (screen: any, issueId?: string) => void }> = ({ onNavigate }) => {\n  const { issues } = useApp();\n  \n  // Calculate summary\n  const total = issues.length;\n  const resolved = issues.filter(i => i.status === \'Resolved\' || i.status === \'Closed\').length;\n  const inProgress = issues.filter(i => i.status === \'In Progress\' || i.status === \'Assigned\').length;\n\n  return (\n    <div className=\"flex flex-col\">\n      {/* Hero */}\n      <div className=\"bg-blue-600 px-5 pt-8 pb-12 rounded-b-[2rem] text-white relative shadow-inner\">\n        <div className=\"absolute top-0 left-0 w-full h-full overflow-hidden rounded-b-[2rem] pointer-events-none\">\n          <div className=\"absolute -top-10 -right-10 w-40 h-40 bg-blue-500 rounded-full blur-3xl opacity-50\"></div>\n          <div className=\"absolute bottom-0 -left-10 w-32 h-32 bg-blue-700 rounded-full blur-2xl opacity-40\"></div>\n        </div>\n        \n        <div className=\"relative z-10\">\n          <h2 className=\"text-2xl font-bold mb-1 tracking-tight\">See a civic issue?</h2>\n          <p className=\"text-blue-100 text-sm mb-6\">Report it directly to the corporation.</p>\n          \n          <button \n            onClick={() => onNavigate(\'report\')}\n            className=\"w-full bg-white text-blue-600 py-3.5 rounded-xl font-bold text-[15px] shadow-xl shadow-blue-900/20 flex items-center justify-center space-x-2 active:scale-95 transition-transform\"\n          >\n            <PlusCircle size={20} />\n            <span>Report an Issue</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Summary Stats */}\n      <div className=\"px-4 -mt-6 relative z-20 mb-6\">\n        <div className=\"bg-white rounded-2xl shadow-sm border border-slate-100 p-4 grid grid-cols-3 gap-2 text-center divide-x divide-slate-100\">\n          <div>\n            <div className=\"text-xl font-bold text-slate-800\">{total}</div>\n            <div className=\"text-[10px] text-slate-400 font-bold uppercase tracking-wider mt-1\">Reported</div>\n          </div>\n          <div>\n            <div className=\"text-xl font-bold text-amber-500\">{inProgress}</div>\n            <div className=\"text-[10px] text-slate-400 font-bold uppercase tracking-wider mt-1\">Working</div>\n          </div>\n          <div>\n            <div className=\"text-xl font-bold text-emerald-500\">{resolved}</div>\n            <div className=\"text-[10px] text-slate-400 font-bold uppercase tracking-wider mt-1\">Resolved</div>\n          </div>\n        </div>\n      </div>\n\n      {/* Recent Nearby */}\n      <div className=\"px-4 pb-4\">\n        <div className=\"flex justify-between items-center mb-4\">\n          <h3 className=\"font-bold text-slate-900 tracking-tight\">Recent Updates Near You</h3>\n          <button className=\"text-xs text-blue-600 font-bold hover:underline\" onClick={() => onNavigate(\'my_reports\')}>View All</button>\n        </div>\n\n        <div className=\"space-y-3\">\n          {issues.slice(0, 3).map(issue => (\n            <div \n              key={issue.id} \n              className=\"bg-white p-3 rounded-xl shadow-sm border border-slate-100 flex gap-3 cursor-pointer hover:border-blue-200 transition-colors\"\n              onClick={() => onNavigate(\'issue_detail\', issue.id)}\n            >\n              <img src={issue.images.before} alt=\"Issue\" className=\"w-20 h-20 rounded-lg object-cover\" />\n              <div className=\"flex-1 flex flex-col justify-between py-0.5\">\n                <div>\n                  <h4 className=\"text-sm font-bold text-slate-900 line-clamp-1\">{issue.title}</h4>\n                  <div className=\"flex items-center text-xs text-slate-500 mt-1 gap-1\">\n                    <MapPin size={12} className=\"shrink-0\" /> <span className=\"line-clamp-1\">{issue.location}</span>\n                  </div>\n                </div>\n                <div className=\"flex items-center justify-between mt-2\">\n                  <span className={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded ${\n                    issue.status === \'Resolved\' || issue.status === \'Closed\' ? \'bg-emerald-50 text-emerald-700 border border-emerald-100\' :\n                    issue.status === \'In Progress\' || issue.status === \'Assigned\' ? \'bg-blue-50 text-blue-700 border border-blue-100\' :\n                    \'bg-slate-100 text-slate-600 border border-slate-200\'\n                  }`}>\n                    {issue.status}\n                  </span>\n                  <div className=\"flex items-center text-[10px] text-slate-400 gap-1 font-medium\">\n                    <Clock size={10} /> {formatDate(issue.reportedAt).split(\',\')[0]}\n                  </div>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};"
    }
