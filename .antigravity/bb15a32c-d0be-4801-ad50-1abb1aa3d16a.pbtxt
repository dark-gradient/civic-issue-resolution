  file_change {
    absolute_path_uri: "file:///src/citizen/screens/Profile.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\nimport { ShieldCheck, User, MapPin, Calendar, CheckCircle, FileText, RefreshCcw } from \'lucide-react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { CitizenUser } from \'../../types\';\n\nexport const Profile: React.FC = () => {\n  const { user } = useApp();\n  const currentUser = user as CitizenUser;\n\n  if (!currentUser) return null;\n\n  const getInitials = (name: string) => {\n    if (!name) return \'U\';\n    return name.split(\' \').map(n => n[0]).join(\'\').substring(0, 2);\n  };\n\n  return (\n    <div className=\"animate-in fade-in slide-in-from-right-4 duration-300 p-4 pb-20\">\n      <h2 className=\"text-3xl font-bold mb-6 text-slate-900 tracking-tight\">Your Profile</h2>\n\n      <div className=\"bg-white border border-slate-200 rounded-2xl p-6 shadow-sm mb-6 flex flex-col items-center\">\n        <div className=\"w-20 h-20 bg-blue-100 text-blue-700 rounded-full flex items-center justify-center text-3xl font-bold mb-4\">\n          {getInitials(currentUser.name)}\n        </div>\n        <h3 className=\"text-2xl font-bold text-slate-900\">{currentUser.name}</h3>\n        <div className=\"flex items-center gap-1 text-emerald-600 text-sm font-bold mt-1 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-100\">\n          <ShieldCheck size={16} /> Aadhaar Verified\n        </div>\n      </div>\n\n      <div className=\"bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-6 space-y-4\">\n        <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n          <div className=\"flex items-center gap-3 text-slate-500 font-medium\">\n            <User size={18} /> Mobile\n          </div>\n          <span className=\"font-bold text-slate-900\">{currentUser.phone}</span>\n        </div>\n        <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n          <div className=\"flex items-center gap-3 text-slate-500 font-medium\">\n            <MapPin size={18} /> Area\n          </div>\n          <span className=\"font-bold text-slate-900\">{currentUser.location}</span>\n        </div>\n        <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n          <div className=\"flex items-center gap-3 text-slate-500 font-medium\">\n            <User size={18} /> Language\n          </div>\n          <span className=\"font-bold text-slate-900\">{currentUser.preferredLanguage}</span>\n        </div>\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-3 text-slate-500 font-medium\">\n            <Calendar size={18} /> Joined\n          </div>\n          <span className=\"font-bold text-slate-900\">\n            {new Date(currentUser.createdAt).toLocaleDateString(\'en-GB\', { day: \'numeric\', month: \'long\', year: \'numeric\' })}\n          </span>\n        </div>\n      </div>\n\n      <h3 className=\"text-xl font-bold text-slate-900 mb-4 tracking-tight\">Your Civic Contribution</h3>\n      \n      <div className=\"grid grid-cols-2 gap-4 mb-8\">\n        <div className=\"bg-white border border-slate-200 rounded-xl p-4 shadow-sm flex flex-col items-center text-center\">\n          <FileText className=\"w-8 h-8 text-blue-500 mb-2\" />\n          <div className=\"text-2xl font-bold text-slate-900\">{currentUser.reportsCount}</div>\n          <div className=\"text-xs text-slate-500 font-bold uppercase tracking-wider\">Reports</div>\n        </div>\n        <div className=\"bg-white border border-slate-200 rounded-xl p-4 shadow-sm flex flex-col items-center text-center\">\n          <CheckCircle className=\"w-8 h-8 text-emerald-500 mb-2\" />\n          <div className=\"text-2xl font-bold text-slate-900\">{currentUser.resolvedCount}</div>\n          <div className=\"text-xs text-slate-500 font-bold uppercase tracking-wider\">Resolved</div>\n        </div>\n        <div className=\"bg-white border border-slate-200 rounded-xl p-4 shadow-sm flex flex-col items-center text-center\">\n          <RefreshCcw className=\"w-8 h-8 text-amber-500 mb-2\" />\n          <div className=\"text-2xl font-bold text-slate-900\">{currentUser.reopenedCount}</div>\n          <div className=\"text-xs text-slate-500 font-bold uppercase tracking-wider\">Reopened</div>\n        </div>\n        <div className=\"bg-blue-600 border border-blue-700 rounded-xl p-4 shadow-sm flex flex-col items-center text-center text-white justify-center\">\n          <div className=\"text-3xl font-bold\">{currentUser.contributionScore}/100</div>\n          <div className=\"text-xs text-blue-200 font-bold uppercase tracking-wider mt-1\">Trust Score</div>\n        </div>\n      </div>\n      \n      <div className=\"bg-slate-100 border border-slate-200 rounded-xl p-4 text-xs text-slate-500 text-center\">\n        CSCIRR protects your privacy. Your full Aadhaar number is never displayed or stored in the application.\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { ShieldCheck, User, MapPin, Globe } from \'lucide-react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { CitizenUser } from \'../../types\';\nimport { cn } from \'../../utils\';\n\nexport const Profile: React.FC = () => {\n  const { user } = useApp();\n  const currentUser = user as CitizenUser;\n  const [lang, setLang] = useState(\'English\');\n\n  if (!currentUser) return null;\n\n  const getInitials = (name: string) => {\n    if (!name) return \'U\';\n    return name.split(\' \').map(n => n[0]).join(\'\').substring(0, 2);\n  };\n\n  return (\n    <div className=\"animate-in fade-in slide-in-from-right-4 duration-300 p-5 pb-20 bg-slate-50 min-h-full\">\n      <h2 className=\"text-3xl font-bold mb-6 text-slate-900 tracking-tight\">Your Profile</h2>\n\n      <div className=\"bg-white border-2 border-slate-200 rounded-2xl p-6 shadow-sm mb-6 flex flex-col items-center\">\n        <div className=\"w-24 h-24 bg-blue-100 text-blue-700 rounded-full flex items-center justify-center text-4xl font-bold mb-4\">\n          {getInitials(currentUser.name)}\n        </div>\n        <h3 className=\"text-2xl font-bold text-slate-900\">{currentUser.name}</h3>\n        <div className=\"flex items-center gap-1.5 text-emerald-700 text-sm font-bold mt-2 bg-emerald-50 px-4 py-1.5 rounded-full border border-emerald-100\">\n          <ShieldCheck size={18} /> Verified Citizen\n        </div>\n      </div>\n\n      <div className=\"bg-white border-2 border-slate-200 rounded-2xl p-5 shadow-sm mb-6 space-y-4\">\n        <div className=\"flex items-center justify-between border-b border-slate-100 pb-4\">\n          <div className=\"flex items-center gap-3 text-slate-600 font-bold\">\n            <User size={20} /> Mobile\n          </div>\n          <span className=\"font-bold text-slate-900 text-lg\">{currentUser.phone}</span>\n        </div>\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-3 text-slate-600 font-bold\">\n            <MapPin size={20} /> Area\n          </div>\n          <span className=\"font-bold text-slate-900 text-lg\">{currentUser.location}</span>\n        </div>\n      </div>\n\n      <h3 className=\"text-xl font-bold text-slate-900 mb-4 tracking-tight\">Language</h3>\n      <div className=\"bg-white border-2 border-slate-200 rounded-2xl p-3 shadow-sm mb-8\">\n        <div className=\"grid grid-cols-1 gap-2\">\n          {[\'English\', \'\340\256\244\340\256\256\340\256\277\340\256\264\340\257\215\', \'\340\244\271\340\244\277\340\244\250\340\245\215\340\244\246\340\245\200\'].map(l => (\n            <button \n              key={l}\n              onClick={() => setLang(l)}\n              className={cn(\n                \"w-full text-left px-5 py-4 rounded-xl font-bold text-lg flex items-center justify-between transition-colors border-2\",\n                lang === l ? \"bg-blue-50 border-blue-200 text-blue-700\" : \"bg-white border-transparent text-slate-700 hover:bg-slate-50\"\n              )}\n            >\n              {l}\n              {lang === l && <ShieldCheck size={20} className=\"text-blue-500\" />}\n            </button>\n          ))}\n        </div>\n      </div>\n      \n      <div className=\"bg-slate-100 border-2 border-slate-200 rounded-xl p-5 text-sm font-medium text-slate-500 text-center\">\n        Your privacy is protected. Personal details are kept secure.\n      </div>\n    </div>\n  );\n};"
    }
