der-blue-100 shadow-sm text-2xl\">\n                 \342\234\250\n              </div>\n              <div className=\"flex-1\">\n                <p className=\"text-sm font-bold text-blue-900 tracking-tight\">AI sees a {category}</p>\n                <p className=\"text-xs text-blue-700 font-medium mt-0.5\">We will route this directly to the Roads team.</p>\n              </div>\n            </div>\n\n            <button \n              onClick={() => setStep(4)}\n              className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg mt-8 shadow-xl shadow-blue-900/20 flex justify-center items-center gap-2 active:scale-95 transition-transform\"\n            >\n              Continue\n            </button>\n          </div>\n        )}\n\n        {/* STEP 4: Duplicate Warning */}\n        {step === 4 && (\n          <div className=\"animate-in fade-in slide-in-from-right-4 duration-300\">\n            <h2 className=\"text-3xl font-bold mb-2 text-slate-900 tracking-tight\">Similar Issue Found</h2>\n            <p className=\"text-slate-500 mb-6 font-medium\">We found a nearby existing issue.</p>\n            \n            <div className=\"bg-amber-50 border-2 border-amber-200 rounded-2xl p-5 mb-8\">\n              <div className=\"flex items-center gap-3 mb-3\">\n                <AlertTriangle className=\"text-amber-600\" size={24} />\n                <h3 className=\"font-bold text-amber-900 text-lg\">CIV-10482</h3>\n              </div>\n              <p className=\"text-amber-800 font-medium mb-3\">43 citizens have already reported this problem.</p>\n              <div className=\"bg-white/60 p-3 rounded-lg border border-amber-200/50\">\n                <p className=\"font-bold text-slate-900\">{category}</p>\n                <p className=\"text-sm text-slate-600\">{location}</p>\n              </div>\n            </div>\n\n            <button \n              onClick={handleSubmit}\n              disabled={isSubmitting}\n              className=\