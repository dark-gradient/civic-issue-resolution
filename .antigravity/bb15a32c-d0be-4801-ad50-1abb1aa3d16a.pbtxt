  file_change {
    absolute_path_uri: "file:///src/citizen/screens/ReportFlow.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useRef } from \'react\';\nimport { Camera, MapPin, Mic, Send, Edit2, AlertTriangle, CheckCircle, Upload } from \'lucide-react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { generateId } from \'../../utils\';\nimport { Issue } from \'../../types\';\n\nexport const ReportFlow: React.FC<{ onComplete: () => void }> = ({ onComplete }) => {\n  const [step, setStep] = useState(1);\n  const [image, setImage] = useState<string | null>(null);\n  const [location, setLocation] = useState(\'12, Anna Nagar Main Road\');\n  const [description, setDescription] = useState(\'\');\n  const [category, setCategory] = useState(\'Pothole\');\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  \n  const { addIssue, isOffline } = useApp();\n  \n  // Simulate image capture\n  const handleCapture = () => {\n    setImage(\'https://images.unsplash.com/photo-1515162816999-a0c47dc192f7?auto=format&fit=crop&q=80&w=400&h=300\');\n    setTimeout(() => setStep(2), 500);\n  };\n\n  const handleSubmit = () => {\n    setIsSubmitting(true);\n    setTimeout(() => {\n      const newIssue: Issue = {\n        id: generateId(),\n        title: description || category,\n        type: category,\n        location: location,\n        ward: \'Ward 37\', // Mocked\n        city: \'Chennai\',\n        lat: 13.0827,\n        lng: 80.2707,\n        status: \'Submitted\',\n        priority: \'High\',\n        department: \'Roads\',\n        reportedAt: new Date().toISOString(),\n        updatedAt: new Date().toISOString(),\n        reportsCount: 1,\n        aiConfidence: 96,\n        assignee: \'Unassigned\',\n        slaHours: 24,\n        slaRemaining: \'24h\',\n        images: { before: image! },\n        description,\n        isOfflineSync: isOffline,\n        timeline: [\n          {\n            id: generateId(),\n            title: \'Report submitted\',\n            timestamp: new Date().toISOString(),\n            status: \'Submitted\',\n            description: \'Report initiated by citizen.\'\n          }\n        ]\n      };\n      addIssue(newIssue);\n      setStep(5);\n      setIsSubmitting(false);\n    }, 1200);\n  };\n\n  return (\n    <div className=\"flex flex-col h-full bg-white relative\">\n      {/* Progress Header */}\n      {step < 5 && (\n        <div className=\"px-4 py-3 border-b flex items-center justify-between bg-gray-50\">\n          <div className=\"flex gap-1.5\">\n            {[1, 2, 3, 4].map(s => (\n              <div key={s} className={`h-1.5 w-12 rounded-full ${s <= step ? \'bg-blue-600\' : \'bg-gray-200\'}`} />\n            ))}\n          </div>\n          <button onClick={onComplete} className=\"text-sm font-medium text-gray-500\">Cancel</button>\n        </div>\n      )}\n\n      <div className=\"flex-1 overflow-y-auto p-5\">\n        \n        {/* STEP 1: Capture */}\n        {step === 1 && (\n          <div className=\"animate-in fade-in slide-in-from-right-4 duration-300\">\n            <h2 className=\"text-xl font-bold mb-6 text-gray-900\">Capture the problem</h2>\n            \n            {image ? (\n              <div className=\"relative rounded-2xl overflow-hidden border-4 border-white shadow-lg\">\n                <img src={image} alt=\"Captured\" className=\"w-full h-64 object-cover\" />\n                <button onClick={() => setImage(null)} className=\"absolute top-2 right-2 bg-black/50 text-white p-2 rounded-full backdrop-blur-sm\">\n                  <Edit2 size={16} />\n                </button>\n              </div>\n            ) : (\n              <div className=\"bg-gray-100 rounded-3xl h-64 flex flex-col items-center justify-center text-gray-400 border-2 border-dashed border-gray-300 mb-6\">\n                <Camera size={48} className=\"mb-2 opacity-50\" />\n                <p className=\"font-medium\">Point at the issue</p>\n              </div>\n            )}\n            \n            <div className=\"mt-8 space-y-3\">\n              <button \n                onClick={handleCapture}\n                className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 shadow-md active:bg-blue-700\"\n              >\n                <Camera size={24} /> Take Photo\n              </button>\n              <button \n                onClick={handleCapture}\n                className=\"w-full bg-gray-100 text-gray-700 py-4 rounded-xl font-semibold flex items-center justify-center gap-2 active:bg-gray-200\"\n              >\n                <Upload size={20} /> Upload from Gallery\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* STEP 2: Location */}\n        {step === 2 && (\n          <div className=\"animate-in fade-in slide-in-from-right-4 duration-300\">\n            <h2 className=\"text-xl font-bold mb-6 text-gray-900\">Where is it?</h2>\n            \n            <div className=\"bg-gray-100 rounded-2xl p-2 mb-6 border relative overflow-hidden h-48 flex items-center justify-center\">\n              {/* Fake Map */}\n              <div className=\"absolute inset-0 bg-blue-50 grid\" style={{ backgroundImage: \'radial-gradient(#93c5fd 1px, transparent 1px)\', backgroundSize: \'20px 20px\' }}></div>\n              <div className=\"z-10 bg-white p-3 rounded-full shadow-lg text-blue-600\">\n                <MapPin size={32} className=\"animate-bounce\" />\n              </div>\n            </div>\n            \n            <div className=\"bg-white border rounded-xl p-4 shadow-sm\">\n              <div className=\"flex items-start gap-3\">\n                <MapPin className=\"text-gray-400 mt-1\" size={20} />\n                <div className=\"flex-1\">\n                  <h3 className=\"font-bold text-gray-900\">{location}</h3>\n                  <p className=\"text-xs text-green-600 font-medium mt-1\">Location detected automatically</p>\n                </div>\n                <button className=\"text-sm font-semibold text-blue-600\">Adjust</button>\n              </div>\n            </div>\n\n            <button \n              onClick={() => setStep(3)}\n              className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg mt-8 shadow-md\"\n            >\n              Confirm Location\n            </button>\n          </div>\n        )}\n\n        {/* STEP 3 & 4: Details & AI */}\n        {step === 3 && (\n          <div className=\"animate-in fade-in slide-in-from-right-4 duration-300\">\n            <h2 className=\"text-xl font-bold mb-2 text-gray-900\">What happened?</h2>\n            <p className=\"text-gray-500 mb-6 text-sm\">Describe the problem in your own words.</p>\n            \n            <textarea \n              value={description}\n              onChange={(e) => setDescription(e.target.value)}\n              className=\"w-full border border-gray-300 rounded-xl p-4 h-32 focus:ring-2 focus:ring-blue-500 outline-none text-gray-800 resize-none shadow-inner\"\n              placeholder=\"E.g., Huge pothole near the bus stop...\"\n            />\n            \n            <div className=\"flex justify-between mt-3\">\n              <div className=\"flex gap-2\">\n                <button className=\"px-3 py-1 bg-gray-100 rounded text-xs font-semibold text-gray-700\">English</button>\n                <button className=\"px-3 py-1 bg-gray-50 border rounded text-xs font-medium text-gray-500\">\340\256\244\340\256\256\340\256\277\340\256\264\340\257\215</button>\n                <button className=\"px-3 py-1 bg-gray-50 border rounded text-xs font-medium text-gray-500\">\340\244\271\340\244\277\340\244\250\340\245\215\340\244\246\340\245\200</button>\n              </div>\n              <button className=\"bg-red-50 text-red-600 p-2 rounded-full hover:bg-red-100 flex items-center justify-center w-10 h-10 shadow-sm border border-red-100\">\n                <Mic size={18} />\n              </button>\n            </div>\n\n            {/* AI Panel */}\n            <div className=\"mt-8 bg-blue-50 border border-blue-200 rounded-xl p-4 flex gap-3 items-start\">\n              <div className=\"bg-blue-600 text-white p-2 rounded-lg shrink-0\">\n                <AlertTriangle size={20} />\n              </div>\n              <div className=\"flex-1\">\n                <p className=\"text-xs font-semibold text-blue-800 uppercase tracking-wider mb-1\">AI Assist</p>\n                <p className=\"text-sm text-blue-900 font-medium\">We think this is a <span className=\"font-bold underline decoration-blue-400\">{category}</span></p>\n                <p className=\"text-xs text-blue-700 mt-1\">Confidence: 96%</p>\n              </div>\n              <button className=\"text-xs font-semibold text-blue-700 bg-white px-2 py-1 rounded shadow-sm border border-blue-100\">\n                Change\n              </button>\n            </div>\n\n            <button \n              onClick={handleSubmit}\n              disabled={isSubmitting}\n              className=\"w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg mt-8 shadow-md flex justify-center items-center gap-2 disabled:opacity-70\"\n            >\n              {isSubmitting ? (\n                <>Processing...</>\n              ) : (\n                <>Submit Report <Send size={20} /></>\n              )}\n            </button>\n          </div>\n        )}\n\n        {/* STEP 5: Success */}\n        {step === 5 && (\n          <div className=\"h-full flex flex-col items-center justify-center text-center animate-in zoom-in duration-500 pb-10\">\n            <div className=\"w-24 h-24 bg-green-100 text-green-600 rounded-full flex items-center justify-center mb-6 shadow-inner\">\n              <CheckCircle size={48} />\n            </div>\n            <h2 className=\"text-2xl font-bold text-gray-900 mb-2\">Report Submitted</h2>\n            <div className=\"bg-gray-100 px-4 py-2 rounded-lg font-mono text-gray-700 font-bold tracking-widest mb-4\">\n              CIV-10482\n            </div>\n            \n            {isOffline ? (\n              <div className=\"bg-amber-50 border border-amber-200 p-4 rounded-xl mb-8 w-full\">\n                <p className=\"text-amber-800 font-semibold mb-1\">Saved on your device</p>\n                <p className=\"text-amber-700 text-sm\">Your report will automatically sync when connectivity returns.</p>\n              </div>\n            ) : (\n              <p className=\"text-gray-500 mb-8 max-w-[250px]\">\n                We\342\200\231ve received your report. We\342\200\231ll keep you updated on its progress.\n              </p>\n            )}\n\n            <button \n              onClick={onComplete}\n              className=\"w-full bg-gray-900 text-white py-4 rounded-xl font-bold shadow-md\"\n            >\n              Back to Home\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
