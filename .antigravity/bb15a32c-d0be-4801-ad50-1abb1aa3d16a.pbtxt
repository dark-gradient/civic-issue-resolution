  run_command {
    cwd: "."
    exit_code: 0
    blocking: true
    wait_ms_before_async: 5000
    command_line: "cat << \'EOF\' > src/government/screens/LiveMap.tsx\nimport React, { useMemo, useState } from \'react\';\nimport { MapContainer, TileLayer, Marker, Popup } from \'react-leaflet\';\nimport MarkerClusterGroup from \'react-leaflet-cluster\';\nimport { Icon } from \'leaflet\';\nimport { useApp } from \'../../context/AppContext\';\nimport { Filter } from \'lucide-react\';\n\nexport const GovLiveMap: React.FC = () => {\n  const { issues } = useApp();\n  const [typeFilter, setTypeFilter] = useState(\'All Types\');\n  const [priorityFilter, setPriorityFilter] = useState(\'All Priorities\');\n\n  const filteredIssues = useMemo(() => {\n    return issues.filter(issue => {\n      if (typeFilter !== \'All Types\' && issue.category !== typeFilter) return false;\n      if (priorityFilter === \'Critical Only\' && issue.priority !== \'Critical\') return false;\n      return true;\n    });\n  }, [issues, typeFilter, priorityFilter]);\n\n  // Create custom icons based on priority\n  const getIcon = (priority: string) => {\n    let color = \'blue\';\n    if (priority === \'Critical\') color = \'red\';\n    else if (priority === \'High\') color = \'orange\';\n\n    return new Icon({\n      iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-${color}.png`,\n      shadowUrl: \'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png\',\n      iconSize: [25, 41],\n      iconAnchor: [12, 41],\n      popupAnchor: [1, -34],\n      shadowSize: [41, 41]\n    });\n  };\n\n  // Center of India roughly\n  const center: [number, number] = [20.5937, 78.9629];\n\n  return (\n    <div className=\"h-[calc(100vh-80px)] bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col relative\">\n      <div className=\"absolute top-4 right-4 z-[400] bg-white rounded-xl shadow-lg border border-slate-200 p-4 w-72\">\n        <h3 className=\"font-bold text-slate-900 mb-3 tracking-tight flex items-center gap-2\">\n          <Filter size={18} /> Map Controls\n        </h3>\n        <div className=\"space-y-4\">\n          <div>\n            <label className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Issue Type</label>\n            <select \n              value={typeFilter}\n              onChange={(e) => setTypeFilter(e.target.value)}\n              className=\"w-full mt-1.5 border border-slate-200 rounded-lg p-2 text-sm bg-slate-50 text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all\"\n            >\n              <option>All Types</option>\n              <option>Roads</option>\n              <option>Water</option>\n              <option>Sanitation</option>\n              <option>Electricity</option>\n              <option>Public Property</option>\n            </select>\n          </div>\n          <div>\n            <label className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Priority</label>\n            <select \n              value={priorityFilter}\n              onChange={(e) => setPriorityFilter(e.target.value)}\n              className=\"w-full mt-1.5 border border-slate-200 rounded-lg p-2 text-sm bg-slate-50 text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all\"\n            >\n              <option>All Priorities</option>\n              <option>Critical Only</option>\n            </select>\n          </div>\n        </div>\n      </div>\n      \n      <div className=\"flex-1 relative z-0\">\n        <MapContainer \n          center={center} \n          zoom={5} \n          className=\"w-full h-full\"\n          scrollWheelZoom={true}\n        >\n          <TileLayer\n            attribution=\'&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors\'\n            url=\"https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png\"\n          />\n          <MarkerClusterGroup chunkedLoading>\n            {filteredIssues.map((issue) => (\n              <Marker \n                key={issue.id} \n                position={[issue.lat, issue.lng]} \n                icon={getIcon(issue.priority)}\n              >\n                <Popup>\n                  <div className=\"p-1\">\n                    <div className=\"font-bold text-slate-900 mb-1\">{issue.title}</div>\n                    <div className=\"text-xs text-slate-500 mb-2\">{issue.category} \342\200\242 {issue.priority}</div>\n                    <div className=\"text-sm font-medium\">Status: {issue.status}</div>\n                    <div className=\"text-sm text-slate-600 mt-1\">{issue.city}, {issue.ward}</div>\n                  </div>\n                </Popup>\n              </Marker>\n            ))}\n          </MarkerClusterGroup>\n        </MapContainer>\n      </div>\n    </div>\n  );\n};\nEOF\n"
    proposed_command_line: "cat << \'EOF\' > src/government/screens/LiveMap.tsx\nimport React, { useMemo, useState } from \'react\';\nimport { MapContainer, TileLayer, Marker, Popup } from \'react-leaflet\';\nimport MarkerClusterGroup from \'react-leaflet-cluster\';\nimport { Icon } from \'leaflet\';\nimport { useApp } from \'../../context/AppContext\';\nimport { Filter } from \'lucide-react\';\n\nexport const GovLiveMap: React.FC = () => {\n  const { issues } = useApp();\n  const [typeFilter, setTypeFilter] = useState(\'All Types\');\n  const [priorityFilter, setPriorityFilter] = useState(\'All Priorities\');\n\n  const filteredIssues = useMemo(() => {\n    return issues.filter(issue => {\n      if (typeFilter !== \'All Types\' && issue.category !== typeFilter) return false;\n      if (priorityFilter === \'Critical Only\' && issue.priority !== \'Critical\') return false;\n      return true;\n    });\n  }, [issues, typeFilter, priorityFilter]);\n\n  // Create custom icons based on priority\n  const getIcon = (priority: string) => {\n    let color = \'blue\';\n    if (priority === \'Critical\') color = \'red\';\n    else if (priority === \'High\') color = \'orange\';\n\n    return new Icon({\n      iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-${color}.png`,\n      shadowUrl: \'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png\',\n      iconSize: [25, 41],\n      iconAnchor: [12, 41],\n      popupAnchor: [1, -34],\n      shadowSize: [41, 41]\n    });\n  };\n\n  // Center of India roughly\n  const center: [number, number] = [20.5937, 78.9629];\n\n  return (\n    <div className=\"h-[calc(100vh-80px)] bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col relative\">\n      <div className=\"absolute top-4 right-4 z-[400] bg-white rounded-xl shadow-lg border border-slate-200 p-4 w-72\">\n        <h3 className=\"font-bold text-slate-900 mb-3 tracking-tight flex items-center gap-2\">\n          <Filter size={18} /> Map Controls\n        </h3>\n        <div className=\"space-y-4\">\n          <div>\n            <label className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Issue Type</label>\n            <select \n              value={typeFilter}\n              onChange={(e) => setTypeFilter(e.target.value)}\n              className=\"w-full mt-1.5 border border-slate-200 rounded-lg p-2 text-sm bg-slate-50 text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all\"\n            >\n              <option>All Types</option>\n              <option>Roads</option>\n              <option>Water</option>\n              <option>Sanitation</option>\n              <option>Electricity</option>\n              <option>Public Property</option>\n            </select>\n          </div>\n          <div>\n            <label className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Priority</label>\n            <select \n              value={priorityFilter}\n              onChange={(e) => setPriorityFilter(e.target.value)}\n              className=\"w-full mt-1.5 border border-slate-200 rounded-lg p-2 text-sm bg-slate-50 text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all\"\n            >\n              <option>All Priorities</option>\n              <option>Critical Only</option>\n            </select>\n          </div>\n        </div>\n      </div>\n      \n      <div className=\"flex-1 relative z-0\">\n        <MapContainer \n          center={center} \n          zoom={5} \n          className=\"w-full h-full\"\n          scrollWheelZoom={true}\n        >\n          <TileLayer\n            attribution=\'&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors\'\n            url=\"https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png\"\n          />\n          <MarkerClusterGroup chunkedLoading>\n            {filteredIssues.map((issue) => (\n              <Marker \n                key={issue.id} \n                position={[issue.lat, issue.lng]} \n                icon={getIcon(issue.priority)}\n              >\n                <Popup>\n                  <div className=\"p-1\">\n                    <div className=\"font-bold text-slate-900 mb-1\">{issue.title}</div>\n                    <div className=\"text-xs text-slate-500 mb-2\">{issue.category} \342\200\242 {issue.priority}</div>\n                    <div className=\"text-sm font-medium\">Status: {issue.status}</div>\n                    <div className=\"text-sm text-slate-600 mt-1\">{issue.city}, {issue.ward}</div>\n                  </div>\n                </Popup>\n              </Marker>\n            ))}\n          </MarkerClusterGroup>\n        </MapContainer>\n      </div>\n    </div>\n  );\n};\nEOF\n"
    shell_name: "bash"
  }
