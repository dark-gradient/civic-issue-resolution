disabled={isSubmitting}\n              className=\"w-full bg-white border-2 border-slate-200 text-slate-700 py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 disabled:opacity-70 active:scale-95 transition-transform\"\n            >\n              Report as Different Issue\n            </button>\n          </div>\n        )}\n\n        {/* STEP 5: Success */}"
