    replacement_chunks {
      target_content: "import React from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { AlertCircle, Clock, CheckCircle2, TrendingUp, MapPin } from \'lucide-react\';\nimport { StatusBadge } from \'../../citizen/screens/MyReports\';\nimport { cn } from \'../../utils\';\n\nexport const GovOverview: React.FC<{ onNavigate: (s: any, id?: string) => void }> = ({ onNavigate }) => {\n  const { issues } = useApp();\n\n  // Mock stats\n  const stats = [\n    { label: \'Total Open Issues\', value: \'2,481\', trend: \'+12%\', icon: AlertCircle, color: \'text-blue-600\', bg: \'bg-blue-100\' },\n    { label: \'Critical Priority\', value: \'86\', trend: \'+3\', icon: AlertCircle, color: \'text-red-600\', bg: \'bg-red-100\' },\n    { label: \'In Progress\', value: \'724\', trend: \'steady\', icon: Clock, color: \'text-amber-600\', bg: \'bg-amber-100\' },\n    { label: \'Resolved Today\', value: \'183\', trend: \'+24%\', icon: CheckCircle2, color: \'text-green-600\', bg: \'bg-green-100\' },\n  ];\n\n  return (\n    <div className=\"space-y-6 max-w-[1600px] mx-auto animate-in fade-in duration-300\">\n      \n      {/* Header */}\n      <div>\n        <h2 className=\"text-2xl font-bold text-gray-900\">Municipal Operations Overview</h2>\n        <p className=\"text-sm text-gray-500\">Live city pulse and priority queue.</p>\n      </div>\n\n      {/* KPI Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {stats.map((stat, i) => (\n          <div key={i} className=\"bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex items-center gap-4\">\n            <div className={cn(\"w-12 h-12 rounded-lg flex items-center justify-center shrink-0\", stat.bg, stat.color)}>\n              <stat.icon size={24} />\n            </div>\n            <div>\n              <p className=\"text-sm font-medium text-gray-500\">{stat.label}</p>\n              <div className=\"flex items-baseline gap-2\">\n                <h3 className=\"text-2xl font-bold text-gray-900\">{stat.value}</h3>\n                <span className=\"text-xs font-bold text-gray-400\">{stat.trend}</span>\n              </div>\n            </div>\n          </div>\n        ))}\n        \n        <div className=\"bg-white p-5 rounded-xl border border-gray-200 shadow-sm lg:col-span-2 flex justify-between items-center\">\n          <div>\n            <p className=\"text-sm font-medium text-gray-500\">Average Resolution Time</p>\n            <h3 className=\"text-2xl font-bold text-gray-900\">18.4 hrs</h3>\n          </div>\n          <div className=\"h-10 w-px bg-gray-200\"></div>\n          <div>\n            <p className=\"text-sm font-medium text-gray-500\">Citizen Verification Rate</p>\n            <h3 className=\"text-2xl font-bold text-gray-900 text-green-600\">87%</h3>\n          </div>\n          <div className=\"h-10 w-px bg-gray-200\"></div>\n          <div>\n            <p className=\"text-sm font-medium text-gray-500\">SLA Breaches</p>\n            <h3 className=\"text-2xl font-bold text-gray-900 text-red-500\">32</h3>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        \n        {/* Left: Map Widget */}\n        <div className=\"lg:col-span-1 bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden flex flex-col\">\n          <div className=\"p-4 border-b flex justify-between items-center bg-gray-50\">\n            <h3 className=\"font-bold text-gray-800\">Live Civic Map</h3>\n            <button onClick={() => onNavigate(\'map\')} className=\"text-xs font-bold text-blue-600 hover:underline\">Full Map</button>\n          </div>\n          <div className=\"flex-1 bg-blue-50 relative min-h-[400px]\">\n             {/* Fake map background */}\n             <div className=\"absolute inset-0\" style={{ backgroundImage: \'radial-gradient(#cbd5e1 1px, transparent 1px)\', backgroundSize: \'24px 24px\' }}></div>\n             \n             {/* Fake Markers */}\n             <div className=\"absolute top-1/4 left-1/4\">\n               <div className=\"relative\">\n                 <div className=\"w-4 h-4 bg-red-500 rounded-full animate-ping absolute opacity-75\"></div>\n                 <div className=\"w-4 h-4 bg-red-600 rounded-full border-2 border-white relative z-10\"></div>\n               </div>\n             </div>\n             \n             <div className=\"absolute top-1/2 left-1/2 bg-blue-600 text-white text-[10px] font-bold px-2 py-1 rounded-full border-2 border-white shadow-lg\">\n               12 Issues\n             </div>\n             \n             <div className=\"absolute bottom-1/4 right-1/3\">\n               <div className=\"w-3 h-3 bg-amber-500 rounded-full border-2 border-white\"></div>\n             </div>\n          </div>\n        </div>\n\n        {/* Right: Priority Queue */}\n        <div className=\"lg:col-span-2 bg-white rounded-xl border border-gray-200 shadow-sm flex flex-col\">\n          <div className=\"p-4 border-b flex justify-between items-center bg-gray-50\">\n            <h3 className=\"font-bold text-gray-800 flex items-center gap-2\">\n              <AlertCircle size={18} className=\"text-red-500\" />\n              Priority Action Queue\n            </h3>\n            <button onClick={() => onNavigate(\'queue\')} className=\"text-xs font-bold text-blue-600 hover:underline\">View All</button>\n          </div>\n          \n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-sm text-left\">\n              <thead className=\"text-xs text-gray-500 bg-white border-b uppercase\">\n                <tr>\n                  <th className=\"px-4 py-3 font-semibold\">Priority</th>\n                  <th className=\"px-4 py-3 font-semibold\">Issue</th>\n                  <th className=\"px-4 py-3 font-semibold\">Location</th>\n                  <th className=\"px-4 py-3 font-semibold\">Dept / Assignee</th>\n                  <th className=\"px-4 py-3 font-semibold\">SLA</th>\n                  <th className=\"px-4 py-3 font-semibold text-right\">Action</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-gray-100\">\n                {issues.slice(0, 5).map(issue => (\n                  <tr key={issue.id} className=\"hover:bg-gray-50 transition-colors\">\n                    <td className=\"px-4 py-3\">\n                      <span className={cn(\n                        \"text-[10px] font-bold uppercase px-2 py-1 rounded\",\n                        issue.priority === \'Critical\' ? \"bg-red-100 text-red-700\" :\n                        issue.priority === \'High\' ? \"bg-orange-100 text-orange-700\" :\n                        \"bg-gray-100 text-gray-700\"\n                      )}>\n                        {issue.priority}\n                      </span>\n                    </td>\n                    <td className=\"px-4 py-3\">\n                      <div className=\"font-bold text-gray-900\">{issue.id}</div>\n                      <div className=\"text-xs text-gray-500\">{issue.type} ({issue.reportsCount} reps)</div>\n                    </td>\n                    <td className=\"px-4 py-3\">\n                      <div className=\"text-gray-900 font-medium\">{issue.ward}</div>\n                      <div className=\"text-xs text-gray-500 truncate max-w-[120px]\">{issue.location}</div>\n                    </td>\n                    <td className=\"px-4 py-3\">\n                      <div className=\"text-gray-900 font-medium\">{issue.department}</div>\n                      <div className=\"text-xs text-gray-500\">{issue.assignee}</div>\n                    </td>\n                    <td className=\"px-4 py-3\">\n                      <div className={cn(\"text-xs font-bold\", issue.slaRemaining.startsWith(\'-\') ? \"text-red-600\" : \"text-gray-600\")}>\n                        {issue.slaRemaining}\n                      </div>\n                    </td>\n                    <td className=\"px-4 py-3 text-right\">\n                      <button \n                        onClick={() => onNavigate(\'issue_detail\', issue.id)}\n                        className=\"text-xs font-semibold text-blue-600 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-md transition-colors\"\n                      >\n                        Manage\n                      </button>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { AlertCircle, Clock, CheckCircle2, TrendingUp, MapPin, Download, ListTodo } from \'lucide-react\';\nimport { StatusBadge } from \'../../citizen/screens/MyReports\';\nimport { cn } from \'../../utils\';\n\nexport const GovOverview: React.FC<{ onNavigate: (s: any, id?: string) => void }> = ({ onNavigate }) => {\n  const { issues } = useApp();\n\n  // Mock stats mapping\n  const stats = [\n    { label: \'Active Issues\', value: \'1,248\', trend: \'+12%\', icon: ListTodo, color: \'text-blue-500\', bg: \'bg-blue-50\', trendColor: \'text-red-500 bg-red-50\' },\n    { label: \'Critical Priority\', value: \'86\', trend: \'+3\', icon: AlertCircle, color: \'text-red-500\', bg: \'bg-red-50\', trendColor: \'text-red-500 bg-red-50\' },\n    { label: \'In Progress\', value: \'724\', trend: \'Steady\', icon: Clock, color: \'text-amber-500\', bg: \'bg-amber-50\', trendColor: \'text-amber-600 bg-amber-50\' },\n    { label: \'Resolved Today\', value: \'183\', trend: \'+24%\', icon: CheckCircle2, color: \'text-green-500\', bg: \'bg-green-50\', trendColor: \'text-green-600 bg-green-50\' },\n  ];\n\n  return (\n    <div className=\"max-w-6xl mx-auto w-full animate-in fade-in duration-300\">\n      \n      {/* Page Header */}\n      <div className=\"flex justify-between items-end mb-6\">\n        <div>\n          <h2 className=\"text-2xl font-bold text-slate-900 tracking-tight\">Command Center</h2>\n          <p className=\"text-sm text-slate-500 mt-1\">Real-time civic operations overview</p>\n        </div>\n        <div className=\"flex space-x-2\">\n          <button className=\"px-4 py-2 bg-white border border-slate-200 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50 transition-colors shadow-sm flex items-center space-x-2\">\n            <Download size={18} />\n            <span>Export Report</span>\n          </button>\n        </div>\n      </div>\n\n      {/* KPI Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6\">\n        {stats.map((stat, i) => (\n          <div key={i} className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between\">\n            <div className=\"flex justify-between items-start mb-2\">\n              <span className=\"text-sm font-semibold text-slate-500 uppercase tracking-wider\">{stat.label}</span>\n              <div className={cn(\"p-1 rounded-md shrink-0\", stat.bg, stat.color)}>\n                <stat.icon size={20} />\n              </div>\n            </div>\n            <div className=\"flex items-baseline space-x-2 mt-2\">\n              <span className=\"text-3xl font-bold text-slate-900\">{stat.value}</span>\n              <span className={cn(\"text-xs font-bold px-1.5 py-0.5 rounded flex items-center gap-1\", stat.trendColor)}>\n                <TrendingUp size={12} /> {stat.trend}\n              </span>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        \n        {/* Left: Priority Queue */}\n        <div className=\"lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col overflow-hidden\">\n          <div className=\"px-5 py-4 border-b border-slate-100 flex justify-between items-center bg-white\">\n            <h3 className=\"font-bold text-slate-800 text-base\">Priority Action Queue</h3>\n            <button onClick={() => onNavigate(\'queue\')} className=\"text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline\">View All</button>\n          </div>\n          \n          <div className=\"overflow-x-auto flex-1\">\n            <table className=\"w-full text-sm text-left\">\n              <thead className=\"text-xs text-slate-500 bg-slate-50/50 uppercase tracking-wider\">\n                <tr>\n                  <th className=\"px-5 py-3 font-semibold\">Priority</th>\n                  <th className=\"px-5 py-3 font-semibold\">Issue Details</th>\n                  <th className=\"px-5 py-3 font-semibold\">Location</th>\n                  <th className=\"px-5 py-3 font-semibold\">Assignee</th>\n                  <th className=\"px-5 py-3 font-semibold text-right\">Action</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100\">\n                {issues.slice(0, 5).map(issue => (\n                  <tr key={issue.id} className=\"hover:bg-slate-50 transition-colors\">\n                    <td className=\"px-5 py-3\">\n                      <span className={cn(\n                        \"text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded\",\n                        issue.priority === \'Critical\' ? \"bg-red-100 text-red-700\" :\n                        issue.priority === \'High\' ? \"bg-amber-100 text-amber-700\" :\n                        \"bg-slate-100 text-slate-700\"\n                      )}>\n                        {issue.priority}\n                      </span>\n                    </td>\n                    <td className=\"px-5 py-3\">\n                      <div className=\"font-bold text-slate-900\">{issue.id}</div>\n                      <div className=\"text-xs text-slate-500\">{issue.type} ({issue.reportsCount} reps)</div>\n                    </td>\n                    <td className=\"px-5 py-3\">\n                      <div className=\"text-slate-900 font-medium\">{issue.ward}</div>\n                      <div className=\"text-xs text-slate-500 truncate max-w-[120px]\">{issue.location}</div>\n                    </td>\n                    <td className=\"px-5 py-3\">\n                      <div className=\"text-slate-900 font-medium\">{issue.department}</div>\n                      <div className=\"text-xs text-slate-500\">{issue.assignee}</div>\n                    </td>\n                    <td className=\"px-5 py-3 text-right\">\n                      <button \n                        onClick={() => onNavigate(\'issue_detail\', issue.id)}\n                        className=\"text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 px-3 py-1.5 rounded-lg shadow-sm transition-colors\"\n                      >\n                        Manage\n                      </button>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        {/* Right: Map Widget */}\n        <div className=\"lg:col-span-1 bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col overflow-hidden\">\n          <div className=\"px-5 py-4 border-b border-slate-100 flex justify-between items-center bg-white\">\n            <h3 className=\"font-bold text-slate-800 text-base\">Live Hotspots</h3>\n            <button onClick={() => onNavigate(\'map\')} className=\"text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline\">Expand</button>\n          </div>\n          <div className=\"flex-1 bg-slate-100 relative min-h-[300px]\">\n             {/* Fake map background */}\n             <div className=\"absolute inset-0\" style={{ backgroundImage: \'radial-gradient(#cbd5e1 1px, transparent 1px)\', backgroundSize: \'24px 24px\' }}></div>\n             \n             {/* Fake Markers */}\n             <div className=\"absolute top-1/4 left-1/4\">\n               <div className=\"relative flex items-center justify-center\">\n                 <div className=\"w-8 h-8 bg-red-500/20 rounded-full animate-pulse absolute\"></div>\n                 <div className=\"w-3 h-3 bg-red-600 rounded-full border-2 border-white relative z-10 shadow-sm\"></div>\n               </div>\n             </div>\n             \n             <div className=\"absolute top-1/2 left-1/2 bg-slate-900 text-white text-[10px] font-bold px-2.5 py-1 rounded-full shadow-lg border border-slate-700 transform -translate-x-1/2 -translate-y-1/2\">\n               12 Critical\n             </div>\n             \n             <div className=\"absolute bottom-1/4 right-1/3\">\n               <div className=\"w-3 h-3 bg-amber-500 rounded-full border-2 border-white shadow-sm\"></div>\n             </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n};"
