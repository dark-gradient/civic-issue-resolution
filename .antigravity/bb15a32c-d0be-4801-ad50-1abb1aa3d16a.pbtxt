  file_change {
    absolute_path_uri: "file:///src/citizen/screens/MyReports.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "export const MyReports: React.FC<{ onNavigate: (s: any, id?: string) => void }> = ({ onNavigate }) => {\n  const { issues, offlineQueue } = useApp();\n  const [filter, setFilter] = useState<\'All\' | \'Active\' | \'Resolved\' | \'Reopened\'>(\'All\');\n\n  const filtered = issues.filter(issue => {\n    if (filter === \'All\') return true;\n    if (filter === \'Active\') return [\'Submitted\', \'Assigned\', \'In Progress\', \'Under Review\'].includes(issue.status);\n    if (filter === \'Resolved\') return [\'Resolved\', \'Closed\', \'Awaiting Verification\'].includes(issue.status);\n    if (filter === \'Reopened\') return issue.status === \'Reopened\';\n    return true;\n  });\n\n  return (\n    <div className=\"flex flex-col h-full bg-slate-50\">\n      <div className=\"bg-white px-5 py-4 shadow-sm border-b border-slate-200 sticky top-0 z-10\">\n        <h2 className=\"text-xl font-bold text-slate-900 tracking-tight\">My Reports</h2>\n        \n        {/* Filters */}\n        <div className=\"flex gap-2 mt-4 overflow-x-auto no-scrollbar pb-1\">\n          {[\'All\', \'Active\', \'Resolved\', \'Reopened\'].map(f => (\n            <button \n              key={f}\n              onClick={() => setFilter(f as any)}\n              className={cn(\n                \"px-4 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap border transition-colors\",\n                filter === f \n                  ? \"bg-slate-900 text-white border-slate-900\" \n                  : \"bg-white text-slate-600 border-slate-200 hover:bg-slate-50\"\n              )}\n            >\n              {f}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      <div className=\"p-4 space-y-3 pb-24\">\n        {/* Offline Queue UI */}\n        {offlineQueue.length > 0 && filter === \'All\' && (\n          <div className=\"bg-amber-50 border border-amber-200 p-3 rounded-xl shadow-sm\">\n            <div className=\"flex items-center gap-2 text-amber-800 font-bold text-sm mb-1\">\n              <WifiOff size={16} /> Pending Sync ({offlineQueue.length})\n            </div>\n            <p className=\"text-xs text-amber-700\">These reports will be uploaded when online.</p>\n          </div>\n        )}\n\n        {filtered.length === 0 ? (\n          <div className=\"text-center py-10 text-slate-500\">\n            No reports found for this filter.\n          </div>\n        ) : (\n          filtered.map(issue => (\n            <div \n              key={issue.id} \n              className=\"bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col gap-3 active:scale-[0.98] transition-transform cursor-pointer\"\n              onClick={() => onNavigate(\'issue_detail\', issue.id)}\n            >\n              <div className=\"flex justify-between items-start\">\n                <div>\n                  <span className=\"text-[10px] font-mono font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded border border-slate-200\">{issue.id}</span>\n                  <h4 className=\"text-base font-bold text-slate-900 mt-1 tracking-tight\">{issue.type}</h4>\n                </div>\n                <StatusBadge status={issue.status} />\n              </div>\n              \n              <div className=\"flex gap-3\">\n                <img src={issue.images.before} alt=\"\" className=\"w-20 h-20 rounded-lg object-cover border border-slate-100\" />\n                <div className=\"flex-1 flex flex-col justify-end\">\n                  <div className=\"flex items-start text-sm text-slate-600 gap-1.5 mb-1.5\">\n                    <MapPin size={14} className=\"mt-0.5 text-slate-400 shrink-0\" /> \n                    <span className=\"line-clamp-2 leading-tight\">{issue.location}</span>\n                  </div>\n                  <div className=\"text-xs text-slate-400 font-medium\">\n                    Reported on {formatDate(issue.reportedAt).split(\',\')[0]}\n                  </div>\n                </div>\n              </div>\n            </div>\n          ))\n        )}\n      </div>\n    </div>\n  );\n};"
      replacement_content: "export const MyReports: React.FC<{ onNavigate: (s: any, id?: string) => void }> = ({ onNavigate }) => {\n  const { issues, offlineQueue } = useApp();\n  const [filter, setFilter] = useState<\'All\' | \'Active\' | \'Resolved\'>(\'All\');\n\n  const filtered = issues.filter(issue => {\n    if (filter === \'All\') return true;\n    if (filter === \'Active\') return ![\'Resolved\', \'Closed\', \'Awaiting Verification\'].includes(issue.status);\n    if (filter === \'Resolved\') return [\'Resolved\', \'Closed\', \'Awaiting Verification\'].includes(issue.status);\n    return true;\n  });\n\n  return (\n    <div className=\"flex flex-col h-full bg-slate-50\">\n      <div className=\"bg-white px-5 py-4 shadow-sm border-b border-slate-200 sticky top-0 z-10\">\n        <h2 className=\"text-3xl font-bold text-slate-900 tracking-tight\">My Reports</h2>\n        \n        {/* Filters */}\n        <div className=\"flex gap-2 mt-4 overflow-x-auto no-scrollbar pb-1\">\n          {[\'All\', \'Active\', \'Resolved\'].map(f => (\n            <button \n              key={f}\n              onClick={() => setFilter(f as any)}\n              className={cn(\n                \"px-5 py-2.5 rounded-full text-sm font-bold whitespace-nowrap border-2 transition-colors\",\n                filter === f \n                  ? \"bg-slate-900 text-white border-slate-900\" \n                  : \"bg-white text-slate-600 border-slate-200 hover:bg-slate-50\"\n              )}\n            >\n              {f}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      <div className=\"p-4 space-y-4 pb-24\">\n        {/* Offline Queue UI */}\n        {offlineQueue.length > 0 && filter === \'All\' && (\n          <div className=\"bg-amber-50 border-2 border-amber-200 p-4 rounded-xl shadow-sm\">\n            <div className=\"flex items-center gap-2 text-amber-800 font-bold text-lg mb-1\">\n              <WifiOff size={20} /> Saved Offline ({offlineQueue.length})\n            </div>\n            <p className=\"text-sm text-amber-700 font-medium\">It will be sent when internet returns.</p>\n          </div>\n        )}\n\n        {filtered.length === 0 ? (\n          <div className=\"text-center py-10 text-slate-500 font-medium\">\n            No reports found.\n          </div>\n        ) : (\n          filtered.map(issue => (\n            <div \n              key={issue.id} \n              className=\"bg-white p-4 rounded-2xl shadow-sm border-2 border-slate-200 flex flex-col gap-4 active:scale-[0.98] transition-transform cursor-pointer\"\n              onClick={() => onNavigate(\'issue_detail\', issue.id)}\n            >\n              <div className=\"flex gap-4\">\n                <img src={issue.images.before} alt=\"\" className=\"w-24 h-24 rounded-xl object-cover border border-slate-100\" />\n                <div className=\"flex-1 flex flex-col\">\n                  <h4 className=\"text-lg font-bold text-slate-900 tracking-tight leading-tight mb-2\">\360\237\223\267 {issue.title}</h4>\n                  \n                  <div className=\"flex items-start text-sm text-slate-600 gap-1.5 font-medium mb-3\">\n                    <MapPin size={16} className=\"mt-0.5 text-slate-400 shrink-0\" /> \n                    <span className=\"line-clamp-2\">{issue.location.split(\',\')[0]}</span>\n                  </div>\n                  \n                  <CitizenStatusBadge status={issue.status} />\n                </div>\n              </div>\n            </div>\n          ))\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport const getSimplifiedStatus = (status: string) => {\n  if ([\'Submitted\', \'Under Review\'].includes(status)) return { text: \'Report received\', color: \'bg-blue-100 text-blue-800 border-blue-200\', dot: \'bg-blue-500\' };\n  if ([\'Assigned\', \'In Progress\'].includes(status)) return { text: \'Being handled\', color: \'bg-amber-100 text-amber-800 border-amber-200\', dot: \'bg-amber-500\' };\n  if ([\'Awaiting Verification\'].includes(status)) return { text: \'Fixed \342\200\224 Please confirm\', color: \'bg-emerald-100 text-emerald-800 border-emerald-200\', dot: \'bg-emerald-500\' };\n  if ([\'Resolved\', \'Closed\'].includes(status)) return { text: \'Work completed\', color: \'bg-slate-100 text-slate-800 border-slate-200\', dot: \'bg-slate-500\' };\n  if (status === \'Reopened\') return { text: \'Problem still exists\', color: \'bg-red-100 text-red-800 border-red-200\', dot: \'bg-red-500\' };\n  return { text: \'Report received\', color: \'bg-blue-100 text-blue-800 border-blue-200\', dot: \'bg-blue-500\' };\n};\n\nexport const CitizenStatusBadge = ({ status }: { status: string }) => {\n  const simpleStatus = getSimplifiedStatus(status);\n  \n  return (\n    <div className={cn(\"inline-flex items-center gap-2 px-3 py-1.5 rounded-lg font-bold text-sm border\", simpleStatus.color, \"w-fit\")}>\n      <span className={cn(\"w-2.5 h-2.5 rounded-full animate-pulse\", simpleStatus.dot)}></span>\n      {simpleStatus.text}\n    </div>\n  );\n}"
    }
