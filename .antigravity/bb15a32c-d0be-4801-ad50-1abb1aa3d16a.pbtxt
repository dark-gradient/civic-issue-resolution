        replacement_content: "export const GovIssueQueue: React.FC<{ onNavigate: (s: any, id?: string) => void, filterBy?: string }> = ({ onNavigate, filterBy }) => {\n  const { issues } = useApp();\n  const [searchTerm, setSearchTerm] = useState(\'\');\n\n  const filteredIssues = issues.filter(i => {\n    if (filterBy === \'sla\' && !i.slaRemaining.startsWith(\'-\')) return false;\n    \n    if (searchTerm) {\n      const searchLower = searchTerm.toLowerCase();\n      if (!i.id.toLowerCase().includes(searchLower) && \n          !i.type.toLowerCase().includes(searchLower) &&\n          !i.ward.toLowerCase().includes(searchLower)) {\n        return false;\n      }\n    }\n    return true;\n  });"
