  file_change {
    absolute_path_uri: "file:///src/government/GovApp.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  LayoutDashboard, Map as MapIcon, Layers, Users, Truck, AlertTriangle, \n  MessageSquare, BarChart3, Settings, Search, Bell, UserCircle, Menu \n} from \'lucide-react\';\nimport { GovOverview } from \'./screens/Overview\';\nimport { GovLiveMap } from \'./screens/LiveMap\';\nimport { GovIssueQueue } from \'./screens/IssueQueue\';\nimport { GovIssueDetail } from \'./screens/IssueDetail\';\nimport { GovAnalytics } from \'./screens/Analytics\';\n\nexport type GovScreen = \'overview\' | \'map\' | \'queue\' | \'departments\' | \'field\' | \'sla\' | \'reports\' | \'analytics\' | \'hotspots\' | \'settings\' | \'issue_detail\';\n\nexport const GovApp: React.FC<{ onSwitchRole: () => void }> = ({ onSwitchRole }) => {\n  const [currentScreen, setCurrentScreen] = useState<GovScreen>(\'overview\');\n  const [selectedIssueId, setSelectedIssueId] = useState<string | null>(null);\n\n  const navigateTo = (screen: GovScreen, issueId?: string) => {\n    if (issueId) setSelectedIssueId(issueId);\n    setCurrentScreen(screen);\n  };\n\n  const navItems = [\n    { id: \'overview\', label: \'Overview\', icon: LayoutDashboard },\n    { id: \'map\', label: \'Live Issue Map\', icon: MapIcon },\n    { id: \'queue\', label: \'Issue Queue\', icon: Layers },\n    { id: \'departments\', label: \'Departments\', icon: Users },\n    { id: \'field\', label: \'Field Operations\', icon: Truck },\n    { id: \'sla\', label: \'SLA & Escalations\', icon: AlertTriangle },\n    { id: \'reports\', label: \'Citizen Reports\', icon: MessageSquare },\n    { id: \'analytics\', label: \'Analytics\', icon: BarChart3 },\n    { id: \'hotspots\', label: \'Recurring Hotspots\', icon: AlertTriangle },\n    { id: \'settings\', label: \'Settings\', icon: Settings },\n  ];\n\n  return (\n    <div className=\"flex h-screen w-full bg-gray-50 overflow-hidden font-sans\">\n      \n      {/* SIDEBAR */}\n      <aside className=\"w-64 bg-slate-900 text-slate-300 flex flex-col shrink-0\">\n        <div className=\"h-16 flex items-center px-6 border-b border-slate-800 bg-slate-950\">\n          <div className=\"w-8 h-8 rounded bg-blue-600 flex items-center justify-center text-white font-bold text-lg mr-3\">\n            C\n          </div>\n          <div>\n            <h1 className=\"font-bold text-white leading-none tracking-wide\">CivicPulse</h1>\n            <span className=\"text-[10px] text-slate-500 font-semibold uppercase tracking-widest\">Command Center</span>\n          </div>\n        </div>\n\n        <nav className=\"flex-1 overflow-y-auto py-4 px-3 space-y-1\">\n          {navItems.map(item => (\n            <button\n              key={item.id}\n              onClick={() => navigateTo(item.id as GovScreen)}\n              className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${\n                currentScreen === item.id || (currentScreen === \'issue_detail\' && item.id === \'queue\')\n                  ? \'bg-blue-600 text-white\' \n                  : \'hover:bg-slate-800 hover:text-white\'\n              }`}\n            >\n              <item.icon size={18} className={currentScreen === item.id ? \'text-blue-200\' : \'text-slate-400\'} />\n              {item.label}\n            </button>\n          ))}\n        </nav>\n\n        <div className=\"p-4 border-t border-slate-800 text-xs\">\n          <button onClick={onSwitchRole} className=\"w-full py-2 bg-slate-800 hover:bg-slate-700 text-white rounded font-medium transition-colors\">\n            Switch to Citizen App\n          </button>\n        </div>\n      </aside>\n\n      {/* MAIN CONTENT WRAPPER */}\n      <div className=\"flex-1 flex flex-col min-w-0\">\n        \n        {/* TOP HEADER */}\n        <header className=\"h-16 bg-white border-b border-gray-200 flex items-center justify-between px-6 shrink-0 z-10 shadow-sm\">\n          <div className=\"flex items-center gap-4\">\n            <h2 className=\"text-xl font-bold text-gray-800\">Chennai Municipal Corporation</h2>\n            <div className=\"h-4 w-px bg-gray-300\" />\n            <div className=\"flex items-center gap-2 text-xs font-semibold px-2.5 py-1 bg-green-50 text-green-700 rounded-full border border-green-200\">\n              <div className=\"w-2 h-2 rounded-full bg-green-500 animate-pulse\" />\n              OPERATIONAL\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-5\">\n            <div className=\"relative\">\n              <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-400\" size={16} />\n              <input \n                type=\"text\" \n                placeholder=\"Search issues, wards...\" \n                className=\"pl-9 pr-4 py-1.5 bg-gray-100 border-transparent rounded-lg text-sm focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none w-64 transition-all\"\n              />\n            </div>\n            \n            <div className=\"flex items-center gap-3 border-l pl-5\">\n              <button className=\"text-gray-500 hover:text-gray-800 relative\">\n                <Bell size={20} />\n                <span className=\"absolute -top-1 -right-1 w-4 h-4 bg-red-500 text-white text-[9px] font-bold rounded-full flex items-center justify-center\">3</span>\n              </button>\n              <div className=\"flex items-center gap-2 cursor-pointer\">\n                <div className=\"text-right hidden md:block\">\n                  <div className=\"text-sm font-bold text-gray-800 leading-none\">R. Krishnan</div>\n                  <div className=\"text-[10px] text-gray-500 font-medium\">Chief Operations Officer</div>\n                </div>\n                <UserCircle size={32} className=\"text-gray-400\" />\n              </div>\n            </div>\n          </div>\n        </header>\n\n        {/* MAIN SCROLLABLE AREA */}\n        <main className=\"flex-1 overflow-auto bg-gray-50/50 p-6\">\n          {currentScreen === \'overview\' && <GovOverview onNavigate={navigateTo} />}\n          {currentScreen === \'map\' && <GovLiveMap />}\n          {currentScreen === \'queue\' && <GovIssueQueue onNavigate={navigateTo} />}\n          {currentScreen === \'issue_detail\' && selectedIssueId && (\n            <GovIssueDetail issueId={selectedIssueId} onBack={() => navigateTo(\'queue\')} />\n          )}\n          {currentScreen === \'analytics\' && <GovAnalytics />}\n          \n          {/* Placeholders for screens we are simplifying due to token limits */}\n          {[\'departments\', \'field\', \'sla\', \'reports\', \'hotspots\', \'settings\'].includes(currentScreen) && (\n            <div className=\"flex flex-col items-center justify-center h-full text-gray-400\">\n              <Settings size={48} className=\"mb-4 opacity-20\" />\n              <h2 className=\"text-2xl font-bold text-gray-300\">Module Under Construction</h2>\n              <p className=\"mt-2 text-gray-500\">The {currentScreen} dashboard is part of the full suite.</p>\n            </div>\n          )}\n        </main>\n      </div>\n    </div>\n  );\n};\n"
    }
