        replacement_content: "import React from \'react\';\nimport { MapPin } from \'lucide-react\';\n\nexport const GovLiveMap: React.FC = () => {\n  return (\n    <div className=\"h-[calc(100vh-80px)] bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col animate-in fade-in duration-300 relative\">\n      <div className=\"absolute top-4 left-4 z-10 bg-white rounded-xl shadow-lg border border-slate-200 p-4 w-72\">\n        <h3 className=\"font-bold text-slate-900 mb-3 tracking-tight\">Map Controls</h3>\n        <div className=\"space-y-4\">\n          <div>\n            <label className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Issue Type</label>\n            <select className=\"w-full mt-1.5 border border-slate-200 rounded-lg p-2 text-sm bg-slate-50 text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all\">\n              <option>All Types</option>\n              <option>Potholes</option>\n              <option>Garbage</option>\n            </select>\n          </div>\n          <div>\n            <label className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">Priority</label>\n            <select className=\"w-full mt-1.5 border border-slate-200 rounded-lg p-2 text-sm bg-slate-50 text-slate-700 outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all\">\n              <option>All Priorities</option>\n              <option>Critical Only</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"flex-1 bg-slate-50 relative\">\n         <div className=\"absolute inset-0 opacity-40\" style={{ backgroundImage: \'radial-gradient(#94a3b8 2px, transparent 2px)\', backgroundSize: \'30px 30px\' }}></div>\n         \n         <div className=\"absolute inset-0 flex items-center justify-center pointer-events-none\">\n           <div className=\"text-center\">\n             <MapPin size=