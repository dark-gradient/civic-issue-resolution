        replacement_content: "export const AuthFlow: React.FC = () => {\n  const { authState, setAuthState, loginCitizen, loginGov } = useApp();\n  \n  // Default to GOV_AUTH if the last active app was GOV (e.g. after Gov logout)\n  const [view, setView] = useState<\'WELCOME\' | \'CITIZEN_AUTH\' | \'GOV_AUTH\'>(\n    localStorage.getItem(\'cscirr_active_app\') === \'GOV\' ? \'GOV_AUTH\' : \'WELCOME\'\n  );"
