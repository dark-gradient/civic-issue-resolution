    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { Home, PlusCircle, ListTodo, Bell, User, WifiOff, CheckCircle } from \'lucide-react\';\nimport { useApp } from \'../context/AppContext\';\nimport { CitizenHome } from \'./screens/Home\';\nimport { ReportFlow } from \'./screens/ReportFlow\';\nimport { MyReports } from \'./screens/MyReports\';\nimport { IssueDetail } from \'./screens/IssueDetail\';\nimport { cn } from \'../utils\';\n\nexport type CitizenScreen = \'home\' | \'report\' | \'my_reports\' | \'issue_detail\' | \'notifications\' | \'profile\';\n\nexport const CitizenApp: React.FC<{ onSwitchRole: () => void }> = ({ onSwitchRole }) => {\n  const [currentScreen, setCurrentScreen] = useState<CitizenScreen>(\'home\');\n  const [selectedIssueId, setSelectedIssueId] = useState<string | null>(null);\n  \n  const { isOffline, toggleOffline, offlineQueue, issues } = useApp();\n\n  const navigateTo = (screen: CitizenScreen, issueId?: string) => {\n    if (issueId) setSelectedIssueId(issueId);\n    setCurrentScreen(screen);\n  };\n\n  return (\n    <section className=\"flex-1 bg-slate-200 flex justify-center overflow-hidden\">\n      {/* Mobile constrained wrapper */}\n      <div className=\"w-full max-w-md bg-slate-50 h-full flex flex-col relative shadow-2xl overflow-hidden\">\n        \n        {/* Header */}\n        <header className=\"bg-white border-b border-slate-200 px-4 py-3 flex items-center justify-between shrink-0 z-10\">\n          <div className=\"flex items-center space-x-2\">\n            <div className=\"w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-lg\">\n              C\n            </div>\n            <div className=\"flex flex-col leading-tight\">\n              <span className=\"font-bold text-slate-900\">CivicPulse</span>\n              <span className=\"text-[10px] text-slate-500 font-medium\">Anna Nagar, Chennai</span>\n            </div>\n          </div>\n          <div className=\"flex items-center space-x-3\">\n            <button onClick={toggleOffline} className={cn(\"p-1.5 rounded-full transition-colors\", isOffline ? \"bg-red-100 text-red-600\" : \"text-slate-400 hover:text-slate-600\")}>\n              <WifiOff size={20} />\n            </button>\n            <button className=\"text-slate-400 hover:text-slate-600 relative\" onClick={() => navigateTo(\'notifications\')}>\n              <Bell size={20} />\n              {issues.some(i => i.status === \'Awaiting Verification\') && (\n                <span className=\"absolute 1 top-0 right-0 w-2 h-2 bg-red-500 rounded-full\"></span>\n              )}\n            </button>\n            <div className=\"w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 text-sm font-bold border border-slate-300\">\n              S\n            </div>\n          </div>\n        </header>"
      replacement_content: "import React, { useState } from \'react\';\nimport { Home, PlusCircle, ListTodo, Bell, User, WifiOff, CheckCircle, ShieldCheck, LogOut, ChevronRight } from \'lucide-react\';\nimport { useApp } from \'../context/AppContext\';\nimport { CitizenHome } from \'./screens/Home\';\nimport { ReportFlow } from \'./screens/ReportFlow\';\nimport { MyReports } from \'./screens/MyReports\';\nimport { IssueDetail } from \'./screens/IssueDetail\';\nimport { cn } from \'../utils\';\nimport { CitizenUser } from \'../types\';\n\nexport type CitizenScreen = \'home\' | \'report\' | \'my_reports\' | \'issue_detail\' | \'notifications\' | \'profile\';\n\nexport const CitizenApp: React.FC = () => {\n  const [currentScreen, setCurrentScreen] = useState<CitizenScreen>(\'home\');\n  const [selectedIssueId, setSelectedIssueId] = useState<string | null>(null);\n  const [isMenuOpen, setIsMenuOpen] = useState(false);\n  \n  const { isOffline, toggleOffline, offlineQueue, issues, user, logout } = useApp();\n  const currentUser = user as CitizenUser;\n\n  const navigateTo = (screen: CitizenScreen, issueId?: string) => {\n    if (issueId) setSelectedIssueId(issueId);\n    setCurrentScreen(screen);\n    setIsMenuOpen(false);\n  };\n\n  const getInitials = (name: string) => {\n    if (!name) return \'U\';\n    return name.split(\' \').map(n => n[0]).join(\'\').substring(0, 2);\n  };\n\n  return (\n    <section className=\"flex-1 bg-slate-200 flex justify-center overflow-hidden\">\n      {/* Mobile constrained wrapper */}\n      <div className=\"w-full max-w-md bg-slate-50 h-full flex flex-col relative shadow-2xl overflow-hidden\">\n        \n        {/* Header */}\n        <header className=\"bg-white border-b border-slate-200 px-4 py-3 flex items-center justify-between shrink-0 z-30\">\n          <div className=\"flex items-center space-x-2\">\n            <div className=\"w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-lg\">\n              C\n            </div>\n            <div className=\"flex flex-col leading-tight\">\n              <span className=\"font-bold text-slate-900\">CivicPulse</span>\n              <span className=\"text-[10px] text-slate-500 font-medium\">{currentUser?.location || \'Chennai\'}</span>\n            </div>\n          </div>\n          <div className=\"flex items-center space-x-3 relative\">\n            <button onClick={toggleOffline} className={cn(\"p-1.5 rounded-full transition-colors\", isOffline ? \"bg-red-100 text-red-600\" : \"text-slate-400 hover:text-slate-600\")}>\n              <WifiOff size={20} />\n            </button>\n            <button className=\"text-slate-400 hover:text-slate-600 relative\" onClick={() => navigateTo(\'notifications\')}>\n              <Bell size={20} />\n              {issues.some(i => i.status === \'Awaiting Verification\') && (\n                <span className=\"absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full\"></span>\n              )}\n            </button>\n            <button \n              onClick={() => setIsMenuOpen(!isMenuOpen)}\n              className=\"w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-700 text-sm font-bold border border-blue-200 focus:outline-none\"\n            >\n              {getInitials(currentUser?.name)}\n            </button>\n            \n            {/* Profile Dropdown Menu */}\n            {isMenuOpen && (\n              <div className=\"absolute top-10 right-0 w-64 bg-white rounded-xl shadow-xl border border-slate-200 py-2 z-50 animate-in fade-in zoom-in-95 duration-200\">\n                <div className=\"px-4 py-3 border-b border-slate-100\">\n                  <h3 className=\"font-bold text-slate-900\">{currentUser?.name}</h3>\n                  {currentUser?.aadhaarVerified && (\n                    <div className=\"flex items-center gap-1 text-emerald-600 text-xs font-bold mt-1\">\n                      <ShieldCheck size={12} /> Aadhaar Verified\n                    </div>\n                  )}\n                  <p className=\"text-xs text-slate-500 mt-1\">{currentUser?.phone}</p>\n                </div>\n                <div className=\"px-4 py-3 border-b border-slate-100 grid grid-cols-3 gap-2 text-center\">\n                  <div>\n                    <div className=\"text-lg font-bold text-slate-900\">{currentUser?.reportsCount}</div>\n                    <div className=\"text-[10px] text-slate-500 uppercase font-bold tracking-wider\">Reports</div>\n                  </div>\n                  <div>\n                    <div className=\"text-lg font-bold text-emerald-600\">{currentUser?.resolvedCount}</div>\n                    <div className=\"text-[10px] text-slate-500 uppercase font-bold tracking-wider\">Resolved</div>\n                  </div>\n                  <div>\n                    <div className=\"text-lg font-bold text-blue-600\">{currentUser?.contributionScore}%</div>\n                    <div className=\"text-[10px] text-slate-500 uppercase font-bold tracking-wider\">Contrib</div>\n                  </div>\n                </div>\n                <div className=\"py-1\">\n                  <button onClick={() => navigateTo(\'profile\')} className=\"w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 font-medium\">Profile</button>\n                  <button onClick={() => navigateTo(\'my_reports\')} className=\"w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 font-medium\">My Reports</button>\n                  <button onClick={() => navigateTo(\'notifications\')} className=\"w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 font-medium\">Notifications</button>\n                  <button className=\"w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 font-medium\">Language</button>\n                  <button className=\"w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 font-medium\">Privacy & Security</button>\n                </div>\n                <div className=\"border-t border-slate-100 py-1\">\n                  <button \n                    onClick={() => {\n                      setIsMenuOpen(false);\n                      if(window.confirm(\'Sign out of CivicPulse?\')) {\n                        logout();\n                      }\n                    }} \n                    className=\"w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 font-bold flex items-center gap-2\"\n                  >\n                    <LogOut size={16} /> Sign Out\n                  </button>\n                </div>\n              </div>\n            )}\n          </div>\n        </header>"
    }
