      target_content: "import React from \'react\';\nimport { MapPin } from \'lucide-react\';\n\nexport const GovLiveMap: React.FC = () => {\n  return (\n    <div className=\"h-full bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col animate-in fade-in duration-300 relative\">\n      <div className=\"absolute top-4 left-4 z-10 bg-white rounded-xl shadow-lg border p-4 w-72\">\n        <h3 className=\"font-bold text-gray-900 mb-3\">Map Controls</h3>\n        <div className=\"space-y-3\">\n          <div>\n            <label className=\"text-xs font-bold text-gray-500 uppercase\">Issue Type</label>\n            <select className=\"w-full mt-1 border rounded p-1.5 text-sm bg-gray-50\">\n              <option>All Types</option>\n              <option>Potholes</option>\n              <option>Garbage</option>\n            </select>\n          </div>\n          <div>\n            <label className=\"text-xs font-bold text-gray-500 uppercase\">Priority</label>\n            <select className=\"w-full mt-1 border rounded p-1.5 text-sm bg-gray-50\">\n              <option>All Priorities</option>\n              <option>Critical Only</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"flex-1 bg-slate-100 relative\">\n         <div className=\"absolute inset-0 opacity-50\" style={{ backgroundImage: \'radial-gradient(#94a3b8 2px, transparent 2px)\', backgroundSize: \'30px 30px\' }}></div>\n         \n         <div className=\"absolute inset-0 flex items-center justify-center pointer-events-none\">\n           <div className=\"text-center\">\n             <MapPin size={48} className=\"text-slate-300 mx-auto mb-2\" />\n             <h2 className=\"text-2xl font-bold text-slate-400\">Interactive GIS Map</h2>\n             <p className=\"text-slate-500\">Live clustering and heatmaps enabled.</p>\n           </div>\n         </div>\n      </div>\n    </div>\n  );\n};"
